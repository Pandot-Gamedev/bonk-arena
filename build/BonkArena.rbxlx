<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX0000000C"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Arenas</string><ProtectedString name="Source"><![CDATA[-- The arenas. Each one changes during a round so nobody can hide at the edge.
-- ArenaService (server) builds them and runs what happens in them.

local Arenas = {}

Arenas.List = {
	{ id = "ice", name = "Ice Floe", color = Color3.fromRGB(150, 220, 255), description = "Slippery ice that cracks and sinks from the edges inward." },
	{ id = "spin", name = "Spin Cycle", color = Color3.fromRGB(255, 170, 60), description = "The floor spins faster and faster. Jump the sweeper bar!" },
	{ id = "lava", name = "Lava Rise", color = Color3.fromRGB(255, 90, 40), description = "Lava climbs the tower. Get higher, and don't touch it." },
	{ id = "bounce", name = "Bounce House", color = Color3.fromRGB(255, 110, 200), description = "Bouncy walls keep you in, until they fall away one by one." },
}

Arenas.ById = {}
for _, arena in ipairs(Arenas.List) do
	Arenas.ById[arena.id] = arena
end

return Arenas
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- General game settings. Change numbers here to rebalance the game.

local Config = {}

Config.GameName = "Bonk Arena"

-- Saving
Config.DataStoreName = "PlayerData_v1"
Config.WinsStoreName = "Wins_v1"
Config.KosStoreName = "Knockouts_v1"
Config.WeeklyWinsStorePrefix = "WeeklyWins_"
Config.AutosaveSeconds = 120

-- Moving
Config.WalkSpeed = 18
Config.JumpHeight = 7.2
Config.DashSpeed = 75
Config.DashSeconds = 0.18
Config.DashCooldown = 1.6

-- Bonking. Damage is shown as a percentage over each head: the higher it is,
-- the farther the next bonk sends you (like Smash Bros).
Config.BonkRange = 7.5 -- studs in front of you
Config.BonkArc = 110 -- degrees wide
Config.BonkCooldown = 0.45
Config.BonkImpactDelay = 0.12 -- the hammer lands this long after the swing starts
Config.BonkDamageMin = 8
Config.BonkDamageMax = 12
Config.MaxDamage = 999

-- Knockback speed = Base + Scale * damage (studs per second)
Config.KnockBase = 16
Config.KnockScale = 0.6
Config.KnockUpBase = 22
Config.KnockUpScale = 0.3
-- Stunned (tumbling, no control) for Base + Scale * damage seconds, up to Max
Config.StunBase = 0.3
Config.StunScale = 0.005
Config.StunMax = 1.2
Config.KoCreditSeconds = 6 -- falling off this soon after a bonk counts as a knockout for the bonker

-- Matches
Config.RoundsToWin = 2 -- best of 3
Config.CountdownSeconds = 3
Config.RoundSeconds = 75 -- then sudden death
Config.SuddenDeathSeconds = 30 -- then whoever has the least damage wins the round
Config.SuddenDeathDamage = 150
Config.BetweenRoundsSeconds = 4
Config.VictorySeconds = 7
Config.OutBelow = 25 -- studs below the arena floor counts as out
Config.OutBeyond = 30 -- studs past the arena edge counts as out

-- Queue pads in the lobby
Config.QueueSeconds = 20 -- wait for more players, then bots fill the empty spots
Config.QueueFullSeconds = 4 -- countdown once the pad is full

-- Power-ups
Config.PowerUpFirstSeconds = 8
Config.PowerUpEverySeconds = 12
Config.PowerUpMaxOnField = 2
Config.PowerUpSeconds = 8 -- how long timed power-ups last

-- Rewards. Coins only buy cosmetics, so they never help you win.
Config.CoinRewards = { play = 20, roundWin = 15, matchWin = 50, ko = 10 }
Config.XpRewards = { play = 30, roundWin = 20, matchWin = 60, ko = 15 }
Config.BotKoShare = 0.5 -- knocking out a bot is worth half
Config.BotOnlyWinShare = 0.6 -- winning against only bots is worth a bit less
Config.VipCoinBonus = 0.25

-- Daily login reward: DailyRewardBase * streak day (streak capped at 7)
Config.DailyRewardBase = 50
Config.DailyStreakCap = 7

-- Set to true to try the VIP pass for free while testing in Roblox Studio.
-- Has no effect in the live game.
Config.TestPassesInStudio = false

function Config.Knockback(damage)
	return Config.KnockBase + Config.KnockScale * damage, Config.KnockUpBase + Config.KnockUpScale * damage
end

function Config.Stun(damage)
	return math.min(Config.StunMax, Config.StunBase + Config.StunScale * damage)
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[-- Every cosmetic in the game. Cosmetics are looks only: they never change how
-- hard you bonk, how far you fly or anything else about winning.
--
-- kind:   "hammer" (your hammer's look), "ko" (effect when you knock someone out),
--         "dance" (your victory dance), "title" (text above your head), "trail"
-- source: "default" (everyone has it), "coins" (buy with coins in the Locker),
--         "level" (free at that level), "robux" (developer product, see productId),
--         "vip" (comes with the VIP pass), "earned" (unlocked by playing, see rule)
--
-- HOW TO FILL IN THE PRODUCT IDS (step 5 of the build plan):
--   Creator Dashboard > your game > Monetization > Developer Products.
-- A productId of 0 means "not set up yet": the item shows as "Coming soon".

local Cosmetics = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Cosmetics.Kinds = {
	{ id = "hammer", name = "Hammers", short = "Hammers" },
	{ id = "ko", name = "Knockout effects", short = "KO effects" },
	{ id = "dance", name = "Victory dances", short = "Dances" },
	{ id = "title", name = "Titles", short = "Titles" },
	{ id = "trail", name = "Trails", short = "Trails" },
}

-- Hammer looks: shape "hammer" (foam hammer), "mallet" (wooden mallet),
-- "chicken" (rubber chicken), "fish" (a big fish)
Cosmetics.List = {
	-- Hammers
	{ id = "hammer_foam", kind = "hammer", name = "Foam Hammer", source = "default", shape = "hammer", head = rgb(235, 60, 60), handle = rgb(255, 210, 60), material = Enum.Material.SmoothPlastic },
	{ id = "hammer_blue", kind = "hammer", name = "Blue Foam Hammer", source = "coins", price = 300, shape = "hammer", head = rgb(60, 140, 255), handle = rgb(240, 240, 240), material = Enum.Material.SmoothPlastic },
	{ id = "hammer_green", kind = "hammer", name = "Green Foam Hammer", source = "coins", price = 300, shape = "hammer", head = rgb(80, 200, 90), handle = rgb(250, 240, 200), material = Enum.Material.SmoothPlastic },
	{ id = "hammer_purple", kind = "hammer", name = "Purple Foam Hammer", source = "coins", price = 500, shape = "hammer", head = rgb(160, 80, 230), handle = rgb(255, 200, 240), material = Enum.Material.SmoothPlastic },
	{ id = "hammer_mallet", kind = "hammer", name = "Wooden Mallet", source = "coins", price = 800, shape = "mallet", head = rgb(170, 120, 70), handle = rgb(120, 80, 45), material = Enum.Material.Wood },
	{ id = "hammer_ice", kind = "hammer", name = "Ice Hammer", source = "coins", price = 1500, shape = "hammer", head = rgb(170, 230, 255), handle = rgb(220, 245, 255), material = Enum.Material.Ice },
	{ id = "hammer_bronze", kind = "hammer", name = "Bronze Hammer", source = "level", level = 5, shape = "hammer", head = rgb(205, 127, 50), handle = rgb(90, 60, 40), material = Enum.Material.Metal },
	{ id = "hammer_silver", kind = "hammer", name = "Silver Hammer", source = "level", level = 15, shape = "hammer", head = rgb(200, 205, 215), handle = rgb(60, 60, 70), material = Enum.Material.Metal },
	{ id = "hammer_diamond", kind = "hammer", name = "Diamond Hammer", source = "level", level = 30, shape = "hammer", head = rgb(140, 240, 255), handle = rgb(255, 255, 255), material = Enum.Material.Glass },
	{ id = "hammer_royal", kind = "hammer", name = "Royal Hammer", source = "vip", shape = "hammer", head = rgb(255, 200, 40), handle = rgb(150, 20, 60), material = Enum.Material.Foil },
	{ id = "hammer_golden", kind = "hammer", name = "Golden Hammer", source = "robux", productId = 0, suggestedPrice = 99, shape = "hammer", head = rgb(255, 190, 30), handle = rgb(255, 230, 120), material = Enum.Material.Foil },
	{ id = "hammer_neon", kind = "hammer", name = "Neon Hammer", source = "robux", productId = 0, suggestedPrice = 75, shape = "hammer", head = rgb(255, 60, 200), handle = rgb(60, 255, 230), material = Enum.Material.Neon },
	{ id = "hammer_galaxy", kind = "hammer", name = "Galaxy Hammer", source = "robux", productId = 0, suggestedPrice = 149, shape = "hammer", head = rgb(110, 60, 255), handle = rgb(30, 20, 60), material = Enum.Material.ForceField },
	{ id = "hammer_chicken", kind = "hammer", name = "Rubber Chicken", source = "robux", productId = 0, suggestedPrice = 129, shape = "chicken", head = rgb(255, 225, 60), handle = rgb(255, 150, 40), material = Enum.Material.SmoothPlastic },
	{ id = "hammer_fish", kind = "hammer", name = "Big Fish", source = "robux", productId = 0, suggestedPrice = 49, shape = "fish", head = rgb(80, 170, 220), handle = rgb(240, 120, 60), material = Enum.Material.SmoothPlastic },

	-- Knockout effects
	{ id = "ko_poof", kind = "ko", name = "Poof", source = "default", colors = { rgb(255, 255, 255), rgb(200, 200, 200) } },
	{ id = "ko_bubbles", kind = "ko", name = "Bubbles", source = "coins", price = 600, colors = { rgb(120, 220, 255), rgb(255, 255, 255) } },
	{ id = "ko_hearts", kind = "ko", name = "Hearts", source = "level", level = 10, colors = { rgb(255, 80, 140), rgb(255, 170, 200) } },
	{ id = "ko_confetti", kind = "ko", name = "Confetti Blast", source = "robux", productId = 0, suggestedPrice = 49, colors = { rgb(255, 70, 70), rgb(255, 220, 50), rgb(70, 200, 255), rgb(120, 255, 120), rgb(220, 100, 255) } },
	{ id = "ko_star", kind = "ko", name = "Cartoon Star", source = "robux", productId = 0, suggestedPrice = 75, colors = { rgb(255, 230, 40), rgb(255, 170, 0) } },
	{ id = "ko_fireworks", kind = "ko", name = "Fireworks", source = "robux", productId = 0, suggestedPrice = 99, colors = { rgb(255, 90, 60), rgb(80, 160, 255), rgb(255, 240, 120) } },
	{ id = "ko_lightning", kind = "ko", name = "Lightning Strike", source = "robux", productId = 0, suggestedPrice = 129, colors = { rgb(140, 220, 255), rgb(255, 255, 255) } },

	-- Victory dances
	{ id = "dance_cheer", kind = "dance", name = "Cheer", source = "default" },
	{ id = "dance_jump", kind = "dance", name = "Victory Jump", source = "level", level = 20 },
	{ id = "dance_spin", kind = "dance", name = "Spin", source = "robux", productId = 0, suggestedPrice = 25 },
	{ id = "dance_hop", kind = "dance", name = "Bunny Hop", source = "robux", productId = 0, suggestedPrice = 49 },
	{ id = "dance_flip", kind = "dance", name = "Backflip", source = "robux", productId = 0, suggestedPrice = 75 },
	{ id = "dance_heli", kind = "dance", name = "Helicopter", source = "robux", productId = 0, suggestedPrice = 99 },

	-- Titles
	{ id = "title_brawler", kind = "title", name = "Brawler", text = "Brawler", source = "level", level = 10, color = rgb(150, 220, 255) },
	{ id = "title_star", kind = "title", name = "Arena Star", text = "Arena Star", source = "level", level = 25, color = rgb(255, 220, 90) },
	{ id = "title_legend", kind = "title", name = "Bonk Legend", text = "Bonk Legend", source = "level", level = 50, color = rgb(255, 140, 40) },
	{ id = "title_firstwin", kind = "title", name = "First Win", text = "First Win", source = "earned", rule = "wins", amount = 1, color = rgb(140, 230, 140) },
	{ id = "title_champion", kind = "title", name = "Champion", text = "Champion", source = "earned", rule = "wins", amount = 50, color = rgb(255, 200, 40) },
	{ id = "title_koking", kind = "title", name = "Knockout King", text = "Knockout King", source = "earned", rule = "kos", amount = 100, color = rgb(255, 90, 90) },
	{ id = "title_hammertime", kind = "title", name = "Hammer Time", text = "Hammer Time", source = "robux", productId = 0, suggestedPrice = 25, color = rgb(120, 200, 255) },
	{ id = "title_unbonkable", kind = "title", name = "Unbonkable", text = "Unbonkable", source = "robux", productId = 0, suggestedPrice = 49, color = rgb(160, 255, 160) },
	{ id = "title_bonkmaster", kind = "title", name = "Bonk Master", text = "Bonk Master", source = "robux", productId = 0, suggestedPrice = 99, color = rgb(255, 170, 60) },

	-- Trails
	{ id = "trail_sparkle", kind = "trail", name = "Sparkle Trail", source = "coins", price = 1000, colors = { rgb(0, 170, 255), rgb(0, 255, 200) } },
	{ id = "trail_fire", kind = "trail", name = "Fire Trail", source = "coins", price = 2000, colors = { rgb(255, 220, 0), rgb(255, 40, 0) } },
	{ id = "trail_rainbow", kind = "trail", name = "Rainbow Trail", source = "level", level = 40, colors = { rgb(255, 0, 0), rgb(255, 255, 0), rgb(0, 255, 0), rgb(0, 120, 255), rgb(200, 0, 255) } },
}

Cosmetics.Defaults = {
	hammer = "hammer_foam",
	ko = "ko_poof",
	dance = "dance_cheer",
}

Cosmetics.ById = {}
Cosmetics.ByProductId = {}
for index, item in ipairs(Cosmetics.List) do
	item.order = index
	Cosmetics.ById[item.id] = item
	if item.productId and item.productId ~= 0 then
		Cosmetics.ByProductId[item.productId] = item
	end
end

-- True if the player can use this item. vip = owns the VIP pass.
function Cosmetics.Owns(data, item, vip)
	if item.source == "default" then
		return true
	elseif item.source == "vip" then
		return vip == true
	end
	return data.cosmetics.owned[item.id] == true
end

-- The item the player shows for a kind (falls back to the free default)
function Cosmetics.Equipped(data, kind, vip)
	local item = Cosmetics.ById[data.cosmetics.equipped[kind] or ""]
	if item and Cosmetics.Owns(data, item, vip) then
		return item
	end
	return Cosmetics.ById[Cosmetics.Defaults[kind] or ""]
end

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[-- Small helpers for showing numbers and times.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi" }

-- 1234 -> "1.23K", 5600000 -> "5.6M"
function Format.Number(n)
	n = math.floor(n or 0)
	if math.abs(n) < 1000 then
		return tostring(n)
	end
	local index = 1
	local value = n
	while math.abs(value) >= 1000 and index < #SUFFIXES do
		value = value / 1000
		index += 1
	end
	local text = string.format("%.2f", value)
	text = text:gsub("0+$", ""):gsub("%.$", "")
	return text .. SUFFIXES[index]
end

-- 3725 -> "1h 2m", 95 -> "1m 35s"
function Format.Duration(seconds)
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor((seconds % 86400) / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	if days > 0 then
		return string.format("%dd %dh", days, hours)
	elseif hours > 0 then
		return string.format("%dh %dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

-- Damage % color: white, then yellow, orange and red as it climbs
function Format.DamageColor(damage)
	if damage < 50 then
		return Color3.new(1, 1, 1):Lerp(Color3.fromRGB(255, 230, 80), damage / 50)
	elseif damage < 100 then
		return Color3.fromRGB(255, 230, 80):Lerp(Color3.fromRGB(255, 140, 40), (damage - 50) / 50)
	end
	return Color3.fromRGB(255, 140, 40):Lerp(Color3.fromRGB(230, 30, 30), math.clamp((damage - 100) / 60, 0, 1))
end

-- 75 -> "1:15"
function Format.Clock(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Level</string><ProtectedString name="Source"><![CDATA[-- Brawler level. Every match gives XP (more for wins and knockouts).
-- Your level shows above your head, pays coins each time it goes up, and some
-- levels unlock a free cosmetic (see Cosmetics.luau, source = "level").

local Level = {}

Level.CoinsPerLevel = 25 -- reward for reaching level N is N * this
Level.Max = 50

-- Total XP needed to reach a level (level 1 needs 0)
function Level.XpFor(level)
	return math.floor(60 * (level - 1) ^ 1.5)
end

function Level.FromXp(xp)
	local level = 1
	while level < Level.Max and Level.XpFor(level + 1) <= xp do
		level += 1
	end
	return level
end

-- How far through the current level, from 0 to 1
function Level.Progress(xp)
	local level = Level.FromXp(xp)
	if level >= Level.Max then
		return 1, level
	end
	local from, to = Level.XpFor(level), Level.XpFor(level + 1)
	return (xp - from) / (to - from), level
end

return Level
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">PowerUps</string><ProtectedString name="Source"><![CDATA[-- Power-ups drop onto the arena during a round. Anyone can grab them, and they
-- are never sold, so every player has the same chance.

local PowerUps = {}

PowerUps.List = {
	{ id = "giant", name = "Giant Hammer", letter = "G", color = Color3.fromRGB(255, 80, 80), description = "Your bonks hit 60% harder and reach further for 8 seconds." },
	{ id = "shield", name = "Bounce Shield", letter = "S", color = Color3.fromRGB(90, 200, 255), description = "Blocks the next 2 bonks that hit you." },
	{ id = "speed", name = "Speed Boots", letter = ">", color = Color3.fromRGB(255, 220, 60), description = "Run much faster for 8 seconds." },
	{ id = "iron", name = "Iron Boots", letter = "I", color = Color3.fromRGB(160, 160, 175), description = "Bonks push you only half as far for 8 seconds." },
	{ id = "magnet", name = "Magnet Bonk", letter = "M", color = Color3.fromRGB(200, 90, 255), description = "Pulls rivals toward you, and your next bonk hits all around you." },
	{ id = "banana", name = "Banana Peel", letter = "B", color = Color3.fromRGB(255, 240, 90), description = "Drops a banana behind you. Rivals who step on it slip!" },
}

PowerUps.ById = {}
for _, powerUp in ipairs(PowerUps.List) do
	PowerUps.ById[powerUp.id] = powerUp
end

PowerUps.GiantPower = 1.6
PowerUps.GiantReach = 3 -- extra studs of reach
PowerUps.ShieldHits = 2
PowerUps.SpeedWalkSpeed = 28
PowerUps.IronShare = 0.5
PowerUps.MagnetRange = 30
PowerUps.MagnetBonkRange = 11
PowerUps.MagnetBonkSeconds = 5
PowerUps.BananaSeconds = 20

return PowerUps
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[-- Daily quests: three small goals per player per day. Finishing one pays coins
-- and XP right away.

local Quests = {}

-- stat: what counts toward the goal (MatchService adds these up after every match)
Quests.Pool = {
	{ id = "wins", stat = "wins", text = "Win %d matches", goal = { 1, 3 }, coins = 120 },
	{ id = "kos", stat = "kos", text = "Knock out %d rivals", goal = { 3, 8 }, coins = 100 },
	{ id = "rounds", stat = "rounds", text = "Win %d rounds", goal = { 2, 5 }, coins = 100 },
	{ id = "matches", stat = "matches", text = "Play %d matches", goal = { 2, 5 }, coins = 80 },
	{ id = "bonks", stat = "bonks", text = "Land %d bonks", goal = { 25, 60 }, coins = 80 },
	{ id = "powerups", stat = "powerups", text = "Grab %d power-ups", goal = { 3, 6 }, coins = 80 },
	{ id = "round_ice", stat = "round_ice", text = "Win %d round on Ice Floe", goal = { 1, 1 }, coins = 100 },
	{ id = "round_spin", stat = "round_spin", text = "Win %d round on Spin Cycle", goal = { 1, 1 }, coins = 100 },
	{ id = "round_lava", stat = "round_lava", text = "Win %d round on Lava Rise", goal = { 1, 1 }, coins = 100 },
	{ id = "round_bounce", stat = "round_bounce", text = "Win %d round on Bounce House", goal = { 1, 1 }, coins = 100 },
}

Quests.ById = {}
for _, quest in ipairs(Quests.Pool) do
	Quests.ById[quest.id] = quest
end

Quests.PerDay = 3
Quests.XpShare = 0.5 -- XP reward = coins * this

function Quests.Today(now)
	return math.floor(now / 86400)
end

-- Week number for the weekly leaderboard; weeks start Monday 00:00 UTC
-- (1 Jan 1970 was a Thursday). Also returns the seconds left in the week.
local WEEK = 7 * 86400
local MONDAY_OFFSET = 4 * 86400
function Quests.Week(now)
	return math.floor((now - MONDAY_OFFSET) / WEEK), WEEK - ((now - MONDAY_OFFSET) % WEEK)
end

-- The same three quests for a player all day, picked from the pool. Only one
-- "win a round on X" quest at a time.
function Quests.Generate(userId, day)
	local random = Random.new(userId % 1000003 * 977 + day)
	local pool = table.clone(Quests.Pool)
	local list = {}
	local arenaQuest = false
	while #list < Quests.PerDay and #pool > 0 do
		local quest = table.remove(pool, random:NextInteger(1, #pool))
		local isArena = string.sub(quest.id, 1, 6) == "round_"
		if not (isArena and arenaQuest) then
			arenaQuest = arenaQuest or isArena
			local goal = random:NextInteger(quest.goal[1], quest.goal[2])
			if goal >= 20 then
				goal = math.floor(goal / 5 + 0.5) * 5 -- 45 bonks, not 43
			end
			table.insert(list, {
				id = quest.id,
				goal = goal,
				progress = 0,
				done = false,
			})
		end
	end
	return list
end

function Quests.Text(entry)
	local quest = Quests.ById[entry.id]
	local text = string.format(quest.text, entry.goal)
	if entry.goal ~= 1 then
		return text
	end
	-- "Win 1 matches" -> "Win 1 match"
	return (text:gsub("matches", "match"):gsub("rivals", "rival"):gsub("rounds", "round"):gsub("bonks", "bonk"):gsub("power%-ups", "power-up"))
end

return Quests
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- All the messages between server and players. The server creates them;
-- players wait for them to appear.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"DataUpdate", -- server -> player: the player's full save data
	"Notify", -- server -> player: a toast message
	"OpenPanel", -- server -> player: open a menu (e.g. the shop)
	"Bonk", -- player -> server: swing the hammer
	"Dash", -- player -> server: I just dashed (for quests, the guide and effects)
	"Launch", -- server -> player: you got bonked, fly with this velocity
	"Effect", -- server -> everyone: show a hit, knockout or power-up effect
	"Announce", -- server -> player: big text in the middle of the screen
	"Matches", -- server -> everyone: the state of every match
}

local FUNCTIONS = {
	"Action", -- player -> server: buy or equip a cosmetic, pick an arena...
}

local Remotes = {}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in ipairs(FUNCTIONS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes")
end

for _, name in ipairs(EVENTS) do
	Remotes[name] = folder:WaitForChild(name)
end
for _, name in ipairs(FUNCTIONS) do
	Remotes[name] = folder:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Everything sold for Robux. Nothing here helps you win: only looks.
-- The cosmetics sold for Robux (source = "robux") are in Cosmetics.luau with their
-- developer product ids.
--
-- HOW TO FILL IN THE PASS ID (step 5 of the build plan):
--   Creator Dashboard > your game > Monetization > Passes
-- An id of 0 means "not set up yet": the pass shows as "Coming soon" in the shop.

local Shop = {}

Shop.Passes = {
	{ id = "VIP", gamePassId = 0, name = "VIP", suggestedPrice = 250, description = "Golden name tag, a crown, the Royal Hammer and +25% coins (coins only buy looks)." },
}

Shop.PassById = {}
for _, pass in ipairs(Shop.Passes) do
	Shop.PassById[pass.id] = pass
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- The first-time guide. Each step points at a place in the world (a part with the
-- matching "GuideTarget" attribute) and finishes on a game event.

local Tutorial = {}

Tutorial.Steps = {
	{ event = "BonkDummy", text = "Welcome to Bonk Arena! Bonk a practice dummy: click, or tap the BONK button.", target = "Practice" },
	{ event = "Dash", text = "Nice hit! Now dash: press Q, or tap the DASH button.", target = "Practice" },
	{ event = "Queue", text = "Ready to brawl? Step on a glowing pad to join a match.", target = "Pads" },
	{ event = "Match", text = "Knock everyone off the arena! The higher their %, the farther they fly.", target = nil },
}

Tutorial.Done = #Tutorial.Steps + 1
Tutorial.RewardCoins = 200

return Tutorial
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000001A"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000019"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[-- Bonk Arena server. Starts every service in order.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local MapBuilder = require(script.MapBuilder)
local DataService = require(script.DataService)
local ShopService = require(script.ShopService)
local CosmeticService = require(script.CosmeticService)
local CombatService = require(script.CombatService)
local BotService = require(script.BotService)
local TutorialService = require(script.TutorialService)
local ProgressService = require(script.ProgressService)
local MatchService = require(script.MatchService)
local WorldService = require(script.WorldService)

-- Players' screens can't check who owns a private server, so share it
if game.PrivateServerId ~= "" then
	game:GetService("ReplicatedStorage"):SetAttribute("PrivateServerOwnerId", game.PrivateServerOwnerId)
end

MapBuilder.Build()

-- Services that react to players loading must start before DataService
ShopService.Start()
CosmeticService.Start()
CombatService.Start()
BotService.Start()
TutorialService.Start()
ProgressService.Start()
MatchService.Start()
WorldService.Start()
DataService.Start()

-- Test helpers for Roblox Studio only (never in the live game). In the command
-- bar, with the Server view selected:
--   game.ServerStorage.BonkArenaTest:Invoke("coins", 5000)
--   game.ServerStorage.BonkArenaTest:Invoke("xp", 10000)
--   game.ServerStorage.BonkArenaTest:Invoke("match", 2) -- start a match on pad 2 now (you + bots)
--   game.ServerStorage.BonkArenaTest:Invoke("arena", "lava") -- every round on that arena ("random" to undo)
--   game.ServerStorage.BonkArenaTest:Invoke("damage", 120) -- set your damage %
if RunService:IsStudio() then
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local test = Instance.new("BindableFunction")
	test.Name = "BonkArenaTest"
	test.OnInvoke = function(command, amount)
		local player = Players:GetPlayers()[1]
		if command == "match" then
			MatchService.TestStart(amount or 2, player)
			return "ok"
		elseif command == "arena" then
			ReplicatedStorage:SetAttribute("ArenaPick", amount ~= "random" and amount or nil)
			return "ok"
		elseif command == "damage" then
			local entity = player and CombatService.GetByPlayer(player)
			if entity then
				CombatService.SetDamage(entity, amount)
			end
			return "ok"
		end
		for _, each in ipairs(Players:GetPlayers()) do
			DataService.Update(each, function(data)
				if command == "coins" then
					data.coins += amount
				elseif command == "xp" then
					data.xp += amount
				end
			end)
		end
		return "ok"
	end
	test.Parent = game:GetService("ServerStorage")
end

print("[Bonk Arena] Server ready")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">ArenaService</string><ProtectedString name="Source"><![CDATA[-- Builds the four arenas and runs what happens in them during a round:
--   Ice Floe       slippery ice tiles crack and sink from the edge inward
--   Spin Cycle     the floor spins faster and faster, a sweeper bar comes round
--   Lava Rise      lava climbs a stepped tower
--   Bounce House   bouncy walls push you back in, then fall away one by one
--
-- Every round gets a freshly built arena. ArenaService.Build returns an "arena"
-- object that MatchService and the bots use:
--   arena.spawns            up to 4 CFrames where players start
--   arena.floorY, .radius   floor height and how far the floor reaches
--   arena:SafeRadius()      how far from the middle is still safe right now
--   arena:IsOut(position)   true if that spot is deadly (lava)
--   arena:ShouldJump(pos)   true if a bot standing there should jump now
--   arena:RandomFloorPoint() somewhere safe to drop a power-up
--   arena:Start(), :SuddenDeath(), :Destroy()

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arenas = require(Shared.Arenas)

local CombatService = require(script.Parent.CombatService)

local ArenaService = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder so it lies flat like a disc
local random = Random.new()

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function disc(folder, name, center, topY, radius, thickness, color, material)
	return part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, topY - thickness / 2, center.Z) * UPRIGHT,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Spawn points around the middle, facing in
local function ringSpawns(center, y, radius)
	local spawns = {}
	for index = 0, 3 do
		local angle = index * math.pi / 2 + math.pi / 4
		local at = Vector3.new(center.X + math.cos(angle) * radius, y + 3.5, center.Z + math.sin(angle) * radius)
		table.insert(spawns, CFrame.lookAt(at, Vector3.new(center.X, at.Y, center.Z)))
	end
	return spawns
end

-- Shakes a floor piece, then lets it drop
local function crumble(tile, arena, delay)
	if tile:GetAttribute("Falling") then
		return
	end
	tile:SetAttribute("Falling", true)
	tile.Color = tile.Color:Lerp(Color3.new(1, 1, 1), 0.6)
	local home = tile.CFrame
	task.spawn(function()
		local started = os.clock()
		while os.clock() - started < (delay or 1.4) and tile.Parent do
			tile.CFrame = home * CFrame.new(random:NextNumber(-0.15, 0.15), 0, random:NextNumber(-0.15, 0.15))
			task.wait(0.05)
		end
		if not tile.Parent then
			return
		end
		tile.CFrame = home
		tile.Anchored = false
		task.delay(4, function()
			tile:Destroy()
		end)
	end)
	if arena and random:NextNumber() < 0.3 then
		CombatService.Effect("crack", tile.Position)
	end
end

local function baseArena(id, center)
	local info = Arenas.ById[id]
	local folder = Instance.new("Folder")
	folder.Name = info.name
	local arena = {
		id = id,
		name = info.name,
		center = center,
		floorY = center.Y,
		folder = folder,
		running = false,
		suddenDeath = false,
		started = 0,
		say = function() end, -- set by MatchService: shows a message to the players in this match
		entities = function()
			return {}
		end, -- set by MatchService: the entities still in the round
	}
	function arena:Elapsed()
		return self.running and os.clock() - self.started or 0
	end
	function arena:IsOut()
		return false
	end
	function arena:ShouldJump()
		return false
	end
	function arena:Start()
		self.running = true
		self.started = os.clock()
		if self.run then
			task.spawn(self.run, self)
		end
	end
	function arena:SuddenDeath()
		self.suddenDeath = true
		if self.onSuddenDeath then
			self:onSuddenDeath()
		end
	end
	function arena:Destroy()
		self.running = false
		if self.heartbeat then
			self.heartbeat:Disconnect()
		end
		folder:Destroy()
	end
	return arena
end

------------------------------------------------------------------ Ice Floe
local function buildIce(arena)
	local center, folder = arena.center, arena.folder
	local radius = 42
	arena.radius = radius
	local tiles = {}
	local ice = PhysicalProperties.new(0.9, 0.05, 0, 100, 1) -- slippery: you slide after a bonk
	for x = -radius, radius, 6 do
		for z = -radius, radius, 6 do
			local distance = math.sqrt(x * x + z * z)
			if distance <= radius then
				local shade = (math.floor(x / 6) + math.floor(z / 6)) % 2 == 0 and Color3.fromRGB(170, 225, 255) or Color3.fromRGB(150, 210, 245)
				local tile = part({
					Name = "Ice",
					Size = Vector3.new(5.8, 2, 5.8),
					Position = Vector3.new(center.X + x, arena.floorY - 1, center.Z + z),
					Material = Enum.Material.Ice,
					Color = shade,
					CustomPhysicalProperties = ice,
					Parent = folder,
				})
				table.insert(tiles, { part = tile, distance = distance })
			end
		end
	end
	-- Chunks of iceberg under the floe, for looks
	for _ = 1, 6 do
		local angle = random:NextNumber(0, math.pi * 2)
		local at = center + Vector3.new(math.cos(angle) * random:NextNumber(5, 30), -random:NextNumber(8, 20), math.sin(angle) * random:NextNumber(5, 30))
		part({ Name = "Iceberg", Size = Vector3.new(random:NextNumber(8, 14), random:NextNumber(6, 12), random:NextNumber(8, 14)), CFrame = CFrame.new(at) * CFrame.Angles(random:NextNumber(-0.4, 0.4), random:NextNumber(0, 3), random:NextNumber(-0.4, 0.4)), Material = Enum.Material.Glacier, Color = Color3.fromRGB(190, 235, 255), CanCollide = false, CanQuery = false, Parent = folder })
	end

	arena.spawns = ringSpawns(center, arena.floorY, 22)
	local safe = radius
	function arena:SafeRadius()
		return safe - 5
	end
	function arena:RandomFloorPoint()
		local choices = {}
		for _, tile in ipairs(tiles) do
			if tile.part.Parent and not tile.part:GetAttribute("Falling") and tile.distance < safe - 6 then
				table.insert(choices, tile.part)
			end
		end
		local pick = choices[random:NextInteger(1, math.max(1, #choices))]
		return pick and pick.Position + Vector3.new(0, 3.5, 0) or center + Vector3.new(0, 3.5, 0)
	end
	local function shrinkTo(newRadius)
		safe = newRadius
		for _, tile in ipairs(tiles) do
			if tile.distance > newRadius and tile.part.Parent then
				crumble(tile.part, arena)
			end
		end
	end
	local rings = { 36, 30, 24, 18, 12 }
	function arena.run(self)
		self.say("The ice is cracking from the edges!")
		local nextShrink = 12
		local index = 1
		while self.running and index <= #rings do
			if self:Elapsed() >= nextShrink then
				shrinkTo(rings[index])
				index += 1
				nextShrink += self.suddenDeath and 3 or 10
			end
			task.wait(0.25)
		end
	end
	function arena.onSuddenDeath(self)
		if self.running then
			shrinkTo(math.max(12, safe - 6))
		end
	end
end

------------------------------------------------------------------ Spin Cycle
local function buildSpin(arena)
	local center, folder = arena.center, arena.folder
	local radius = 36
	arena.radius = radius
	local floorY = arena.floorY

	local pin = part({ Name = "Pin", Size = Vector3.new(4, 4, 4), Position = Vector3.new(center.X, floorY - 8, center.Z), Transparency = 1, CanCollide = false, CanQuery = false, Parent = folder })
	local spinner = part({
		Name = "Spinner",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, floorY - 1, center.Z) * UPRIGHT,
		Color = Color3.fromRGB(255, 230, 190),
		Anchored = false,
		Parent = folder,
	})
	-- Coloured rings and stripes so you can see it turning
	local colors = { Color3.fromRGB(255, 150, 60), Color3.fromRGB(255, 230, 190), Color3.fromRGB(255, 110, 80), Color3.fromRGB(255, 230, 190), Color3.fromRGB(255, 200, 60) }
	for index, size in ipairs({ 70, 56, 42, 28, 12 }) do
		local ring = part({ Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, size, size), CFrame = CFrame.new(center.X, floorY + 0.02 * index, center.Z) * UPRIGHT, Color = colors[index], CanCollide = false, CanQuery = false, Anchored = false, Massless = true, Parent = folder })
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = spinner
		weld.Part1 = ring
		weld.Parent = ring
	end
	for index = 0, 3 do
		local stripe = part({ Name = "Stripe", Size = Vector3.new(0.6, 0.2, radius * 2 - 2), CFrame = CFrame.new(center.X, floorY + 0.12, center.Z) * CFrame.Angles(0, index * math.pi / 4, 0), Color = Color3.fromRGB(120, 60, 30), CanCollide = false, CanQuery = false, Anchored = false, Massless = true, Parent = folder })
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = spinner
		weld.Part1 = stripe
		weld.Parent = stripe
	end
	local pinAttachment = Instance.new("Attachment")
	pinAttachment.CFrame = CFrame.new(0, 7, 0) * UPRIGHT
	pinAttachment.Parent = pin
	local spinAttachment = Instance.new("Attachment")
	spinAttachment.Parent = spinner
	local hinge = Instance.new("HingeConstraint")
	hinge.Attachment0 = pinAttachment
	hinge.Attachment1 = spinAttachment
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.MotorMaxTorque = 1e12
	hinge.MotorMaxAcceleration = 1.5
	hinge.AngularVelocity = 0
	hinge.Parent = spinner

	-- The sweeper bar is drawn here and its hits are worked out with maths (more
	-- reliable than touching): it hits anyone low enough near its arm.
	local bar = part({ Name = "Sweeper", Size = Vector3.new(radius, 1.4, 1.4), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false, Transparency = 1, Parent = folder })
	local bar2 = part({ Name = "Sweeper2", Size = Vector3.new(radius, 1.4, 1.4), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon, CanCollide = false, CanQuery = false, Transparency = 1, Parent = folder })
	local sweeperOn, secondArm = false, false
	local angle, sweepSpeed = 0, 0.9
	local lastSwept = {}

	arena.spawns = ringSpawns(center, floorY, 18)
	function arena:SafeRadius()
		return radius - 7
	end
	function arena:RandomFloorPoint()
		local a = random:NextNumber(0, math.pi * 2)
		local r = random:NextNumber(4, radius - 10)
		return Vector3.new(center.X + math.cos(a) * r, floorY + 3.5, center.Z + math.sin(a) * r)
	end
	local function armDirections()
		local first = CFrame.Angles(0, angle, 0) * Vector3.xAxis
		if secondArm then
			return { first, -first }
		end
		return { first }
	end
	function arena:ShouldJump(position)
		if not sweeperOn then
			return false
		end
		local rel = flat(position - center)
		for _, dir in ipairs(armDirections()) do
			local along = rel:Dot(dir)
			local ahead = Vector3.new(0, 1, 0):Cross(dir) -- the way the arm is moving
			local side = rel:Dot(ahead)
			if along > 0 and side > 0 and side < 7 then
				return true
			end
		end
		return false
	end

	arena.heartbeat = RunService.Heartbeat:Connect(function(dt)
		if not arena.running then
			return
		end
		local elapsed = arena:Elapsed()
		hinge.AngularVelocity = arena.suddenDeath and 0.9 or math.min(0.7, 0.25 + elapsed * 0.008)
		if not sweeperOn then
			return
		end
		sweepSpeed = arena.suddenDeath and 2.2 or math.min(1.6, 0.9 + (elapsed - 12) * 0.015)
		angle += sweepSpeed * dt
		local base = CFrame.new(center.X, floorY + 1.6, center.Z)
		bar.CFrame = base * CFrame.Angles(0, angle, 0) * CFrame.new(radius / 2, 0, 0)
		bar2.CFrame = base * CFrame.Angles(0, angle + math.pi, 0) * CFrame.new(radius / 2, 0, 0)
		local now = os.clock()
		for _, entity in ipairs(arena.entities()) do
			local root = entity.root
			if root and root.Parent and (lastSwept[entity] or 0) + 1 < now then
				local rel = root.Position - center
				local height = root.Position.Y - floorY
				if height < 4.6 and height > -2 then
					for _, dir in ipairs(armDirections()) do
						local flatRel = flat(rel)
						local along = flatRel:Dot(dir)
						local off = (flatRel - dir * along).Magnitude
						if along > 0 and along < radius + 1 and off < 2.2 then
							lastSwept[entity] = now
							local push = Vector3.new(0, 1, 0):Cross(dir)
							CombatService.Push(entity, push * 55 + Vector3.yAxis * 32, 0.6, 8)
							CombatService.Effect("hit", root.Position, { damage = 8 })
							break
						end
					end
				end
			end
		end
	end)

	function arena.run(self)
		task.wait(0.1)
		pcall(function()
			spinner:SetNetworkOwner(nil)
		end)
		self.say("The floor is spinning!")
		while self.running and self:Elapsed() < 12 do
			task.wait(0.25)
		end
		if not self.running then
			return
		end
		sweeperOn = true
		bar.Transparency = 0
		self.say("Sweeper bar! Jump over it!")
		while self.running and self:Elapsed() < 40 and not self.suddenDeath do
			task.wait(0.25)
		end
		if self.running then
			secondArm = true
			bar2.Transparency = 0
		end
	end
	function arena.onSuddenDeath()
		if sweeperOn then
			secondArm = true
			bar2.Transparency = 0
		end
	end
end

------------------------------------------------------------------ Lava Rise
local function buildLava(arena)
	local center, folder = arena.center, arena.folder
	local floorY = arena.floorY
	arena.radius = 40
	local tiers = {
		{ radius = 40, top = 0, color = Color3.fromRGB(70, 60, 60) },
		{ radius = 30, top = 5, color = Color3.fromRGB(95, 82, 78) },
		{ radius = 20, top = 10, color = Color3.fromRGB(120, 100, 92) },
		{ radius = 11, top = 15, color = Color3.fromRGB(150, 120, 100) },
	}
	for index, tier in ipairs(tiers) do
		disc(folder, "Tier" .. index, center, floorY + tier.top, tier.radius, tier.top + 4, tier.color, Enum.Material.Basalt)
		-- A glowing edge so the steps are easy to see
		disc(folder, "Edge" .. index, center, floorY + tier.top + 0.05, tier.radius + 0.2, 0.3, Color3.fromRGB(255, 140, 50), Enum.Material.Neon).CanCollide = false
		disc(folder, "Top" .. index, center, floorY + tier.top + 0.1, tier.radius - 0.8, 0.3, tier.color, Enum.Material.Basalt).CanCollide = false
	end
	local lavaTop = floorY - 8
	local lava = part({
		Name = "Lava",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 124, 124),
		CFrame = CFrame.new(center.X, lavaTop - 1, center.Z) * UPRIGHT,
		Color = Color3.fromRGB(255, 100, 20),
		Material = Enum.Material.Neon,
		Transparency = 0.1,
		CanCollide = false,
		CanQuery = false,
		Parent = folder,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = 40
	light.Brightness = 2
	light.Parent = lava

	local rises = { { at = 15, level = 1 }, { at = 35, level = 6 }, { at = 55, level = 11 } }
	local nextRise = 1
	arena.spawns = ringSpawns(center, floorY, 35)

	local function riseTo(level, seconds)
		local target = floorY + level
		TweenService:Create(lava, TweenInfo.new(seconds, Enum.EasingStyle.Sine), { CFrame = CFrame.new(center.X, target - 1, center.Z) * UPRIGHT }):Play()
	end
	-- Read the lava's real height (it moves smoothly)
	local function currentTop()
		return lava.Position.Y + 1
	end
	function arena:IsOut(position)
		return position.Y < currentTop() + 2.5
	end
	function arena:SafeRadius()
		-- Head for the lowest step that will still be above the lava after the next rise
		local soon = currentTop()
		local upcoming = rises[nextRise]
		if upcoming and upcoming.at - self:Elapsed() < 10 then
			soon = math.max(soon, floorY + upcoming.level)
		end
		for _, tier in ipairs(tiers) do
			if floorY + tier.top > soon + 1 then
				return tier.radius - 3
			end
		end
		return tiers[#tiers].radius - 3
	end
	function arena:RandomFloorPoint()
		local safeTiers = {}
		for index, tier in ipairs(tiers) do
			if floorY + tier.top > currentTop() + 4 then
				table.insert(safeTiers, index)
			end
		end
		local index = safeTiers[random:NextInteger(1, math.max(1, #safeTiers))] or #tiers
		local tier = tiers[index]
		local inner = tiers[index + 1] and tiers[index + 1].radius + 2 or 0
		local a = random:NextNumber(0, math.pi * 2)
		local r = random:NextNumber(inner, tier.radius - 2)
		return Vector3.new(center.X + math.cos(a) * r, floorY + tier.top + 3.5, center.Z + math.sin(a) * r)
	end
	function arena.run(self)
		self.say("The lava is coming up. Climb!")
		while self.running and nextRise <= #rises do
			local rise = rises[nextRise]
			if self:Elapsed() >= rise.at - 3 then
				self.say("Lava rising!")
				task.wait(3)
				if not self.running then
					return
				end
				riseTo(rise.level, 4)
				nextRise += 1
			end
			task.wait(0.25)
		end
	end
	function arena.onSuddenDeath()
		riseTo(12.5, 3)
		nextRise = #rises + 1
	end
	riseTo(-6, 0.1)
end

------------------------------------------------------------------ Bounce House
local function buildBounce(arena)
	local center, folder = arena.center, arena.folder
	local floorY = arena.floorY
	local half = 25
	arena.radius = 36
	local tiles = {}
	local colors = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(255, 230, 90), Color3.fromRGB(110, 220, 255), Color3.fromRGB(255, 255, 255) }
	for ix = -2, 2 do
		for iz = -2, 2 do
			local tile = part({
				Name = "Floor",
				Size = Vector3.new(10, 2, 10),
				Position = Vector3.new(center.X + ix * 10, floorY - 1, center.Z + iz * 10),
				Color = colors[((ix + iz) % #colors) + 1],
				Material = Enum.Material.SmoothPlastic,
				Parent = folder,
			})
			table.insert(tiles, { part = tile, outer = math.max(math.abs(ix), math.abs(iz)) == 2 })
		end
	end
	local walls = {}
	local sides = {
		{ normal = Vector3.new(0, 0, 1), size = Vector3.new(half * 2 + 6, 5, 3), offset = Vector3.new(0, 0, -half - 1.5) },
		{ normal = Vector3.new(0, 0, -1), size = Vector3.new(half * 2 + 6, 5, 3), offset = Vector3.new(0, 0, half + 1.5) },
		{ normal = Vector3.new(1, 0, 0), size = Vector3.new(3, 5, half * 2), offset = Vector3.new(-half - 1.5, 0, 0) },
		{ normal = Vector3.new(-1, 0, 0), size = Vector3.new(3, 5, half * 2), offset = Vector3.new(half + 1.5, 0, 0) },
	}
	for index, side in ipairs(sides) do
		local wall = part({
			Name = "BouncyWall",
			Size = side.size,
			Position = center + side.offset + Vector3.new(0, 2.5, 0),
			Color = index % 2 == 0 and Color3.fromRGB(255, 110, 200) or Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		local long = side.size.X > side.size.Z and side.size.X or side.size.Z
		local roll = part({
			Name = "WallTop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(long, 3.4, 3.4),
			CFrame = CFrame.new(wall.Position + Vector3.new(0, 2.5, 0)) * (side.size.X > side.size.Z and CFrame.new() or CFrame.Angles(0, math.rad(90), 0)),
			Color = wall.Color:Lerp(Color3.new(1, 1, 1), 0.3),
			Material = Enum.Material.SmoothPlastic,
			Parent = folder,
		})
		table.insert(walls, { part = wall, top = roll, normal = side.normal, up = true })
	end

	arena.spawns = ringSpawns(center, floorY, 14)
	local outerGone = false
	local lastBounce = {}
	function arena:SafeRadius()
		return outerGone and 11 or 19
	end
	function arena:RandomFloorPoint()
		local limit = outerGone and 10 or 18
		return Vector3.new(center.X + random:NextNumber(-limit, limit), floorY + 3.5, center.Z + random:NextNumber(-limit, limit))
	end
	local function dropWall(wall)
		if not wall.up then
			return
		end
		wall.up = false
		for _, p in ipairs({ wall.part, wall.top }) do
			p.CanCollide = false
			TweenService:Create(p, TweenInfo.new(1.2), { Position = p.Position - Vector3.new(0, 12, 0), Transparency = 1 }):Play()
		end
		task.delay(1.3, function()
			wall.part:Destroy()
			wall.top:Destroy()
		end)
	end
	local function dropOuter()
		if outerGone then
			return
		end
		outerGone = true
		for _, tile in ipairs(tiles) do
			if tile.outer then
				crumble(tile.part, arena)
			end
		end
	end

	-- Bouncy walls throw you back in (worked out with maths, so fast hits never pass through)
	arena.heartbeat = RunService.Heartbeat:Connect(function()
		if not arena.running then
			return
		end
		local now = os.clock()
		for _, entity in ipairs(arena.entities()) do
			local root = entity.root
			if root and root.Parent and (lastBounce[entity] or 0) + 0.5 < now then
				local rel = root.Position - center
				if rel.Y - (floorY - center.Y) < 8 then
					for _, wall in ipairs(walls) do
						if wall.up and rel:Dot(wall.normal) + half < 2.4 then
							lastBounce[entity] = now
							CombatService.Push(entity, wall.normal * 55 + Vector3.yAxis * 25, 0.35, 0)
							CombatService.Effect("bounce", root.Position)
							break
						end
					end
				end
			end
		end
	end)

	function arena.run(self)
		self.say("Bounce off the walls... while they last!")
		local order = { 1, 2, 3, 4 }
		for index = #order, 2, -1 do
			local other = random:NextInteger(1, index)
			order[index], order[other] = order[other], order[index]
		end
		local dropAt = { 20, 30, 40, 50 }
		local nextDrop = 1
		while self.running do
			local elapsed = self:Elapsed()
			if nextDrop <= #order and elapsed >= dropAt[nextDrop] then
				if walls[order[nextDrop]].up then
					dropWall(walls[order[nextDrop]])
					self.say("A wall fell away!")
				end
				nextDrop += 1
			end
			if not outerGone and elapsed >= 60 then
				self.say("The floor is shrinking!")
				dropOuter()
			end
			if outerGone and nextDrop > #order then
				return
			end
			task.wait(0.25)
		end
	end
	function arena.onSuddenDeath()
		for _, wall in ipairs(walls) do
			dropWall(wall)
		end
		dropOuter()
	end
end

local BUILDERS = { ice = buildIce, spin = buildSpin, lava = buildLava, bounce = buildBounce }

-- Builds a fresh arena of that kind with its floor at center
function ArenaService.Build(arenaId, center, parent)
	local builder = BUILDERS[arenaId] or buildIce
	local arena = baseArena(Arenas.ById[arenaId] and arenaId or "ice", center)
	builder(arena)
	arena.folder.Parent = parent or Workspace
	-- The server moves the spinning floor, so no player's computer takes it over
	for _, item in ipairs(arena.folder:GetDescendants()) do
		if item:IsA("BasePart") and not item.Anchored then
			pcall(item.SetNetworkOwner, item, nil)
		end
	end
	return arena
end

return ArenaService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">BotService</string><ProtectedString name="Source"><![CDATA[-- Bots fill the empty spots in a match so nobody waits alone. They are a bit
-- slower and less accurate than people, their name tags say BOT, and knocking
-- them out is worth less. When a real player joins, a bot steps aside for them
-- (see MatchService).

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)

local CombatService = require(script.Parent.CombatService)
local CosmeticService = require(script.Parent.CosmeticService)

local BotService = {}

local NAMES = { "Bonky", "Thumper", "Wobbles", "Sir Bonks", "Noodle", "Pip", "Biscuit", "Clank", "Mallet Max", "Tumble", "Boing", "Dizzy" }
local SHIRTS = {
	Color3.fromRGB(230, 80, 80),
	Color3.fromRGB(80, 150, 230),
	Color3.fromRGB(90, 200, 110),
	Color3.fromRGB(240, 190, 60),
	Color3.fromRGB(170, 100, 230),
	Color3.fromRGB(240, 130, 60),
}
local SKINS = { Color3.fromRGB(234, 184, 146), Color3.fromRGB(198, 140, 100), Color3.fromRGB(140, 95, 65), Color3.fromRGB(255, 215, 180) }
local BOT_HAMMERS = { "hammer_foam", "hammer_blue", "hammer_green", "hammer_purple", "hammer_mallet" }

BotService.WalkSpeed = 15
local REACH = 6.5
-- Roblox's own R15 animations, so bots walk and jump like players do
local ANIMATIONS = {
	idle = "rbxassetid://507766388",
	walk = "rbxassetid://507777826",
	jump = "rbxassetid://507765000",
	fall = "rbxassetid://507767968",
}

local random = Random.new()
local folder
local nameIndex = 0
local botCount = 0

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Plays the idle, walk, jump and fall animations to match what the bot is doing
local function animate(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local tracks = {}
	for name, id in pairs(ANIMATIONS) do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(animator.LoadAnimation, animator, animation)
		if ok and track then
			track.Looped = name ~= "jump"
			tracks[name] = track
		end
	end
	local current = nil
	local function play(name, speed)
		local track = tracks[name]
		if track ~= current then
			if current then
				current:Stop(0.2)
			end
			current = track
			if track then
				track:Play(0.2)
			end
		end
		if track and speed then
			track:AdjustSpeed(speed)
		end
	end
	humanoid.Running:Connect(function(speed)
		if speed > 0.5 then
			play("walk", math.clamp(speed / 14, 0.6, 1.6))
		else
			play("idle")
		end
	end)
	humanoid.StateChanged:Connect(function(_, state)
		if state == Enum.HumanoidStateType.Jumping then
			play("jump")
		elseif state == Enum.HumanoidStateType.Freefall then
			play("fall")
		end
	end)
	play("idle")
end

-- Makes a bot model standing at cframe. Returns its combat entity.
function BotService.Create(cframe)
	nameIndex = nameIndex % #NAMES + 1
	local name = NAMES[nameIndex]
	local skin = SKINS[random:NextInteger(1, #SKINS)]
	local shirt = SHIRTS[random:NextInteger(1, #SHIRTS)]
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = shirt
	description.LeftLegColor = shirt:Lerp(Color3.new(0, 0, 0), 0.5)
	description.RightLegColor = shirt:Lerp(Color3.new(0, 0, 0), 0.5)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[BotService] Couldn't make a bot: " .. tostring(model))
		return nil
	end
	botCount += 1
	model.Name = "Bot " .. name
	model:PivotTo(cframe)
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local oldAnimate = model:FindFirstChild("Animate")
	if oldAnimate then
		oldAnimate:Destroy()
	end
	pcall(animate, model:FindFirstChildOfClass("Humanoid"))
	local entity = CombatService.Register(model, { kind = "bot", name = name .. " (bot)", key = "b" .. botCount, walkSpeed = BotService.WalkSpeed })
	entity.hammerItem = Cosmetics.ById[BOT_HAMMERS[random:NextInteger(1, #BOT_HAMMERS)]]
	entity.nextThink = 0
	entity.nextBonk = 0
	CosmeticService.BuildHammer(model, entity.hammerItem)
	CosmeticService.Tag(model, { name = name, nameColor = Color3.fromRGB(200, 200, 200), subtitle = "BOT" })
	return entity
end

function BotService.Remove(entity)
	if entity and entity.model then
		entity.model:Destroy()
	end
end

-- Moves a bot (or a dummy) and keeps the server in charge of its physics
function BotService.Place(entity, cframe)
	if entity.model.Parent then
		entity.model:PivotTo(cframe)
		entity.root.AssemblyLinearVelocity = Vector3.zero
		entity.root.AssemblyAngularVelocity = Vector3.zero
		entity.humanoid.PlatformStand = false
		pcall(function()
			entity.root:SetNetworkOwner(nil)
		end)
	end
end

-- Something solid right in front of the bot's feet (a step up) means jump
local function stepAhead(entity, direction)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { entity.model }
	local origin = entity.root.Position - Vector3.new(0, 1.8, 0)
	local hit = Workspace:Raycast(origin, direction * 3, params)
	return hit ~= nil and hit.Instance.CanCollide
end

-- One decision for one bot in a match. space = the match (MatchService) with
-- its arena, alive entities and power-ups.
local function think(entity, space)
	local now = os.clock()
	if entity.frozen or now < entity.stunUntil or not CombatService.IsAlive(entity) then
		return
	end
	local arena = space.arena
	if not arena then
		return
	end
	local humanoid, root = entity.humanoid, entity.root
	local position = root.Position
	local center = Vector3.new(arena.center.X, position.Y, arena.center.Z)
	local fromCenter = flat(position - arena.center)
	local safeRadius = arena:SafeRadius()

	local goal
	-- Back to safety first
	if fromCenter.Magnitude > safeRadius then
		goal = center + (fromCenter.Magnitude > 0.1 and fromCenter.Unit * math.max(0, safeRadius - 6) or Vector3.zero)
	else
		-- A power-up close by is worth grabbing
		local bestPowerUp, bestPowerDistance = nil, 22
		for _, powerUp in ipairs(space:PowerUpPositions()) do
			local distance = (flat(powerUp - position)).Magnitude
			if distance < bestPowerDistance and flat(powerUp - arena.center).Magnitude < safeRadius then
				bestPowerUp, bestPowerDistance = powerUp, distance
			end
		end
		-- Otherwise chase someone, but never off the edge
		if not entity.target or now > (entity.retarget or 0) or not CombatService.IsAlive(entity.target) or not entity.target.space then
			entity.target = nil
			local best = math.huge
			for _, other in ipairs(space:Targets()) do
				if other ~= entity and CombatService.IsAlive(other) then
					local distance = (other.root.Position - position).Magnitude + random:NextNumber(0, 12)
					if distance < best then
						best = distance
						entity.target = other
					end
				end
			end
			entity.retarget = now + random:NextNumber(2, 4)
		end
		local target = entity.target
		if bestPowerUp and (not target or bestPowerDistance < (target.root.Position - position).Magnitude) then
			goal = bestPowerUp
		elseif target then
			local targetPosition = target.root.Position
			local offset = flat(targetPosition - position)
			if offset.Magnitude <= REACH and math.abs(targetPosition.Y - position.Y) < 5 then
				-- Face them and swing (with a little delay, so bots can be beaten)
				root.CFrame = CFrame.lookAt(position, Vector3.new(targetPosition.X, position.Y, targetPosition.Z))
				if now >= entity.nextBonk then
					if CombatService.TryBonk(entity) then
						entity.nextBonk = now + random:NextNumber(0.8, 1.5)
					end
				end
				goal = position
			else
				goal = targetPosition
				local targetFromCenter = flat(targetPosition - arena.center)
				if targetFromCenter.Magnitude > safeRadius then
					goal = Vector3.new(arena.center.X, targetPosition.Y, arena.center.Z) + targetFromCenter.Unit * math.max(0, safeRadius - 2)
				end
				if offset.Magnitude > 9 and offset.Magnitude < 16 and random:NextNumber() < 0.08 then
					CombatService.Dash(entity, offset)
				end
			end
		end
	end

	if goal then
		humanoid:MoveTo(goal)
		local direction = flat(goal - position)
		if direction.Magnitude > 1 and stepAhead(entity, direction.Unit) then
			humanoid.Jump = true
		end
	end
	if arena:ShouldJump(position) and random:NextNumber() < 0.75 then
		humanoid.Jump = true
	end
end

-- space:Bots() lists the bots in a match; this runs them all
function BotService.Think(space)
	for _, entity in ipairs(space:Bots()) do
		local ok, err = pcall(think, entity, space)
		if not ok then
			warn("[BotService] " .. tostring(err))
		end
	end
end

function BotService.Start()
	folder = Instance.new("Folder")
	folder.Name = "Bots"
	folder.Parent = Workspace
end

return BotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[-- Bonking, dashing and knockback for everyone who can be bonked: players, bots
-- and the practice dummies. Each of them is an "entity" with a damage %.
--
-- The server decides every hit (who is in front of you and close enough), so
-- nobody can bonk people from across the map. A bonked player's own computer
-- moves their character (Roblox lets players move their own character), so the
-- server tells it how fast to fly with the Launch remote.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)

local CosmeticService = require(script.Parent.CosmeticService)

local CombatService = {}

local entities = {} -- [model] = entity
local byPlayer = {} -- [player] = entity of their current character
local hitListeners = {}
local bonkListeners = {}
local random = Random.new()

-- Who an entity can hit. MatchService gives entities in a match a "space" with
-- a Targets() function; everyone else can only hit the practice dummies.
local function targetsFor(entity)
	if entity.space then
		return entity.space:Targets()
	end
	local list = {}
	for _, other in pairs(entities) do
		if other.kind == "dummy" then
			table.insert(list, other)
		end
	end
	return list
end

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function alive(entity)
	return entity.root ~= nil and entity.root:IsDescendantOf(workspace) and entity.humanoid ~= nil and entity.humanoid.Health > 0
end
CombatService.IsAlive = alive

function CombatService.Register(model, info)
	local entity = {
		kind = info.kind, -- "player", "bot" or "dummy"
		player = info.player,
		model = model,
		root = model:FindFirstChild("HumanoidRootPart"),
		humanoid = model:FindFirstChildOfClass("Humanoid"),
		name = info.name,
		key = info.key,
		baseSpeed = info.walkSpeed or Config.WalkSpeed,
		damage = 0,
		space = nil,
		lastBonk = 0,
		lastDash = 0,
		stunUntil = 0,
		stunToken = 0,
		frozen = false,
		shield = 0,
		giantUntil = 0,
		speedUntil = 0,
		ironUntil = 0,
		magnetUntil = 0,
		lastHit = nil, -- { by = entity, time = os.clock() }
	}
	if entity.humanoid then
		entity.humanoid.UseJumpPower = false
		entity.humanoid.JumpHeight = Config.JumpHeight
		entity.humanoid.WalkSpeed = entity.baseSpeed
	end
	entities[model] = entity
	if info.player then
		byPlayer[info.player] = entity
	end
	model:SetAttribute("Damage", 0)
	model.Destroying:Connect(function()
		CombatService.Unregister(model)
	end)
	return entity
end

function CombatService.Unregister(model)
	local entity = entities[model]
	if not entity then
		return
	end
	entities[model] = nil
	if entity.player and byPlayer[entity.player] == entity then
		byPlayer[entity.player] = nil
	end
end

function CombatService.Get(model)
	return entities[model]
end

function CombatService.GetByPlayer(player)
	return byPlayer[player]
end

-- Called with (attacker, target) after every landed bonk
function CombatService.OnHit(listener)
	table.insert(hitListeners, listener)
end

-- Called with (entity) whenever someone swings
function CombatService.OnBonk(listener)
	table.insert(bonkListeners, listener)
end

function CombatService.Effect(kind, position, extra)
	Remotes.Effect:FireAllClients(kind, position, extra)
end

------------------------------------------------------------------ Damage and movement
function CombatService.SetDamage(entity, value)
	entity.damage = math.clamp(value, 0, Config.MaxDamage)
	entity.model:SetAttribute("Damage", math.floor(entity.damage))
end

-- Walk speed and jumping, from frozen / speed boots / normal
function CombatService.UpdateMovement(entity)
	local humanoid = entity.humanoid
	if not humanoid or not humanoid.Parent then
		return
	end
	if entity.frozen then
		humanoid.WalkSpeed = 0
		humanoid.JumpHeight = 0
	else
		humanoid.WalkSpeed = entity.speedUntil > os.clock() and PowerUps.SpeedWalkSpeed or entity.baseSpeed
		humanoid.JumpHeight = Config.JumpHeight
	end
end

-- Frozen entities can't move, bonk or be bonked (the countdown before a round)
function CombatService.Freeze(entity, frozen)
	entity.frozen = frozen
	CombatService.UpdateMovement(entity)
end

-- Clears damage and power-ups, for a fresh round
function CombatService.Reset(entity)
	CombatService.SetDamage(entity, 0)
	entity.lastHit = nil
	entity.stunUntil = 0
	entity.shield = 0
	entity.giantUntil = 0
	entity.speedUntil = 0
	entity.ironUntil = 0
	entity.magnetUntil = 0
	local wasGiant = entity.model:GetAttribute("GiantHammer")
	entity.model:SetAttribute("GiantHammer", nil)
	for _, name in ipairs({ "BonkShield", "IronBoots" }) do
		local item = entity.model:FindFirstChild(name)
		if item then
			item:Destroy()
		end
	end
	if entity.player then
		CosmeticService.RefreshHammer(entity.player, 1)
	elseif wasGiant and entity.hammerItem then
		CosmeticService.BuildHammer(entity.model, entity.hammerItem, 1)
	end
	CombatService.UpdateMovement(entity)
	if entity.humanoid then
		entity.humanoid.PlatformStand = false
	end
end

-- Sends an entity flying. Players' computers move their own characters; the
-- server moves bots and dummies itself.
function CombatService.Launch(entity, velocity, stun)
	if not alive(entity) then
		return
	end
	local now = os.clock()
	entity.stunUntil = math.max(entity.stunUntil, now + stun)
	local spinAxis = flat(velocity).Magnitude > 0.1 and flat(velocity).Unit:Cross(Vector3.yAxis) or Vector3.xAxis
	local spin = spinAxis * random:NextNumber(4, 9)
	if entity.player then
		Remotes.Launch:FireClient(entity.player, velocity, stun, spin)
		return
	end
	entity.stunToken += 1
	local token = entity.stunToken
	entity.humanoid.PlatformStand = true
	entity.root.AssemblyLinearVelocity = velocity
	entity.root.AssemblyAngularVelocity = spin
	task.delay(stun, function()
		if entity.stunToken == token and entity.humanoid.Parent then
			entity.humanoid.PlatformStand = false
			entity.root.AssemblyAngularVelocity = Vector3.zero
			-- Stand back up straight
			local position = entity.root.Position
			local look = flat(entity.root.CFrame.LookVector)
			if look.Magnitude < 0.1 then
				look = Vector3.new(0, 0, -1)
			end
			entity.root.CFrame = CFrame.lookAt(position, position + look)
		end
	end)
end

-- A push that doesn't come from a bonk (bouncy walls, the sweeper bar, a banana).
-- by = the entity that caused it, if any, so a fall still counts as their knockout.
function CombatService.Push(entity, velocity, stun, addDamage, by)
	if not alive(entity) or entity.frozen then
		return
	end
	if addDamage and addDamage > 0 then
		CombatService.SetDamage(entity, entity.damage + addDamage)
	end
	if entity.ironUntil > os.clock() then
		velocity = Vector3.new(velocity.X * PowerUps.IronShare, velocity.Y, velocity.Z * PowerUps.IronShare)
	end
	if by then
		entity.lastHit = { by = by, time = os.clock() }
	end
	CombatService.Launch(entity, velocity, stun)
end

------------------------------------------------------------------ Bonking
-- The right shoulder joint and the axis that lifts the arm forward. Older rigs
-- use a Motor6D (turn its C0); newer ones an AnimationConstraint (turn the
-- shoulder attachment on the torso instead).
local function shoulder(model)
	local joint, axis = nil, nil
	local arm = model:FindFirstChild("RightUpperArm")
	if arm and arm:FindFirstChild("RightShoulder") then
		joint, axis = arm.RightShoulder, Vector3.xAxis
	else
		local torso = model:FindFirstChild("Torso")
		if torso and torso:FindFirstChild("Right Shoulder") then
			joint, axis = torso["Right Shoulder"], Vector3.zAxis
		end
	end
	if not joint then
		return nil
	end
	if joint:IsA("Motor6D") then
		return joint, "C0", axis
	elseif joint:IsA("AnimationConstraint") and joint.Attachment0 then
		return joint.Attachment0, "CFrame", axis
	end
	return nil
end

-- Swings the right arm (and the hammer in that hand) up and down
local function swing(entity)
	local target, property, axis = shoulder(entity.model)
	if not target then
		return
	end
	if entity.shoulderTarget ~= target then
		entity.shoulderTarget = target
		entity.shoulderBase = target[property]
	end
	local base = entity.shoulderBase
	local function at(degrees)
		return base * CFrame.fromAxisAngle(axis, math.rad(degrees))
	end
	entity.swingToken = (entity.swingToken or 0) + 1
	local token = entity.swingToken
	TweenService:Create(target, TweenInfo.new(0.07), { [property] = at(165) }):Play()
	task.delay(0.07, function()
		if entity.swingToken ~= token or not target.Parent then
			return
		end
		TweenService:Create(target, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { [property] = at(55) }):Play()
		task.delay(0.22, function()
			if entity.swingToken ~= token or not target.Parent then
				return
			end
			TweenService:Create(target, TweenInfo.new(0.2), { [property] = base }):Play()
		end)
	end)
end

-- One landed bonk: adds damage and sends the target flying away from the attacker.
-- options.power multiplies the push (Giant Hammer).
function CombatService.Hit(attacker, target, options)
	options = options or {}
	if not alive(target) or target.frozen then
		return false
	end
	local now = os.clock()
	local away = flat(target.root.Position - attacker.root.Position)
	if away.Magnitude < 0.1 then
		away = flat(attacker.root.CFrame.LookVector)
	end
	away = away.Unit

	if target.shield > 0 then
		target.shield -= 1
		if target.shield <= 0 then
			local bubble = target.model:FindFirstChild("BonkShield")
			if bubble then
				bubble:Destroy()
			end
		end
		CombatService.Effect("block", target.root.Position)
		-- The shield bounces the attacker back a little
		CombatService.Launch(attacker, -away * 35 + Vector3.yAxis * 20, 0.3)
		return false
	end

	local power = options.power or 1
	local amount = random:NextInteger(Config.BonkDamageMin, Config.BonkDamageMax)
	if power > 1 then
		amount = math.floor(amount * 1.25)
	end
	CombatService.SetDamage(target, target.damage + amount)
	local speed, up = Config.Knockback(target.damage)
	if target.ironUntil > now then
		power *= PowerUps.IronShare
	end
	local velocity = away * speed * power + Vector3.yAxis * up * math.max(power, 0.7)
	target.lastHit = { by = attacker, time = now }
	CombatService.Launch(target, velocity, Config.Stun(target.damage))
	CombatService.Effect("hit", target.root.Position, { damage = amount, total = math.floor(target.damage), big = power > 1 })
	for _, listener in ipairs(hitListeners) do
		task.spawn(listener, attacker, target)
	end
	return true
end

local function resolveBonk(entity)
	if not alive(entity) or entity.frozen or entity.stunUntil > os.clock() then
		return -- got bonked during the swing
	end
	local now = os.clock()
	local giant = entity.giantUntil > now
	local magnet = entity.magnetUntil > now
	local range = Config.BonkRange + (giant and PowerUps.GiantReach or 0)
	if magnet then
		range = math.max(range, PowerUps.MagnetBonkRange)
		entity.magnetUntil = 0
		CombatService.Effect("shockwave", entity.root.Position, { range = range })
	end
	local origin = entity.root.Position
	local look = flat(entity.root.CFrame.LookVector)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
	local minDot = math.cos(math.rad(Config.BonkArc / 2))
	for _, target in ipairs(targetsFor(entity)) do
		if target ~= entity and alive(target) then
			local offset = target.root.Position - origin
			local flatOffset = flat(offset)
			local distance = flatOffset.Magnitude
			if distance <= range and math.abs(offset.Y) <= 6 then
				if magnet or distance < 2.5 or look:Dot(flatOffset.Unit) >= minDot then
					CombatService.Hit(entity, target, { power = giant and PowerUps.GiantPower or 1 })
				end
			end
		end
	end
end

-- Starts a swing if the entity is allowed to. The hit lands a moment later.
function CombatService.TryBonk(entity)
	local now = os.clock()
	if not alive(entity) or entity.frozen or now < entity.stunUntil or now - entity.lastBonk < Config.BonkCooldown then
		return false
	end
	entity.lastBonk = now
	swing(entity)
	CombatService.Effect("swing", entity.root.Position)
	for _, listener in ipairs(bonkListeners) do
		task.spawn(listener, entity)
	end
	task.delay(Config.BonkImpactDelay, resolveBonk, entity)
	return true
end

-- Bots dash on the server (players dash on their own computer, see Controls.luau)
function CombatService.Dash(entity, direction)
	local now = os.clock()
	if not alive(entity) or entity.frozen or now < entity.stunUntil or now - entity.lastDash < Config.DashCooldown then
		return false
	end
	entity.lastDash = now
	local dir = flat(direction or entity.root.CFrame.LookVector)
	if dir.Magnitude < 0.1 then
		return false
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = entity.root
	local mover = Instance.new("LinearVelocity")
	mover.Name = "Dash"
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	mover.MaxAxesForce = Vector3.new(1e6, 0, 1e6)
	mover.VectorVelocity = dir.Unit * Config.DashSpeed
	mover.Parent = entity.root
	task.delay(Config.DashSeconds, function()
		mover:Destroy()
		attachment:Destroy()
	end)
	CombatService.Effect("dash", entity.root.Position)
	return true
end

function CombatService.All()
	return entities
end

function CombatService.Start()
	local function watch(player)
		player.CharacterRemoving:Connect(function(character)
			CombatService.Unregister(character)
		end)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			character:WaitForChild("Humanoid", 10)
			if character.Parent then
				CombatService.Register(character, { kind = "player", player = player, name = player.DisplayName, key = "p" .. player.UserId })
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
		if player.Character then
			CombatService.Register(player.Character, { kind = "player", player = player, name = player.DisplayName, key = "p" .. player.UserId })
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		byPlayer[player] = nil
	end)

	-- Speed Boots and the Giant Hammer wear off
	task.spawn(function()
		while true do
			task.wait(0.25)
			local now = os.clock()
			for _, entity in pairs(entities) do
				if entity.speedEnds and now >= entity.speedUntil then
					entity.speedEnds = nil
					CombatService.UpdateMovement(entity)
				end
				if entity.model:GetAttribute("GiantHammer") and now >= entity.giantUntil then
					entity.model:SetAttribute("GiantHammer", nil)
					if entity.player then
						CosmeticService.RefreshHammer(entity.player, 1)
					else
						CosmeticService.BuildHammer(entity.model, entity.hammerItem, 1)
					end
				end
				if entity.ironUntil > 0 and now >= entity.ironUntil then
					entity.ironUntil = 0
					local boots = entity.model:FindFirstChild("IronBoots")
					if boots then
						boots:Destroy()
					end
				end
			end
		end
	end)

	Remotes.Bonk.OnServerEvent:Connect(function(player)
		local entity = byPlayer[player]
		if entity then
			CombatService.TryBonk(entity)
		end
	end)
	-- Players dash on their own computer; show the puff to everyone else
	Remotes.Dash.OnServerEvent:Connect(function(player)
		local entity = byPlayer[player]
		if entity and alive(entity) and os.clock() - entity.lastDash >= Config.DashCooldown * 0.8 then
			entity.lastDash = os.clock()
			CombatService.Effect("dash", entity.root.Position)
		end
	end)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">CosmeticService</string><ProtectedString name="Source"><![CDATA[-- How everyone looks: name tags (name, level, title, VIP and damage %), hammers,
-- trails, the VIP crown, victory dances and knockout effects.
-- Also hands out the free cosmetics players unlock by levelling up or playing.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local CosmeticService = {}

local VIP_GOLD = Color3.fromRGB(255, 200, 40)
local applied = {} -- [player] = signature of what is shown, to skip needless rebuilds
local tagConnections = {} -- [model] = connections that keep the damage line up to date

local function isVip(player)
	return ShopService.HasPass(player, "VIP")
end

-- The cosmetic a player shows for a kind (falls back to the free default)
function CosmeticService.Equipped(player, kind)
	local data = DataService.Get(player)
	if not data then
		return Cosmetics.ById[Cosmetics.Defaults[kind] or ""]
	end
	return Cosmetics.Equipped(data, kind, isVip(player))
end

------------------------------------------------------------------ Hammers
local function piece(hammer, hand, gripY, props)
	local p = Instance.new("Part")
	p.Name = props.Name or "Piece"
	p.Size = props.Size
	p.Shape = props.Shape or Enum.PartType.Block
	p.Color = props.Color
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Mesh then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = p
	weld.C0 = CFrame.new(0, gripY, 0) * props.CFrame
	weld.Parent = p
	p.CFrame = hand.CFrame * weld.C0
	p.Parent = hammer
	return p
end

-- Builds the hammer in the model's right hand. The handle points forward from
-- the hand, so swinging the arm brings the head down in front of you.
-- scale > 1 for the Giant Hammer power-up.
function CosmeticService.BuildHammer(model, item, scale)
	scale = scale or 1
	item = item or Cosmetics.ById[Cosmetics.Defaults.hammer]
	local old = model:FindFirstChild("BonkHammer")
	if old then
		old:Destroy()
	end
	local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")
	if not hand then
		return
	end
	local gripY = hand.Name == "RightHand" and -0.15 or -0.9
	local hammer = Instance.new("Model")
	hammer.Name = "BonkHammer"
	local s = scale
	local forward = CFrame.Angles(0, math.rad(90), 0) -- a cylinder's length runs forward
	local upright = CFrame.Angles(0, 0, math.rad(90)) -- a cylinder's length runs up and down

	if item.shape == "chicken" then
		piece(hammer, hand, gripY, { Name = "Legs", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2 * s, 0.3, 0.3), CFrame = CFrame.new(0, 0, -0.9 * s) * forward, Color = item.handle })
		piece(hammer, hand, gripY, { Name = "Head", Mesh = true, Size = Vector3.new(1.4, 1.4, 3.2) * s, CFrame = CFrame.new(0, 0, -3.4 * s), Color = item.head, Material = item.material })
		piece(hammer, hand, gripY, { Name = "Neck", Mesh = true, Size = Vector3.new(0.8, 0.8, 1.8) * s, CFrame = CFrame.new(0, 0.3 * s, -5.3 * s) * CFrame.Angles(math.rad(-20), 0, 0), Color = item.head, Material = item.material })
		piece(hammer, hand, gripY, { Name = "Comb", Size = Vector3.new(0.2, 0.6, 0.8) * s, CFrame = CFrame.new(0, 0.85 * s, -6 * s), Color = Color3.fromRGB(230, 40, 40) })
		piece(hammer, hand, gripY, { Name = "Beak", Size = Vector3.new(0.4, 0.3, 0.6) * s, CFrame = CFrame.new(0, 0.5 * s, -6.6 * s), Color = item.handle })
	elseif item.shape == "fish" then
		piece(hammer, hand, gripY, { Name = "Tail", Size = Vector3.new(0.2, 1.4, 1) * s, CFrame = CFrame.new(0, 0, -0.3 * s), Color = item.handle })
		piece(hammer, hand, gripY, { Name = "Head", Mesh = true, Size = Vector3.new(1, 1.8, 4.2) * s, CFrame = CFrame.new(0, 0, -2.9 * s), Color = item.head, Material = item.material })
		piece(hammer, hand, gripY, { Name = "Fin", Size = Vector3.new(0.15, 0.8, 1.2) * s, CFrame = CFrame.new(0, 0.95 * s, -2.8 * s), Color = item.handle })
		for _, side in ipairs({ -1, 1 }) do
			piece(hammer, hand, gripY, { Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.35 * s, CFrame = CFrame.new(0.42 * side * s, 0.25 * s, -4.4 * s), Color = Color3.new(1, 1, 1) })
		end
	else
		piece(hammer, hand, gripY, { Name = "Handle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4 * s, 0.35 * s, 0.35 * s), CFrame = CFrame.new(0, 0, -1.4 * s) * forward, Color = item.handle, Material = item.material == Enum.Material.Neon and Enum.Material.SmoothPlastic or item.material })
		if item.shape == "mallet" then
			piece(hammer, hand, gripY, { Name = "Head", Size = Vector3.new(1.5, 2.6, 1.5) * s, CFrame = CFrame.new(0, 0, -3.3 * s), Color = item.head, Material = item.material })
		else
			piece(hammer, hand, gripY, { Name = "Head", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6 * s, 1.6 * s, 1.6 * s), CFrame = CFrame.new(0, 0, -3.3 * s) * upright, Color = item.head, Material = item.material })
			for _, side in ipairs({ -1, 1 }) do
				piece(hammer, hand, gripY, { Name = "Cap", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25 * s, 1.75 * s, 1.75 * s), CFrame = CFrame.new(0, 1.3 * side * s, -3.3 * s) * upright, Color = item.handle, Material = item.material == Enum.Material.Neon and Enum.Material.Neon or Enum.Material.SmoothPlastic })
			end
		end
	end
	hammer.Parent = model
	return hammer
end

------------------------------------------------------------------ Name tags
-- info = { name, nameColor, title (cosmetic item or nil), subtitle }
function CosmeticService.Tag(model, info)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("BonkTag")
	if old then
		old:Destroy()
	end
	if tagConnections[model] then
		for _, connection in ipairs(tagConnections[model]) do
			connection:Disconnect()
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "BonkTag"
	gui.Size = UDim2.fromOffset(220, 96)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.MaxDistance = 140
	gui.Adornee = head
	local layout = Instance.new("UIListLayout")
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui
	local order = 0
	local function line(name, text, color, height)
		order += 1
		local label = Instance.new("TextLabel")
		label.Name = name
		label.Size = UDim2.new(1, 0, 0, height)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextStrokeTransparency = 0.3
		label.LayoutOrder = order
		label.Parent = gui
		return label
	end
	local damage = line("Damage", "0%", Color3.new(1, 1, 1), 30)
	if info.title then
		line("Title", info.title.text, info.title.color, 16)
	end
	line("PlayerName", info.name, info.nameColor or Color3.new(1, 1, 1), 22)
	line("Sub", info.subtitle or "", Color3.fromRGB(150, 220, 255), 16)

	local function refresh()
		local value = math.floor(model:GetAttribute("Damage") or 0)
		damage.Text = value .. "%"
		damage.TextColor3 = Format.DamageColor(value)
		damage.Visible = model:GetAttribute("ShowDamage") == true
	end
	tagConnections[model] = {
		model:GetAttributeChangedSignal("Damage"):Connect(refresh),
		model:GetAttributeChangedSignal("ShowDamage"):Connect(refresh),
		model.Destroying:Connect(function()
			tagConnections[model] = nil
		end),
	}
	refresh()
	gui.Parent = head
end

------------------------------------------------------------------ Players
local function clearOld(character)
	for _, item in ipairs(character:GetDescendants()) do
		if item.Name == "BonkTrail" or item.Name == "BonkCrown" or item.Name == "BonkTrailTop" or item.Name == "BonkTrailBottom" then
			item:Destroy()
		end
	end
end

local function applyToCharacter(player)
	local data = DataService.Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local head = character:WaitForChild("Head", 5)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not head or not root or not character.Parent then
		return
	end
	clearOld(character)

	local vip = isVip(player)
	local title = Cosmetics.Equipped(data, "title", vip)
	CosmeticService.Tag(character, {
		name = player.DisplayName,
		nameColor = vip and VIP_GOLD or nil,
		title = title,
		subtitle = string.format("%sLv %d", vip and "VIP  " or "", Level.FromXp(data.xp)),
	})

	if not character:GetAttribute("GiantHammer") then
		CosmeticService.BuildHammer(character, Cosmetics.Equipped(data, "hammer", vip))
	end

	if vip then
		local crown = Instance.new("Part")
		crown.Name = "BonkCrown"
		crown.Size = Vector3.new(1.1, 0.5, 1.1)
		crown.Color = VIP_GOLD
		crown.Material = Enum.Material.Neon
		crown.CanCollide = false
		crown.CanQuery = false
		crown.CanTouch = false
		crown.Massless = true
		local weld = Instance.new("Weld")
		weld.Part0 = head
		weld.Part1 = crown
		weld.C0 = CFrame.new(0, head.Size.Y / 2 + 0.3, 0)
		weld.Parent = crown
		crown.Parent = character
	end

	local trailItem = Cosmetics.Equipped(data, "trail", vip)
	if trailItem then
		local top = Instance.new("Attachment")
		top.Name = "BonkTrailTop"
		top.Position = Vector3.new(0, 0.8, 0.5)
		top.Parent = root
		local bottom = Instance.new("Attachment")
		bottom.Name = "BonkTrailBottom"
		bottom.Position = Vector3.new(0, -0.8, 0.5)
		bottom.Parent = root
		local keypoints = {}
		for index, color in ipairs(trailItem.colors) do
			table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(1, #trailItem.colors - 1), color))
		end
		local trail = Instance.new("Trail")
		trail.Name = "BonkTrail"
		trail.Attachment0 = top
		trail.Attachment1 = bottom
		trail.Color = ColorSequence.new(keypoints)
		trail.Lifetime = 0.6
		trail.LightEmission = 0.6
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = root
	end
end

-- Rebuilds a player's hammer (after the Giant Hammer power-up ends, for example)
function CosmeticService.RefreshHammer(player, scale)
	local character = player.Character
	if character then
		CosmeticService.BuildHammer(character, CosmeticService.Equipped(player, "hammer"), scale)
	end
end

local function signature(data, runtime)
	local equipped = data.cosmetics.equipped
	return table.concat({
		tostring(equipped.title),
		tostring(equipped.trail),
		tostring(equipped.hammer),
		tostring(runtime.passes and runtime.passes.VIP),
		tostring(Level.FromXp(data.xp)),
	}, "|")
end

------------------------------------------------------------------ Free unlocks
local function unlocked(item, data)
	if item.source == "level" then
		return Level.FromXp(data.xp) >= item.level
	elseif item.source == "earned" then
		return (data.stats[item.rule] or 0) >= item.amount
	end
	return false
end

local function checkUnlocks(player, data)
	local new = {}
	for _, item in ipairs(Cosmetics.List) do
		if (item.source == "level" or item.source == "earned") and not data.cosmetics.owned[item.id] and unlocked(item, data) then
			table.insert(new, item)
		end
	end
	if #new == 0 then
		return
	end
	DataService.Update(player, function(saved)
		for _, item in ipairs(new) do
			saved.cosmetics.owned[item.id] = true
		end
	end)
	for _, item in ipairs(new) do
		Remotes.Notify:FireClient(player, "Unlocked: " .. item.name .. "! Equip it in the Locker.", "rare")
	end
end

------------------------------------------------------------------ Victory dances
-- Each dance moves the whole character for a few seconds: t = seconds since the
-- start, returns an offset from where the character stands.
local DANCES = {
	dance_cheer = function(t)
		local hop = math.abs(math.sin(t * math.pi * 1.6)) * 2.5
		return CFrame.new(0, hop, 0)
	end,
	dance_jump = function(t)
		local cycle = t % 2
		local height = math.max(0, math.sin(cycle / 1.2 * math.pi)) * 9
		local turn = cycle < 1.2 and cycle / 1.2 * math.pi * 2 or 0
		return CFrame.new(0, height, 0) * CFrame.Angles(0, turn, 0)
	end,
	dance_spin = function(t)
		return CFrame.Angles(0, t * math.pi * 3, 0)
	end,
	dance_hop = function(t)
		local hop = math.abs(math.sin(t * math.pi * 2.5)) * 1.8
		local side = math.sin(t * math.pi * 1.25) * 2
		return CFrame.new(side, hop, 0)
	end,
	dance_flip = function(t)
		local cycle = t % 1.6
		local height = math.max(0, math.sin(cycle / 1.1 * math.pi)) * 6
		local flip = cycle < 1.1 and cycle / 1.1 * math.pi * 2 or 0
		return CFrame.new(0, height, 0) * CFrame.Angles(flip, 0, 0)
	end,
	dance_heli = function(t)
		local height = math.sin(math.min(t, 5) / 5 * math.pi) * 7
		return CFrame.new(0, height, 0) * CFrame.Angles(0, t * math.pi * 8, 0)
	end,
}

-- Plays a victory dance on a model standing at standCFrame, for seconds.
function CosmeticService.Dance(model, danceId, standCFrame, seconds)
	local root = model:FindFirstChild("HumanoidRootPart")
	local dance = DANCES[danceId] or DANCES.dance_cheer
	if not root then
		return
	end
	root.Anchored = true
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local t = os.clock() - started
		if t >= seconds or not root.Parent then
			connection:Disconnect()
			if root.Parent then
				model:PivotTo(standCFrame)
				root.Anchored = false
			end
			return
		end
		model:PivotTo(standCFrame * dance(t))
	end)
end

function CosmeticService.Start()
	DataService.OnChanged(function(player, data, runtime)
		checkUnlocks(player, data)
		local current = signature(data, runtime)
		if applied[player] ~= current then
			applied[player] = current
			applyToCharacter(player)
		end
	end)

	local function watch(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.3)
			applyToCharacter(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		applied[player] = nil
	end)
end

return CosmeticService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[-- Loads, saves and hands out each player's save data.
-- Other scripts change data with DataService.Update(player, function(data) ... end)
-- so the player's screen and leaderboard always refresh afterwards.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Level = require(Shared.Level)

local DataService = {}

local LOCK_EXPIRES = 15 * 60 -- a lock older than this is from a crashed server

local function defaultData()
	return {
		coins = 0,
		totalEarned = 0,
		xp = 0,
		tutorial = 1, -- step of the first-time guide (Shared/Tutorial)
		stats = {
			matches = 0,
			wins = 0,
			rounds = 0,
			kos = 0,
			bonks = 0,
			powerups = 0,
		},
		weekly = { week = 0, wins = 0 }, -- for the weekly leaderboard
		quests = { day = 0, list = {} },
		cosmetics = {
			owned = {}, -- [cosmeticId] = true
			equipped = {}, -- [kind] = cosmeticId
		},
		levelRewards = 1, -- highest level whose reward was paid
		purchases = {}, -- [receiptPurchaseId] = true
		lastDailyDay = 0,
		dailyStreak = 0,
	}
end

-- Fill in any fields missing from older saves
local function reconcile(data, template)
	for key, value in pairs(template) do
		if data[key] == nil then
			if type(value) == "table" then
				data[key] = table.clone(value)
			else
				data[key] = value
			end
		elseif type(value) == "table" and type(data[key]) == "table" then
			reconcile(data[key], value)
		end
	end
	return data
end

local store = nil
local savingEnabled = true
local profiles = {} -- [player] = { data = {}, runtime = {} }
local listeners = {} -- functions called after any data change

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		savingEnabled = false
		warn("[DataService] DataStores unavailable, progress will not save: " .. tostring(result))
	end
end

local function keyFor(player)
	return "player_" .. player.UserId
end

local function loadData(player)
	if not store then
		return defaultData(), false
	end

	local key = keyFor(player)
	for attempt = 1, 6 do
		local lockedElsewhere = false
		local stealLock = attempt >= 4 -- after ~15 seconds, assume the old server is gone
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(saved)
				saved = saved or { data = defaultData() }
				local lock = saved.lock
				if lock and lock.jobId ~= game.JobId and os.time() - lock.time < LOCK_EXPIRES and not stealLock then
					lockedElsewhere = true
					return nil
				end
				saved.lock = { jobId = game.JobId, time = os.time() }
				return saved
			end)
		end)

		if ok and not lockedElsewhere and result then
			return reconcile(result.data or defaultData(), defaultData()), true
		end

		if not ok then
			local message = tostring(result)
			warn(string.format("[DataService] Load attempt %d failed for %s: %s", attempt, player.Name, message))
			if RunService:IsStudio() then
				-- Usually an unpublished place, or "Enable Studio Access to API Services" is off
				return defaultData(), false
			end
		end
		task.wait(5)
	end
	return nil, false
end

local function saveData(player, release)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return true
	end
	local data = profile.data
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function(saved)
			saved = saved or {}
			if saved.lock and saved.lock.jobId ~= game.JobId then
				-- Another server took over this player; don't overwrite newer data
				return nil
			end
			saved.data = data
			saved.lock = (not release) and { jobId = game.JobId, time = os.time() } or nil
			return saved
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for " .. player.Name .. ": " .. tostring(err))
	end

	-- Global leaderboards: most wins, most knockouts, most wins this week
	pcall(function()
		local key = tostring(player.UserId)
		DataStoreService:GetOrderedDataStore(Config.WinsStoreName):SetAsync(key, data.stats.wins)
		DataStoreService:GetOrderedDataStore(Config.KosStoreName):SetAsync(key, data.stats.kos)
		if data.weekly.wins > 0 then
			DataStoreService:GetOrderedDataStore(Config.WeeklyWinsStorePrefix .. data.weekly.week):SetAsync(key, data.weekly.wins)
		end
	end)
	return ok
end

local function setupLeaderstats(player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, name in ipairs({ "Level", "Wins", "KOs" }) do
		local value = Instance.new("IntValue")
		value.Name = name
		value.Parent = folder
	end
	folder.Parent = player
end

local function refresh(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local data = profile.data
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Level.Value = Level.FromXp(data.xp)
		stats.Wins.Value = data.stats.wins
		stats.KOs.Value = data.stats.kos
	end
	for _, listener in ipairs(listeners) do
		task.spawn(listener, player, data, profile.runtime)
	end
	Remotes.DataUpdate:FireClient(player, data, profile.runtime)
end

function DataService.Get(player)
	local profile = profiles[player]
	return profile and profile.data
end

-- Runtime info that is not saved (game passes owned, ...)
function DataService.GetRuntime(player)
	local profile = profiles[player]
	return profile and profile.runtime
end

function DataService.Update(player, change)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local results = table.pack(change(profile.data, profile.runtime))
	refresh(player)
	return table.unpack(results, 1, results.n)
end

function DataService.Refresh(player)
	refresh(player)
end

-- Called with (player, data, runtime) after every change
function DataService.OnChanged(listener)
	table.insert(listeners, listener)
end

function DataService.SaveNow(player)
	return saveData(player, false)
end

function DataService.IsLoaded(player)
	return profiles[player] ~= nil
end

-- Waits until the player's data has loaded (or they left)
function DataService.WaitFor(player)
	while player.Parent and not profiles[player] do
		task.wait(0.2)
	end
	return profiles[player] ~= nil
end

local loadedCallbacks = {}
-- callback(player, data, runtime) runs once per player, before the data is shared.
-- It may yield, but must not call DataService.Get/Update for that player.
function DataService.OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
end

local function onPlayerAdded(player)
	setupLeaderstats(player)
	local data, canSave = loadData(player)
	if not player.Parent then
		return
	end
	if not data then
		player:Kick("We couldn't load your save. Please rejoin in a minute.")
		return
	end
	-- Loaded callbacks fill in runtime info (like game passes) before anything else sees the data
	local runtime = { passes = {} }
	for _, callback in ipairs(loadedCallbacks) do
		callback(player, data, runtime)
	end
	if not player.Parent then
		return
	end
	profiles[player] = { data = data, runtime = runtime, canSave = canSave and savingEnabled }
	refresh(player)
	if not profiles[player].canSave then
		Remotes.Notify:FireClient(player, "Saving is off (in Studio, turn on API Services to test saving).", "warning")
	end
end

local function onPlayerRemoving(player)
	if profiles[player] then
		saveData(player, true)
		profiles[player] = nil
	end
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in pairs(profiles) do
				task.spawn(saveData, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				saveData(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Builds the sky lobby and the three arena spots when the place has no folder
-- called "Map" in Workspace, so the game is playable the moment you press Play.
-- The arenas themselves are built fresh for every round by ArenaService.
-- To use your own scenery later, the game only cares about parts with these attributes:
--   QueuePad = 1      a pad in the lobby that queues players for arena spot 1
--   PadSize  = 4      how many players a match on that pad has (2 or 4)
--   PadName  = "Brawl"
--   ArenaCenter = 1   the middle of arena spot 1's floor
--   Deck = 1          where knocked-out players of spot 1 watch the rest of the round
--   Podium = 1        where the winner of spot 1 dances
--   Station = "WinsBoard" / "KosBoard" / "HowTo"
--   GuideTarget = "Practice" / "Pads"   where the first-time guide points
--   Dummy = true      where a practice dummy stands
--   LobbyFloor = true the lobby (players who fall off it come back)

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local MapBuilder = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			p[key] = value
		end
	end
	p.Parent = props.Parent
	return p
end

local function disc(folder, name, position, radius, thickness, color, material)
	return part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(position - Vector3.new(0, thickness / 2, 0)) * UPRIGHT,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = folder,
	})
end

local function sign(parentPart, text, face, color, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 40
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = gui
	gui.Parent = parentPart
	return label
end

-- A floating island: a grassy top with rocky layers getting smaller underneath
local function floatingIsland(folder, name, top, radius, grass)
	disc(folder, name .. "Top", top, radius, 3, grass, Enum.Material.Grass)
	local rock = Color3.fromRGB(120, 105, 95)
	for index, shrink in ipairs({ 0.92, 0.75, 0.55, 0.32 }) do
		disc(folder, name .. "Rock" .. index, top - Vector3.new(0, 3 + (index - 1) * 6, 0), radius * shrink, 6, rock:Lerp(Color3.fromRGB(80, 70, 65), index / 4), Enum.Material.Rock)
	end
end

local function cloud(folder, position, size, random)
	for _ = 1, 4 do
		part({
			Name = "Cloud",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size * random:NextNumber(0.6, 1),
			Position = position + Vector3.new(random:NextNumber(-size, size), random:NextNumber(-size / 4, size / 4), random:NextNumber(-size / 2, size / 2)),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.25,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Parent = folder,
		})
	end
end

local function tree(folder, position, random)
	local height = random:NextNumber(8, 13)
	part({ Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 1.6, 1.6), CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * UPRIGHT, Material = Enum.Material.Wood, Color = Color3.fromRGB(110, 80, 50), Parent = folder })
	part({ Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * random:NextNumber(7, 10), Position = position + Vector3.new(0, height + 1.5, 0), Material = Enum.Material.Grass, Color = Color3.fromRGB(70, 180, 80), CanCollide = false, Parent = folder })
end

local function lamp(folder, position)
	part({ Name = "LampPost", Size = Vector3.new(0.6, 9, 0.6), Position = position + Vector3.new(0, 4.5, 0), Color = Color3.fromRGB(50, 50, 60), Material = Enum.Material.Metal, Parent = folder })
	local bulb = part({ Name = "Lamp", Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), Position = position + Vector3.new(0, 9.4, 0), Color = Color3.fromRGB(255, 230, 160), Material = Enum.Material.Neon, Parent = folder })
	local light = Instance.new("PointLight")
	light.Range = 16
	light.Brightness = 1.5
	light.Color = Color3.fromRGB(255, 220, 150)
	light.Parent = bulb
end

local function board(folder, name, cframe, size, station)
	local p = part({ Name = name, Size = size, CFrame = cframe, Color = Color3.fromRGB(30, 40, 60), Material = Enum.Material.SmoothPlastic, Parent = folder })
	p:SetAttribute("Station", station)
	-- Two posts from the ground up to the board
	local postHeight = cframe.Position.Y - size.Y / 2 + 0.5
	for _, x in ipairs({ -size.X / 2 + 1, size.X / 2 - 1 }) do
		local at = (cframe * CFrame.new(x, 0, 0)).Position
		part({ Name = "BoardPost", Size = Vector3.new(0.8, postHeight, 0.8), Position = Vector3.new(at.X, postHeight / 2, at.Z), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal, Parent = folder })
	end
	return p
end

-- A pad in the lobby that queues players for one arena spot
local function queuePad(folder, slot, position, size, name, color)
	local pad = disc(folder, "QueuePad" .. slot, position + Vector3.new(0, 0.4, 0), 7, 0.4, color, Enum.Material.Neon)
	pad.CanCollide = false
	pad:SetAttribute("QueuePad", slot)
	pad:SetAttribute("PadSize", size)
	pad:SetAttribute("PadName", name)
	disc(folder, "PadRim" .. slot, position + Vector3.new(0, 0.3, 0), 8, 0.3, Color3.fromRGB(40, 45, 60), Enum.Material.Metal)
	-- Glowing pillars of light at the edge
	for index = 0, 5 do
		local angle = index / 6 * math.pi * 2
		part({ Name = "PadLight", Size = Vector3.new(0.6, 6, 0.6), Position = position + Vector3.new(math.cos(angle) * 7.5, 3, math.sin(angle) * 7.5), Color = color, Material = Enum.Material.Neon, Transparency = 0.4, CanCollide = false, CanQuery = false, Parent = folder })
	end
	-- A sign above the pad. MatchService writes the status on it.
	local signPart = part({ Name = "PadSign" .. slot, Size = Vector3.new(14, 5, 0.6), Position = position + Vector3.new(0, 11, -9), Color = Color3.fromRGB(25, 30, 45), Parent = folder })
	signPart:SetAttribute("PadSign", slot)
	local label = sign(signPart, name, Enum.NormalId.Back, color, 30)
	label.Name = "Status"
	for _, x in ipairs({ -6.4, 6.4 }) do
		part({ Name = "SignPost", Size = Vector3.new(0.6, 9, 0.6), Position = position + Vector3.new(x, 4.5, -9), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal, Parent = folder })
	end
	return pad
end

-- The permanent parts of an arena spot: a marker for the middle of the floor,
-- the watching deck with its podium, and some clouds underneath.
local function arenaSpot(folder, slot, center, random)
	local marker = part({ Name = "ArenaCenter" .. slot, Size = Vector3.new(1, 1, 1), Position = center, Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = folder })
	marker:SetAttribute("ArenaCenter", slot)

	local deckCenter = center + Vector3.new(0, 16, 95)
	part({ Name = "Deck", Size = Vector3.new(36, 2, 20), Position = deckCenter - Vector3.new(0, 1, 0), Color = Color3.fromRGB(70, 80, 110), Material = Enum.Material.DiamondPlate, Parent = folder })
	local deckSpot = part({ Name = "DeckSpawn" .. slot, Size = Vector3.new(1, 1, 1), Position = deckCenter + Vector3.new(0, 3, 4), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = folder })
	deckSpot:SetAttribute("Deck", slot)
	-- Walls so nobody falls or jumps off the deck (the front one is glass)
	part({ Name = "DeckGlass", Size = Vector3.new(36, 10, 0.6), Position = deckCenter + Vector3.new(0, 5, -10), Color = Color3.fromRGB(180, 220, 255), Material = Enum.Material.Glass, Transparency = 0.75, Parent = folder })
	part({ Name = "DeckWall", Size = Vector3.new(36, 10, 0.6), Position = deckCenter + Vector3.new(0, 5, 10), Transparency = 1, Parent = folder })
	part({ Name = "DeckRail", Size = Vector3.new(36, 1, 0.6), Position = deckCenter + Vector3.new(0, 1, 10), Color = Color3.fromRGB(50, 55, 75), Material = Enum.Material.Metal, Parent = folder })
	for _, x in ipairs({ -18, 18 }) do
		part({ Name = "DeckWall", Size = Vector3.new(0.6, 10, 20), Position = deckCenter + Vector3.new(x, 5, 0), Transparency = 1, Parent = folder })
		part({ Name = "DeckRail", Size = Vector3.new(0.6, 1, 20), Position = deckCenter + Vector3.new(x, 1, 0), Color = Color3.fromRGB(50, 55, 75), Material = Enum.Material.Metal, Parent = folder })
	end
	part({ Name = "DeckRoof", Size = Vector3.new(36, 0.6, 20), Position = deckCenter + Vector3.new(0, 10.3, 0), Transparency = 1, Parent = folder })
	-- Podium: the winner dances on the top step
	part({ Name = "PodiumStep", Size = Vector3.new(6, 1, 5), Position = deckCenter + Vector3.new(-6, 0.5, -4), Color = Color3.fromRGB(200, 205, 215), Material = Enum.Material.SmoothPlastic, Parent = folder })
	part({ Name = "PodiumStep", Size = Vector3.new(6, 1, 5), Position = deckCenter + Vector3.new(6, 0.5, -4), Color = Color3.fromRGB(205, 127, 50), Material = Enum.Material.SmoothPlastic, Parent = folder })
	local podium = part({ Name = "Podium" .. slot, Size = Vector3.new(6, 2.5, 5), Position = deckCenter + Vector3.new(0, 1.25, -4), Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.SmoothPlastic, Parent = folder })
	podium:SetAttribute("Podium", slot)
	sign(podium, "1", Enum.NormalId.Back, Color3.fromRGB(120, 80, 0))

	for _ = 1, 5 do
		local angle = random:NextNumber(0, math.pi * 2)
		cloud(folder, center + Vector3.new(math.cos(angle) * random:NextNumber(20, 70), -random:NextNumber(30, 60), math.sin(angle) * random:NextNumber(20, 70)), random:NextNumber(12, 22), random)
	end
end

function MapBuilder.Build()
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.5
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 160)
	Lighting.GlobalShadows = true

	if Workspace:FindFirstChild("Map") then
		return -- the creator made their own map
	end

	local map = Instance.new("Folder")
	map.Name = "Map"
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = map
	local random = Random.new(7)

	-- The lobby island
	floatingIsland(scenery, "Lobby", Vector3.new(0, 0, 0), 75, Color3.fromRGB(110, 195, 95))
	local floor = scenery:FindFirstChild("LobbyTop")
	floor:SetAttribute("LobbyFloor", true)
	-- Low invisible walls round the edge so nobody walks off by accident
	for index = 0, 23 do
		local angle = index / 24 * math.pi * 2
		local at = Vector3.new(math.cos(angle) * 74, 4, math.sin(angle) * 74)
		part({ Name = "EdgeWall", Size = Vector3.new(1, 8, 20), CFrame = CFrame.lookAt(at, Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(90), 0), Transparency = 1, Parent = map })
		if index % 2 == 0 then
			part({ Name = "Fence", Size = Vector3.new(0.6, 2.5, 19.5), CFrame = CFrame.lookAt(Vector3.new(at.X, 1.25, at.Z), Vector3.new(0, 1.25, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(240, 240, 230), Material = Enum.Material.WoodPlanks, Parent = scenery })
		end
	end

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "LobbySpawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.lookAt(Vector3.new(0, 0.5, 45), Vector3.new(0, 0.5, 0))
	spawnLocation.Material = Enum.Material.SmoothPlastic
	spawnLocation.Color = Color3.fromRGB(255, 200, 60)
	spawnLocation.Duration = 0
	spawnLocation.Parent = map

	-- Paths
	part({ Name = "Path", Size = Vector3.new(8, 0.2, 70), Position = Vector3.new(0, 0.1, 10), Material = Enum.Material.Pebble, Color = Color3.fromRGB(215, 205, 175), CanCollide = false, Parent = scenery })
	part({ Name = "Path", Size = Vector3.new(90, 0.2, 8), Position = Vector3.new(0, 0.1, -22), Material = Enum.Material.Pebble, Color = Color3.fromRGB(215, 205, 175), CanCollide = false, Parent = scenery })

	-- The three queue pads, one per arena spot. Arena spots float out past the
	-- pads, so you can see them from the lobby.
	local spots = {
		{ name = "DUEL  1 v 1", size = 2, color = Color3.fromRGB(80, 170, 255), pad = Vector3.new(-32, 0, -32), arena = Vector3.new(-280, 90, -340) },
		{ name = "BRAWL  up to 4", size = 4, color = Color3.fromRGB(255, 150, 50), pad = Vector3.new(0, 0, -38), arena = Vector3.new(0, 90, -380) },
		{ name = "BRAWL  up to 4", size = 4, color = Color3.fromRGB(255, 90, 180), pad = Vector3.new(32, 0, -32), arena = Vector3.new(280, 90, -340) },
	}
	for slot, spot in ipairs(spots) do
		queuePad(map, slot, spot.pad, spot.size, spot.name, spot.color)
		arenaSpot(map, slot, spot.arena, random)
	end
	local padsTarget = part({ Name = "PadsTarget", Size = Vector3.new(2, 1, 2), Position = Vector3.new(0, 1, -30), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = map })
	padsTarget:SetAttribute("GuideTarget", "Pads")

	-- Practice ring with dummies to try bonking on
	local practiceCenter = Vector3.new(46, 0, 22)
	disc(scenery, "PracticeFloor", practiceCenter + Vector3.new(0, 0.2, 0), 15, 0.2, Color3.fromRGB(230, 200, 140), Enum.Material.Sand).CanCollide = false
	for index = 0, 15 do
		local angle = index / 16 * math.pi * 2
		local at = practiceCenter + Vector3.new(math.cos(angle) * 15, 2, math.sin(angle) * 15)
		local isGap = index == 8 -- the way in, facing the spawn side
		if not isGap then
			part({ Name = "PracticeRope", Size = Vector3.new(0.5, 4, 6.2), CFrame = CFrame.lookAt(at, practiceCenter + Vector3.new(0, 2, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(230, 70, 70), Material = Enum.Material.Fabric, Parent = map })
		end
	end
	local practiceSign = part({ Name = "PracticeSign", Size = Vector3.new(14, 3, 0.5), Position = practiceCenter + Vector3.new(0, 7, 15.5), Color = Color3.fromRGB(30, 40, 60), Parent = scenery })
	sign(practiceSign, "PRACTICE RING", Enum.NormalId.Front, Color3.fromRGB(255, 220, 120))
	sign(practiceSign, "PRACTICE RING", Enum.NormalId.Back, Color3.fromRGB(255, 220, 120))
	local practiceTarget = part({ Name = "PracticeTarget", Size = Vector3.new(2, 1, 2), Position = practiceCenter + Vector3.new(0, 1, 0), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = map })
	practiceTarget:SetAttribute("GuideTarget", "Practice")
	for _, offset in ipairs({ Vector3.new(-6, 0, -4), Vector3.new(6, 0, -4), Vector3.new(0, 0, 6) }) do
		local spot = part({ Name = "DummySpot", Size = Vector3.new(1, 1, 1), Position = practiceCenter + offset + Vector3.new(0, 3, 0), Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = map })
		spot:SetAttribute("Dummy", true)
	end

	-- Leaderboards and the how-to-play board
	board(map, "WinsBoard", CFrame.new(-56, 11, 6) * CFrame.Angles(0, math.rad(-90), 0), Vector3.new(22, 16, 1), "WinsBoard")
	board(map, "KosBoard", CFrame.new(-50, 11, 34) * CFrame.Angles(0, math.rad(-120), 0), Vector3.new(22, 16, 1), "KosBoard")
	local howTo = board(map, "HowToBoard", CFrame.new(-22, 8, 52) * CFrame.Angles(0, math.rad(-160), 0), Vector3.new(18, 11, 1), "HowTo")
	local howToText = "HOW TO PLAY\n\nBonk: click / BONK button\nDash: Q / DASH button\n\nKnock rivals off the arena!\nThe higher their %, the farther they fly.\nWin 2 rounds to win the match."
	sign(howTo, howToText, Enum.NormalId.Front, Color3.fromRGB(255, 240, 200), 30)
	sign(howTo, howToText, Enum.NormalId.Back, Color3.fromRGB(255, 240, 200), 30)

	local title = part({ Name = "TitleSign", Size = Vector3.new(40, 9, 1), Position = Vector3.new(0, 26, -62), Color = Color3.fromRGB(255, 120, 60), Material = Enum.Material.SmoothPlastic, Parent = scenery })
	sign(title, "BONK ARENA", Enum.NormalId.Back, Color3.new(1, 1, 1))
	sign(title, "BONK ARENA", Enum.NormalId.Front, Color3.new(1, 1, 1))
	for _, x in ipairs({ -18, 18 }) do
		part({ Name = "TitlePost", Size = Vector3.new(1.2, 22, 1.2), Position = Vector3.new(x, 11, -62), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal, Parent = scenery })
	end

	for _, at in ipairs({ Vector3.new(-12, 0, 30), Vector3.new(12, 0, 30), Vector3.new(-12, 0, -10), Vector3.new(12, 0, -10), Vector3.new(-48, 0, -10), Vector3.new(48, 0, -10) }) do
		lamp(scenery, at)
	end
	for _ = 1, 16 do
		local angle = random:NextNumber(0, math.pi * 2)
		local distance = random:NextNumber(55, 68)
		local at = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local nearPads = at.Z < -15 and math.abs(at.X) < 50
		local nearPractice = (at - practiceCenter).Magnitude < 22
		local nearBoards = at.X < -35 and at.Z > -5 and at.Z < 45
		if not nearPads and not nearPractice and not nearBoards then
			tree(scenery, at, random)
		end
	end
	for _ = 1, 10 do
		local angle = random:NextNumber(0, math.pi * 2)
		cloud(scenery, Vector3.new(math.cos(angle) * random:NextNumber(110, 220), random:NextNumber(-60, -20), math.sin(angle) * random:NextNumber(110, 220)), random:NextNumber(14, 26), random)
	end

	map.Parent = Workspace
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[-- Queue pads, matches and rounds.
--
-- Stand on a pad in the lobby to queue for that pad's arena spot. The match
-- starts when the pad is full, or after Config.QueueSeconds with bots filling
-- the empty spots. A match is best of 3 rounds, each on a freshly built arena.
-- If someone steps on the pad while a match with bots is running, a bot steps
-- aside for them at the start of the next round.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Arenas = require(Shared.Arenas)
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local CombatService = require(script.Parent.CombatService)
local CosmeticService = require(script.Parent.CosmeticService)
local ArenaService = require(script.Parent.ArenaService)
local BotService = require(script.Parent.BotService)
local PowerUpService = require(script.Parent.PowerUpService)
local ProgressService = require(script.Parent.ProgressService)
local TutorialService = require(script.Parent.TutorialService)

local MatchService = {}

local slots = {} -- [slot number] = slot
local arenaFolder
local random = Random.new()
local dirty = true -- something changed that players' screens should show

local function now()
	return os.clock()
end

local function serverTime()
	return Workspace:GetServerTimeNow()
end

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

------------------------------------------------------------------ Finding things
local function findAttribute(name)
	local found = {}
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute(name) ~= nil then
			found[item:GetAttribute(name)] = item
		end
	end
	return found
end

local function lobbySpawn()
	local spawnLocation = Workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	local base = spawnLocation and spawnLocation.CFrame or CFrame.new(0, 3, 40)
	return base * CFrame.new(random:NextNumber(-4, 4), 3.5, random:NextNumber(-4, 4))
end
MatchService.LobbySpawn = lobbySpawn

------------------------------------------------------------------ Matches
local Match = {}
Match.__index = Match

-- The entity (combat body) of a participant right now
function Match:Entity(participant)
	if participant.player then
		local entity = CombatService.GetByPlayer(participant.player)
		if entity and entity == participant.entity then
			return entity
		end
		return nil
	end
	return participant.entity
end

-- Entities still in the round (what bonks and hazards can hit)
function Match:Targets()
	local list = {}
	if self.state ~= "fight" and self.state ~= "countdown" then
		return list
	end
	for _, participant in ipairs(self.participants) do
		if participant.alive then
			local entity = self:Entity(participant)
			if entity then
				table.insert(list, entity)
			end
		end
	end
	return list
end

function Match:Bots()
	local list = {}
	if self.state ~= "fight" then
		return list
	end
	for _, participant in ipairs(self.participants) do
		if participant.alive and participant.bot then
			table.insert(list, participant.entity)
		end
	end
	return list
end

function Match:PowerUpPositions()
	return PowerUpService.Positions(self)
end

function Match:ParticipantOf(entity)
	for _, participant in ipairs(self.participants) do
		if participant.entity == entity then
			return participant
		end
	end
	return nil
end

function Match:CountPowerUp(entity)
	local participant = self:ParticipantOf(entity)
	if participant then
		participant.powerups += 1
	end
end

function Match:RealPlayers()
	local list = {}
	for _, participant in ipairs(self.participants) do
		if participant.player and participant.player.Parent then
			table.insert(list, participant)
		end
	end
	return list
end

-- A message to everyone in this match (and those watching from its deck)
function Match:Announce(text, kind, seconds)
	for _, participant in ipairs(self:RealPlayers()) do
		Remotes.Announce:FireClient(participant.player, text, kind or "small", seconds)
	end
end

local function newParticipant(player, botEntity)
	return {
		key = player and ("p" .. player.UserId) or botEntity.key,
		player = player,
		bot = botEntity ~= nil,
		entity = botEntity,
		name = player and player.DisplayName or botEntity.name,
		wins = 0,
		alive = false,
		kos = 0,
		botKos = 0,
		bonks = 0,
		powerups = 0,
		roundWins = {}, -- [arenaId] = rounds won there
		lastSafe = nil,
		eliminatedAt = 0,
	}
end

local function participantOfPlayer(player)
	for _, slot in pairs(slots) do
		local match = slot.match
		if match then
			for _, participant in ipairs(match.participants) do
				if participant.player == player then
					return participant, match
				end
			end
		end
	end
	return nil
end
MatchService.ParticipantOfPlayer = participantOfPlayer

-- Puts an entity on its match's deck to watch
local function toDeck(match, entity)
	if not entity or not entity.root or not entity.root.Parent then
		return
	end
	entity.space = nil
	CombatService.Reset(entity) -- no giant hammer or shield on the deck
	entity.model:SetAttribute("ShowDamage", false)
	CombatService.Freeze(entity, false)
	local spot = match.slot.deck * CFrame.new(random:NextNumber(-12, 12), 0, random:NextNumber(-3, 4))
	if entity.player then
		entity.model:PivotTo(spot)
		entity.root.AssemblyLinearVelocity = Vector3.zero
	else
		BotService.Place(entity, spot)
	end
end

local function chooseArena(match)
	local pick = ReplicatedStorage:GetAttribute("ArenaPick")
	if pick and Arenas.ById[pick] then
		return pick
	end
	local choices = {}
	for _, arena in ipairs(Arenas.List) do
		if not match.usedArenas[arena.id] and arena.id ~= match.slot.lastArena then
			table.insert(choices, arena.id)
		end
	end
	if #choices == 0 then
		match.usedArenas = {}
		for _, arena in ipairs(Arenas.List) do
			if arena.id ~= match.slot.lastArena then
				table.insert(choices, arena.id)
			end
		end
	end
	local id = choices[random:NextInteger(1, #choices)]
	match.usedArenas[id] = true
	match.slot.lastArena = id
	return id
end

local function eliminate(match, participant, entity)
	if not participant.alive then
		return
	end
	participant.alive = false
	participant.eliminatedAt = now()
	dirty = true
	local position = participant.lastSafe or (entity and entity.root and entity.root.Position) or match.slot.center
	local knocker = nil
	if entity and entity.lastHit and now() - entity.lastHit.time <= Config.KoCreditSeconds and entity.lastHit.by ~= entity then
		knocker = match:ParticipantOf(entity.lastHit.by)
	end
	if knocker then
		if participant.bot then
			knocker.botKos += 1
		else
			knocker.kos += 1
		end
		local effect = "ko_poof"
		if knocker.player then
			local item = CosmeticService.Equipped(knocker.player, "ko")
			effect = item and item.id or effect
		end
		CombatService.Effect("ko", position, { effect = effect })
		match:Announce(string.format("%s knocked out %s!", knocker.name, participant.name), "ko")
	else
		CombatService.Effect("ko", position, { effect = "ko_poof" })
		match:Announce(participant.name .. " fell off!", "ko")
	end
	if entity then
		task.delay(0.3, toDeck, match, entity)
	end
end

local function placeForRound(match)
	local arena = match.arena
	local order = table.clone(match.participants)
	for index = #order, 2, -1 do
		local other = random:NextInteger(1, index)
		order[index], order[other] = order[other], order[index]
	end
	for index, participant in ipairs(order) do
		local entity
		if participant.player then
			entity = CombatService.GetByPlayer(participant.player)
			participant.entity = entity
		else
			entity = participant.entity
		end
		if entity and CombatService.IsAlive(entity) then
			local spawnCFrame = arena.spawns[((index - 1) % #arena.spawns) + 1]
			CombatService.Reset(entity)
			entity.space = match
			entity.model:SetAttribute("ShowDamage", true)
			if participant.player then
				entity.model:PivotTo(spawnCFrame)
				entity.root.AssemblyLinearVelocity = Vector3.zero
			else
				BotService.Place(entity, spawnCFrame)
			end
			CombatService.Freeze(entity, true)
			participant.alive = true
			participant.lastSafe = spawnCFrame.Position
		else
			participant.alive = false
		end
	end
end

-- Real players who stepped on the pad take over from bots between rounds
local function swapInJoiners(match)
	local slot = match.slot
	for player in pairs(slot.joining) do
		if player.Parent and DataService.IsLoaded(player) and not participantOfPlayer(player) then
			local botParticipant, botIndex = nil, nil
			for index, participant in ipairs(match.participants) do
				if participant.bot then
					botParticipant, botIndex = participant, index
					break
				end
			end
			if not botParticipant then
				break
			end
			local newcomer = newParticipant(player, nil)
			match.participants[botIndex] = newcomer
			match:Announce(string.format("%s made room for %s!", botParticipant.name, newcomer.name), "info")
			Remotes.Announce:FireClient(player, "You're in! You replace " .. botParticipant.name .. ".", "info")
			BotService.Remove(botParticipant.entity)
			player:SetAttribute("QueuePad", nil)
			player:SetAttribute("InMatch", slot.index)
			TutorialService.Event(player, "Queue")
		end
	end
	slot.joining = {}
end

local function giveRewards(match, winner)
	local opponentsAllBots = true
	for _, participant in ipairs(match.participants) do
		if participant ~= winner and not participant.bot then
			opponentsAllBots = false
		end
	end
	for _, participant in ipairs(match:RealPlayers()) do
		local won = participant == winner
		local coins = Config.CoinRewards.play
			+ participant.wins * Config.CoinRewards.roundWin
			+ participant.kos * Config.CoinRewards.ko
			+ math.floor(participant.botKos * Config.CoinRewards.ko * Config.BotKoShare)
		local xp = Config.XpRewards.play
			+ participant.wins * Config.XpRewards.roundWin
			+ participant.kos * Config.XpRewards.ko
			+ math.floor(participant.botKos * Config.XpRewards.ko * Config.BotKoShare)
		if won then
			local share = opponentsAllBots and Config.BotOnlyWinShare or 1
			coins += math.floor(Config.CoinRewards.matchWin * share)
			xp += math.floor(Config.XpRewards.matchWin * share)
		end
		local stats = {
			matches = 1,
			wins = won and 1 or 0,
			rounds = participant.wins,
			kos = participant.kos + participant.botKos,
			bonks = participant.bonks,
			powerups = participant.powerups,
		}
		for arenaId, count in pairs(participant.roundWins) do
			stats["round_" .. arenaId] = count
		end
		ProgressService.AddMatchResult(participant.player, { coins = coins, xp = xp, stats = stats, won = won })
		TutorialService.Event(participant.player, "Match")
	end
end

local function endMatch(match)
	local slot = match.slot
	match.state = "over"
	if match.arena then
		match.arena:Destroy()
		match.arena = nil
	end
	PowerUpService.EndRound(match)
	for _, participant in ipairs(match.participants) do
		if participant.bot then
			BotService.Remove(participant.entity)
		elseif participant.player and participant.player.Parent then
			local entity = CombatService.GetByPlayer(participant.player)
			if entity then
				entity.space = nil
				CombatService.Reset(entity)
				entity.model:SetAttribute("ShowDamage", false)
				if entity.root and entity.root.Anchored then
					entity.root.Anchored = false
				end
				entity.model:PivotTo(lobbySpawn())
				entity.root.AssemblyLinearVelocity = Vector3.zero
			end
			participant.player:SetAttribute("InMatch", nil)
		end
	end
	slot.match = nil
	slot.joining = {}
	dirty = true
end

local function runRound(match)
	local slot = match.slot
	match.round += 1
	local arenaId = chooseArena(match)
	if match.arena then
		match.arena:Destroy()
	end
	local arena = ArenaService.Build(arenaId, slot.center, arenaFolder)
	match.arena = arena
	match.arenaId = arenaId
	arena.say = function(text)
		match:Announce(text, "info")
	end
	arena.entities = function()
		return match:Targets()
	end

	match.state = "countdown"
	match.suddenDeath = false
	match.endsAt = serverTime() + Config.CountdownSeconds
	placeForRound(match)
	dirty = true
	match:Announce(string.format("Round %d: %s", match.round, Arenas.ById[arenaId].name), "round", Config.CountdownSeconds)
	task.wait(Config.CountdownSeconds)

	match.state = "fight"
	for _, entity in ipairs(match:Targets()) do
		CombatService.Freeze(entity, false)
	end
	match:Announce("BONK!", "big", 1)
	arena:Start()
	PowerUpService.StartRound(match)
	local fightStarted = now()
	match.endsAt = serverTime() + Config.RoundSeconds
	dirty = true

	local winner = nil
	local lastThink = 0
	while true do
		task.wait(0.1)
		if #match:RealPlayers() == 0 then
			return nil, true -- everyone left
		end
		-- Who is out?
		local aliveList = {}
		for _, participant in ipairs(match.participants) do
			if participant.alive then
				local entity = match:Entity(participant)
				local out = entity == nil or not CombatService.IsAlive(entity)
				if not out then
					local position = entity.root.Position
					local fromCenter = flat(position - slot.center).Magnitude
					out = position.Y < arena.floorY - Config.OutBelow or fromCenter > arena.radius + Config.OutBeyond or arena:IsOut(position)
					if not out and position.Y > arena.floorY - 2 and fromCenter < arena.radius then
						participant.lastSafe = position
					end
				end
				if out then
					eliminate(match, participant, entity)
				else
					table.insert(aliveList, participant)
				end
			end
		end
		if #aliveList <= 1 then
			winner = aliveList[1]
			break
		end
		if now() - lastThink >= 0.15 then
			lastThink = now()
			BotService.Think(match)
		end
		local elapsed = now() - fightStarted
		if not match.suddenDeath and elapsed >= Config.RoundSeconds then
			match.suddenDeath = true
			match.endsAt = serverTime() + Config.SuddenDeathSeconds
			for _, participant in ipairs(aliveList) do
				local entity = match:Entity(participant)
				if entity then
					CombatService.SetDamage(entity, math.max(entity.damage, Config.SuddenDeathDamage))
				end
			end
			arena:SuddenDeath()
			match:Announce("SUDDEN DEATH! Everyone is at " .. Config.SuddenDeathDamage .. "%", "big", 2)
			dirty = true
		elseif match.suddenDeath and elapsed >= Config.RoundSeconds + Config.SuddenDeathSeconds then
			-- Time's up: whoever has the least damage wins
			local best = math.huge
			for _, participant in ipairs(aliveList) do
				local entity = match:Entity(participant)
				local damage = entity and entity.damage or math.huge
				if damage < best then
					best = damage
					winner = participant
				end
			end
			break
		end
	end

	if not winner then
		-- Everyone went out at once: the last one to fall wins
		local latest = -1
		for _, participant in ipairs(match.participants) do
			if participant.eliminatedAt > latest then
				latest = participant.eliminatedAt
				winner = participant
			end
		end
	end
	match.state = "roundEnd"
	PowerUpService.EndRound(match)
	for _, participant in ipairs(match.participants) do
		local entity = match:Entity(participant)
		if entity and participant.alive then
			CombatService.Freeze(entity, true)
		end
	end
	if winner then
		winner.wins += 1
		winner.roundWins[arenaId] = (winner.roundWins[arenaId] or 0) + 1
		match:Announce(string.format("%s wins round %d!", winner.name, match.round), "big", Config.BetweenRoundsSeconds - 0.5)
	end
	dirty = true
	return winner, false
end

local function runVictory(match, winner)
	local slot = match.slot
	match.state = "victory"
	match.winner = winner
	match.endsAt = serverTime() + Config.VictorySeconds
	dirty = true
	if match.arena then
		match.arena:Destroy()
		match.arena = nil
	end
	for _, participant in ipairs(match.participants) do
		local entity = match:Entity(participant)
		if entity and participant ~= winner then
			toDeck(match, entity)
		end
	end
	local winnerEntity = winner and match:Entity(winner)
	if winnerEntity and winnerEntity.root and winnerEntity.root.Parent then
		winnerEntity.space = nil
		CombatService.Freeze(winnerEntity, false)
		winnerEntity.model:SetAttribute("ShowDamage", false)
		local stand = slot.podium * CFrame.new(0, 3, 0)
		winnerEntity.model:PivotTo(stand)
		local dance = Cosmetics.Defaults.dance
		if winner.player then
			local item = CosmeticService.Equipped(winner.player, "dance")
			dance = item and item.id or dance
		end
		CosmeticService.Dance(winnerEntity.model, dance, stand, Config.VictorySeconds - 1)
	end
	match:Announce(string.format("%s WINS THE MATCH!", winner and winner.name or "Nobody"), "victory", Config.VictorySeconds - 1)
	giveRewards(match, winner)
	task.wait(Config.VictorySeconds)
end

local function runMatch(match)
	while match.state ~= "over" do
		if match.round > 0 then
			swapInJoiners(match)
		end
		local winner, abandoned = runRound(match)
		if abandoned then
			break
		end
		if winner and winner.wins >= Config.RoundsToWin then
			runVictory(match, winner)
			break
		end
		task.wait(Config.BetweenRoundsSeconds)
	end
	endMatch(match)
end

local function startMatch(slot, players)
	local match = setmetatable({
		slot = slot,
		participants = {},
		round = 0,
		state = "starting",
		usedArenas = {},
		endsAt = 0,
	}, Match)
	for _, player in ipairs(players) do
		table.insert(match.participants, newParticipant(player, nil))
		player:SetAttribute("QueuePad", nil)
		player:SetAttribute("InMatch", slot.index)
		TutorialService.Event(player, "Queue")
	end
	local deck = slot.deck
	while #match.participants < slot.size do
		local bot = BotService.Create(deck * CFrame.new(random:NextNumber(-10, 10), 0, 0))
		if not bot then
			break
		end
		table.insert(match.participants, newParticipant(nil, bot))
	end
	slot.match = match
	slot.queue = {}
	slot.countdownEnds = nil
	dirty = true
	task.spawn(function()
		local ok, err = pcall(runMatch, match)
		if not ok then
			warn("[MatchService] Match error: " .. tostring(err))
			pcall(endMatch, match)
		end
	end)
	return match
end

------------------------------------------------------------------ Queue pads
local function onPad(slot, player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local pad = slot.pad
	local offset = root.Position - pad.Position
	return flat(offset).Magnitude <= 7.5 and offset.Y > -1 and offset.Y < 8
end

local function updatePads()
	local t = now()
	for _, slot in pairs(slots) do
		local standing = {}
		for _, player in ipairs(Players:GetPlayers()) do
			if DataService.IsLoaded(player) and not participantOfPlayer(player) and onPad(slot, player) then
				table.insert(standing, player)
			end
		end
		-- Keep the order people arrived in
		local stillThere = {}
		for _, player in ipairs(slot.queue) do
			if table.find(standing, player) then
				table.insert(stillThere, player)
			end
		end
		for _, player in ipairs(standing) do
			if not table.find(stillThere, player) then
				table.insert(stillThere, player)
				TutorialService.Event(player, "Queue")
			end
		end
		slot.queue = stillThere

		local status
		local match = slot.match
		if match then
			slot.joining = {}
			local bots = 0
			for _, participant in ipairs(match.participants) do
				if participant.bot then
					bots += 1
				end
			end
			for index, player in ipairs(slot.queue) do
				if index <= bots then
					slot.joining[player] = true
				end
			end
			if bots > 0 and #slot.queue > 0 then
				status = string.format("Match on: you'll take a bot's place next round")
			elseif bots > 0 then
				status = string.format("Round %d on: step here to replace a bot", math.max(1, match.round))
			else
				status = string.format("Round %d on: next match after this one", math.max(1, match.round))
			end
		else
			local queued = math.min(#slot.queue, slot.size)
			if queued == 0 then
				slot.countdownEnds = nil
				status = "Step here to play!"
			else
				if not slot.countdownEnds then
					slot.countdownEnds = t + Config.QueueSeconds
				end
				if queued >= slot.size then
					slot.countdownEnds = math.min(slot.countdownEnds, t + Config.QueueFullSeconds)
				end
				local left = math.max(0, math.ceil(slot.countdownEnds - t))
				status = string.format("%d/%d ready. Starting in %ds%s", queued, slot.size, left, queued < slot.size and " (bots fill in)" or "")
				if t >= slot.countdownEnds then
					local players = {}
					for index = 1, queued do
						table.insert(players, slot.queue[index])
					end
					startMatch(slot, players)
				end
			end
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local queuedHere = table.find(slot.queue, player) ~= nil and not participantOfPlayer(player)
			if queuedHere then
				player:SetAttribute("QueuePad", slot.index)
			elseif player:GetAttribute("QueuePad") == slot.index then
				player:SetAttribute("QueuePad", nil)
			end
		end
		if slot.status ~= status then
			slot.status = status
			ReplicatedStorage:SetAttribute("PadStatus" .. slot.index, status)
			if slot.signLabel then
				slot.signLabel.Text = slot.name .. "\n" .. status
			end
		end
	end
end

------------------------------------------------------------------ What players see
local function summaries()
	local list = {}
	for _, slot in pairs(slots) do
		local match = slot.match
		if match and match.state ~= "starting" then
			local players = {}
			for _, participant in ipairs(match.participants) do
				local entity = match:Entity(participant) or participant.entity
				table.insert(players, {
					key = participant.key,
					name = participant.name,
					userId = participant.player and participant.player.UserId or 0,
					bot = participant.bot,
					alive = participant.alive,
					wins = participant.wins,
					damage = entity and math.floor(entity.damage) or 0,
					model = entity and entity.model or nil,
				})
			end
			table.insert(list, {
				slot = slot.index,
				pad = slot.name,
				arena = match.arenaId,
				round = match.round,
				state = match.state,
				endsAt = match.endsAt,
				suddenDeath = match.suddenDeath,
				winner = match.winner and match.winner.name or nil,
				roundsToWin = Config.RoundsToWin,
				players = players,
			})
		end
	end
	return list
end

-- Studio test helper: starts a match on a pad right away (the player plus bots)
function MatchService.TestStart(slotIndex, player)
	local slot = slots[slotIndex or 2]
	if slot and not slot.match and player then
		return startMatch(slot, { player })
	end
end

function MatchService.Start()
	arenaFolder = Instance.new("Folder")
	arenaFolder.Name = "Arenas"
	arenaFolder.Parent = Workspace

	local pads = findAttribute("QueuePad")
	local centers = findAttribute("ArenaCenter")
	local decks = findAttribute("Deck")
	local podiums = findAttribute("Podium")
	local signs = findAttribute("PadSign")
	for index, pad in pairs(pads) do
		local center = centers[index]
		local deck = decks[index]
		if center and deck then
			local podium = podiums[index]
			local signPart = signs[index]
			local label = nil
			if signPart then
				local gui = signPart:FindFirstChildWhichIsA("SurfaceGui")
				label = gui and gui:FindFirstChild("Status")
			end
			slots[index] = {
				index = index,
				pad = pad,
				size = pad:GetAttribute("PadSize") or 4,
				name = pad:GetAttribute("PadName") or ("Arena " .. index),
				center = center.Position,
				deck = CFrame.lookAt(deck.Position, center.Position * Vector3.new(1, 0, 1) + Vector3.new(0, deck.Position.Y, 0)),
				podium = podium and CFrame.lookAt(podium.Position + Vector3.new(0, podium.Size.Y / 2, 0), deck.Position + Vector3.new(0, podium.Size.Y / 2, 30)) or deck.CFrame,
				signLabel = label,
				queue = {},
				joining = {},
				countdownEnds = nil,
				match = nil,
			}
		end
	end

	CombatService.OnHit(function(attacker)
		local space = attacker.space
		if space and space.ParticipantOf then
			local participant = space:ParticipantOf(attacker)
			if participant then
				participant.bonks += 1
			end
		end
	end)

	-- Players who reset or respawn during a match go to the deck to watch
	local function watch(player)
		player.CharacterAdded:Connect(function(character)
			local _, match = participantOfPlayer(player)
			if match and (match.state == "fight" or match.state == "countdown" or match.state == "roundEnd" or match.state == "victory") then
				task.wait(0.2)
				local entity = CombatService.Get(character)
				if entity then
					toDeck(match, entity)
				end
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local participant = participantOfPlayer(player)
		if participant then
			participant.alive = false
			dirty = true
		end
		for _, slot in pairs(slots) do
			slot.joining[player] = nil
			local index = table.find(slot.queue, player)
			if index then
				table.remove(slot.queue, index)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(updatePads)
			if not ok then
				warn("[MatchService] " .. tostring(err))
			end
		end
	end)

	-- Send everyone the state of every match: right away when something changes,
	-- and four times a second while a round is on (for the damage numbers)
	task.spawn(function()
		local lastSent = 0
		while true do
			task.wait(0.1)
			local anyFight = false
			for _, slot in pairs(slots) do
				if slot.match and slot.match.state == "fight" then
					anyFight = true
				end
			end
			if dirty or (anyFight and now() - lastSent >= 0.25) then
				dirty = false
				lastSent = now()
				Remotes.Matches:FireAllClients(summaries())
			end
		end
	end)
end

return MatchService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">PowerUpService</string><ProtectedString name="Source"><![CDATA[-- Power-ups that drop onto the arena during a round. Anyone can grab one by
-- running into it. They are never sold.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)

local CombatService = require(script.Parent.CombatService)
local CosmeticService = require(script.Parent.CosmeticService)

local PowerUpService = {}

local rounds = {} -- [match] = { items = {}, bananas = {} }
local random = Random.new()

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function weldTo(root, p, offset)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CFrame = root.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = p
	weld.C0 = offset
	weld.Parent = p
end

local function tell(entity, text)
	if entity.player then
		Remotes.Announce:FireClient(entity.player, text, "power", 2.5)
	end
end

------------------------------------------------------------------ Effects of each power-up
local GIVE = {}

GIVE.giant = function(entity)
	entity.giantUntil = os.clock() + Config.PowerUpSeconds
	entity.model:SetAttribute("GiantHammer", true)
	if entity.player then
		CosmeticService.RefreshHammer(entity.player, 1.8)
	else
		CosmeticService.BuildHammer(entity.model, entity.hammerItem, 1.8)
	end
end

GIVE.shield = function(entity)
	entity.shield = PowerUps.ShieldHits
	local old = entity.model:FindFirstChild("BonkShield")
	if old then
		old:Destroy()
	end
	local bubble = Instance.new("Part")
	bubble.Name = "BonkShield"
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.one * 7
	bubble.Material = Enum.Material.ForceField
	bubble.Color = Color3.fromRGB(90, 200, 255)
	weldTo(entity.root, bubble, CFrame.new())
	bubble.Parent = entity.model
end

GIVE.speed = function(entity)
	entity.speedUntil = os.clock() + Config.PowerUpSeconds
	entity.speedEnds = true
	CombatService.UpdateMovement(entity)
end

GIVE.iron = function(entity)
	entity.ironUntil = os.clock() + Config.PowerUpSeconds
	local old = entity.model:FindFirstChild("IronBoots")
	if old then
		old:Destroy()
	end
	local boots = Instance.new("Model")
	boots.Name = "IronBoots"
	for _, footName in ipairs({ "LeftFoot", "RightFoot", "Left Leg", "Right Leg" }) do
		local foot = entity.model:FindFirstChild(footName)
		if foot then
			local boot = Instance.new("Part")
			boot.Name = "Boot"
			boot.Size = Vector3.new(1.3, 0.8, 1.6)
			boot.Color = Color3.fromRGB(110, 110, 125)
			boot.Material = Enum.Material.DiamondPlate
			local offset = CFrame.new(0, -foot.Size.Y / 2 + 0.3, -0.1)
			boot.CFrame = foot.CFrame * offset
			boot.CanCollide = false
			boot.CanQuery = false
			boot.CanTouch = false
			boot.Massless = true
			local weld = Instance.new("Weld")
			weld.Part0 = foot
			weld.Part1 = boot
			weld.C0 = offset
			weld.Parent = boot
			boot.Parent = boots
		end
	end
	boots.Parent = entity.model
end

GIVE.magnet = function(entity, match)
	local origin = entity.root.Position
	for _, other in ipairs(match:Targets()) do
		if other ~= entity and other.root then
			local offset = flat(origin - other.root.Position)
			if offset.Magnitude < PowerUps.MagnetRange and offset.Magnitude > 3 then
				CombatService.Push(other, offset.Unit * math.min(50, offset.Magnitude * 2.2) + Vector3.yAxis * 18, 0.45, 0, entity)
			end
		end
	end
	entity.magnetUntil = os.clock() + PowerUps.MagnetBonkSeconds
	CombatService.Effect("shockwave", origin, { range = PowerUps.MagnetRange })
end

GIVE.banana = function(entity, match, state)
	local root = entity.root
	local look = flat(root.CFrame.LookVector)
	look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, -1)
	local spot = root.Position - look * 4
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { entity.model }
	local hit = Workspace:Raycast(spot + Vector3.new(0, 2, 0), Vector3.new(0, -12, 0), params)
	local floorY = hit and hit.Position.Y or (root.Position.Y - 3)
	local banana = Instance.new("Part")
	banana.Name = "Banana"
	banana.Size = Vector3.new(1.8, 0.5, 0.7)
	banana.Color = Color3.fromRGB(255, 225, 60)
	banana.Material = Enum.Material.SmoothPlastic
	banana.Anchored = true
	banana.CanCollide = false
	banana.CanQuery = false
	banana.CFrame = CFrame.new(spot.X, floorY + 0.25, spot.Z) * CFrame.Angles(0, random:NextNumber(0, math.pi), math.rad(10))
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = banana
	banana.Parent = match.arena and match.arena.folder or Workspace
	table.insert(state.bananas, { part = banana, owner = entity, placedAt = os.clock() })
end

------------------------------------------------------------------ Spawning and grabbing
local function spawnOne(match, state)
	local arena = match.arena
	if not arena then
		return
	end
	local powerUp = PowerUps.List[random:NextInteger(1, #PowerUps.List)]
	local position = arena:RandomFloorPoint()
	local orb = Instance.new("Part")
	orb.Name = "PowerUp"
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.one * 2.6
	orb.Color = powerUp.color
	orb.Material = Enum.Material.Neon
	orb.Anchored = true
	orb.CanCollide = false
	orb.CanQuery = false
	orb.Position = position
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(60, 60)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 160
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = powerUp.letter
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeColor3 = powerUp.color:Lerp(Color3.new(0, 0, 0), 0.5)
	label.TextStrokeTransparency = 0
	label.Parent = gui
	gui.Parent = orb
	local light = Instance.new("PointLight")
	light.Color = powerUp.color
	light.Range = 12
	light.Parent = orb
	orb.Parent = arena.folder
	TweenService:Create(orb, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = position + Vector3.new(0, 1, 0) }):Play()
	table.insert(state.items, { id = powerUp.id, part = orb, position = position })
end

local function grab(match, state, item, entity)
	local powerUp = PowerUps.ById[item.id]
	item.part:Destroy()
	CombatService.Effect("powerup", entity.root.Position, { id = item.id })
	tell(entity, powerUp.name .. "! " .. powerUp.description)
	GIVE[item.id](entity, match, state)
	match:CountPowerUp(entity)
end

local function tick(match, state)
	local targets = match:Targets()
	for index = #state.items, 1, -1 do
		local item = state.items[index]
		if not item.part.Parent then
			table.remove(state.items, index)
		else
			-- Power-ups on floor that fell away (or into lava) go with it
			local arena = match.arena
			if arena and (arena:IsOut(item.position) or flat(item.position - arena.center).Magnitude > arena:SafeRadius() + 8) then
				item.part:Destroy()
				table.remove(state.items, index)
			else
				for _, entity in ipairs(targets) do
					if not entity.frozen and (entity.root.Position - item.part.Position).Magnitude < 4.2 then
						table.remove(state.items, index)
						grab(match, state, item, entity)
						break
					end
				end
			end
		end
	end
	local t = os.clock()
	for index = #state.bananas, 1, -1 do
		local banana = state.bananas[index]
		if not banana.part.Parent or t - banana.placedAt > PowerUps.BananaSeconds then
			banana.part:Destroy()
			table.remove(state.bananas, index)
		else
			for _, entity in ipairs(targets) do
				local ownGrace = entity == banana.owner and t - banana.placedAt < 3
				if not ownGrace and (flat(entity.root.Position - banana.part.Position)).Magnitude < 2.6 and math.abs(entity.root.Position.Y - banana.part.Position.Y) < 4 then
					local slide = flat(entity.root.AssemblyLinearVelocity)
					if slide.Magnitude < 1 then
						slide = flat(entity.root.CFrame.LookVector)
					end
					CombatService.Push(entity, slide.Unit * 32 + Vector3.yAxis * 30, 1.2, 5, entity ~= banana.owner and banana.owner or nil)
					CombatService.Effect("slip", entity.root.Position)
					banana.part:Destroy()
					table.remove(state.bananas, index)
					break
				end
			end
		end
	end
end

function PowerUpService.StartRound(match)
	local state = { items = {}, bananas = {} }
	rounds[match] = state
	task.spawn(function()
		local started = os.clock()
		local nextSpawn = Config.PowerUpFirstSeconds
		while rounds[match] == state and match.state == "fight" do
			if os.clock() - started >= nextSpawn then
				nextSpawn += Config.PowerUpEverySeconds
				if #state.items < Config.PowerUpMaxOnField then
					spawnOne(match, state)
				end
			end
			local ok, err = pcall(tick, match, state)
			if not ok then
				warn("[PowerUpService] " .. tostring(err))
			end
			task.wait(0.1)
		end
	end)
end

function PowerUpService.EndRound(match)
	local state = rounds[match]
	rounds[match] = nil
	if state then
		for _, item in ipairs(state.items) do
			item.part:Destroy()
		end
		for _, banana in ipairs(state.bananas) do
			banana.part:Destroy()
		end
	end
end

function PowerUpService.Positions(match)
	local list = {}
	local state = rounds[match]
	if state then
		for _, item in ipairs(state.items) do
			table.insert(list, item.position)
		end
	end
	return list
end

return PowerUpService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">ProgressService</string><ProtectedString name="Source"><![CDATA[-- Coins, XP, levels, daily quests and the daily login reward, plus the menu
-- buttons players press (all go through the "Action" remote): buying cosmetics
-- with coins, equipping them, and picking the arena in a private server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Cosmetics)
local Arenas = require(Shared.Arenas)
local Quests = require(Shared.Quests)
local Level = require(Shared.Level)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local ProgressService = {}

local function notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind)
end

local function refreshQuests(player, data)
	local today = Quests.Today(os.time())
	if data.quests.day ~= today then
		data.quests.day = today
		data.quests.list = Quests.Generate(player.UserId, today)
	end
end

-- Adds XP and pays the coin reward for every level reached. Call inside DataService.Update.
local function addXp(player, data, amount)
	data.xp += amount
	local level = Level.FromXp(data.xp)
	local reached = {}
	while data.levelRewards < level do
		data.levelRewards += 1
		local reward = data.levelRewards * Level.CoinsPerLevel
		data.coins += reward
		data.totalEarned += reward
		table.insert(reached, { level = data.levelRewards, coins = reward })
	end
	for _, entry in ipairs(reached) do
		task.defer(notify, player, string.format("Level %d! +%s coins", entry.level, Format.Number(entry.coins)), "rare")
	end
end

-- Adds to the daily quests. Call inside DataService.Update.
local function addQuestProgress(player, data, stats)
	refreshQuests(player, data)
	for _, entry in ipairs(data.quests.list) do
		local quest = Quests.ById[entry.id]
		if quest and not entry.done then
			entry.progress = math.min(entry.goal, entry.progress + (stats[quest.stat] or 0))
			if entry.progress >= entry.goal then
				entry.done = true
				data.coins += quest.coins
				data.totalEarned += quest.coins
				addXp(player, data, math.floor(quest.coins * Quests.XpShare))
				task.defer(notify, player, string.format("Quest done: %s! +%d coins", Quests.Text(entry), quest.coins), "success")
			end
		end
	end
end

-- After a match: result = { coins, xp, stats = { matches, wins, rounds, kos, bonks, powerups, round_<arena> }, won }
function ProgressService.AddMatchResult(player, result)
	if not DataService.IsLoaded(player) then
		return
	end
	local coins = result.coins
	if ShopService.HasPass(player, "VIP") then
		coins = math.floor(coins * (1 + Config.VipCoinBonus))
	end
	DataService.Update(player, function(data)
		data.coins += coins
		data.totalEarned += coins
		for key, value in pairs(result.stats) do
			if data.stats[key] ~= nil then
				data.stats[key] += value
			end
		end
		local week = Quests.Week(os.time())
		if data.weekly.week ~= week then
			data.weekly.week = week
			data.weekly.wins = 0
		end
		data.weekly.wins += result.stats.wins or 0
		addXp(player, data, result.xp)
		addQuestProgress(player, data, result.stats)
	end)
	notify(player, string.format("%s +%s coins, +%d XP", result.won and "You won!" or "Good match!", Format.Number(coins), result.xp), "coins")
end

------------------------------------------------------------------ Actions
local function buyCosmetic(player, itemId)
	local item = Cosmetics.ById[itemId or ""]
	local data = DataService.Get(player)
	if not item or not data then
		return false, "Unknown item"
	end
	if item.source ~= "coins" then
		return false, "That one can't be bought with coins"
	end
	if data.cosmetics.owned[item.id] then
		return false, "You already have it"
	end
	if data.coins < item.price then
		return false, string.format("You need %s more coins", Format.Number(item.price - data.coins))
	end
	DataService.Update(player, function(saved)
		saved.coins -= item.price
		saved.cosmetics.owned[item.id] = true
		saved.cosmetics.equipped[item.kind] = item.id
	end)
	notify(player, "You got " .. item.name .. "! It's equipped.", "success")
	return true
end

local function equipCosmetic(player, itemId)
	local item = Cosmetics.ById[itemId or ""]
	local data = DataService.Get(player)
	if not item or not data then
		return false, "Unknown item"
	end
	if not Cosmetics.Owns(data, item, ShopService.HasPass(player, "VIP")) then
		return false, "You don't own that yet"
	end
	DataService.Update(player, function(saved)
		if saved.cosmetics.equipped[item.kind] == item.id and not Cosmetics.Defaults[item.kind] then
			saved.cosmetics.equipped[item.kind] = nil -- pressing again takes a title or trail off
		else
			saved.cosmetics.equipped[item.kind] = item.id
		end
	end)
	return true
end

-- In a private server, its owner picks which arena every round uses
local function pickArena(player, arenaId)
	local isOwner = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == player.UserId
	if not isOwner and not RunService:IsStudio() then
		return false, "Only the owner of a private server can pick the arena"
	end
	if arenaId == "random" then
		ReplicatedStorage:SetAttribute("ArenaPick", nil)
		notify(player, "Arenas are random again.", "info")
		return true
	end
	local arena = Arenas.ById[arenaId or ""]
	if not arena then
		return false, "Unknown arena"
	end
	ReplicatedStorage:SetAttribute("ArenaPick", arena.id)
	for _, other in ipairs(Players:GetPlayers()) do
		notify(other, "Every round is now on " .. arena.name .. ".", "info")
	end
	return true
end

local function giveDailyReward(player, data)
	local today = math.floor(os.time() / 86400)
	if data.lastDailyDay == today then
		return
	end
	if data.lastDailyDay == today - 1 then
		data.dailyStreak += 1
	else
		data.dailyStreak = 1
	end
	data.lastDailyDay = today
	local day = math.min(data.dailyStreak, Config.DailyStreakCap)
	local reward = Config.DailyRewardBase * day
	data.coins += reward
	data.totalEarned += reward
	task.spawn(function()
		if DataService.WaitFor(player) then
			notify(player, string.format("Daily reward (day %d streak): +%s coins! Come back tomorrow for more.", data.dailyStreak, Format.Number(reward)), "coins")
		end
	end)
end

local actions = {
	BuyCosmetic = buyCosmetic,
	EquipCosmetic = equipCosmetic,
	PickArena = pickArena,
}

-- Lets other services add actions (the guide's reset, for example)
function ProgressService.AddAction(name, handler)
	actions[name] = handler
end

function ProgressService.Start()
	DataService.OnLoaded(function(player, data)
		giveDailyReward(player, data)
		refreshQuests(player, data)
	end)

	-- New quests at midnight UTC for players who are online
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.Get(player)
				if data and data.quests.day ~= Quests.Today(os.time()) then
					DataService.Update(player, function(saved)
						refreshQuests(player, saved)
					end)
				end
			end
		end
	end)

	Remotes.Action.OnServerInvoke = function(player, actionName, argument)
		local action = actions[actionName]
		if type(actionName) ~= "string" or not action then
			return false, "Unknown action"
		end
		if argument ~= nil and type(argument) ~= "string" then
			return false, "Bad request"
		end
		local ok, success, message = pcall(action, player, argument)
		if not ok then
			warn("[ProgressService] " .. actionName .. " failed: " .. tostring(success))
			return false, "Something went wrong"
		end
		return success, message
	end
end

return ProgressService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[-- Robux purchases: the VIP game pass and cosmetic developer products.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Shop = require(Shared.Shop)
local Cosmetics = require(Shared.Cosmetics)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local ShopService = {}

function ShopService.HasPass(player, passId)
	local runtime = DataService.GetRuntime(player)
	return runtime ~= nil and runtime.passes ~= nil and runtime.passes[passId] == true
end

local function checkPasses(player, runtime)
	runtime.passes = {}
	local testing = RunService:IsStudio() and Config.TestPassesInStudio
	for _, pass in ipairs(Shop.Passes) do
		if testing then
			runtime.passes[pass.id] = true
		elseif pass.gamePassId ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.gamePassId)
			end)
			runtime.passes[pass.id] = ok and owns or false
		end
	end
end

local function onPassPurchased(player, gamePassId, purchased)
	if not purchased then
		return
	end
	for _, pass in ipairs(Shop.Passes) do
		if pass.gamePassId == gamePassId and pass.gamePassId ~= 0 then
			DataService.Update(player, function(_, runtime)
				runtime.passes[pass.id] = true
			end)
			Remotes.Notify:FireClient(player, "Thanks for buying " .. pass.name .. "!", "success")
		end
	end
end

-- Roblox calls this for every developer product purchase. It must only return
-- PurchaseGranted once the item is given AND saved, otherwise Roblox retries later.
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player or not DataService.IsLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local item = Cosmetics.ByProductId[receipt.ProductId]
	if not item then
		warn("[ShopService] Unknown product id " .. tostring(receipt.ProductId) .. " - add it to Cosmetics.luau")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local data = DataService.Get(player)
	if data.purchases[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	DataService.Update(player, function(saved)
		saved.purchases[receipt.PurchaseId] = true
		saved.cosmetics.owned[item.id] = true
		saved.cosmetics.equipped[item.kind] = item.id
	end)

	if not DataService.SaveNow(player) then
		-- Keep the item, Roblox will call again and the purchase id stops a double grant
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Remotes.Notify:FireClient(player, "You got " .. item.name .. "! It's equipped.", "success")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Start()
	DataService.OnLoaded(function(player, _, runtime)
		checkPasses(player, runtime)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onPassPurchased)
	MarketplaceService.ProcessReceipt = processReceipt
end

return ShopService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">TutorialService</string><ProtectedString name="Source"><![CDATA[-- Moves players through the first-time guide (see Shared/Tutorial).
-- Other services call TutorialService.Event(player, "Queue") etc. Doing a later
-- step first (like jumping straight into a match) skips the earlier ones.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local TutorialService = {}

function TutorialService.Event(player, event)
	local data = DataService.Get(player)
	if not data or data.tutorial >= Tutorial.Done then
		return
	end
	local index = nil
	for stepIndex, step in ipairs(Tutorial.Steps) do
		if step.event == event then
			index = stepIndex
		end
	end
	if not index or index < data.tutorial then
		return
	end
	local finished = index + 1 >= Tutorial.Done
	DataService.Update(player, function(saved)
		saved.tutorial = index + 1
		if finished then
			saved.coins += Tutorial.RewardCoins
			saved.totalEarned += Tutorial.RewardCoins
		end
	end)
	if finished then
		Remotes.Notify:FireClient(player, string.format("You're a natural brawler! Here's %s coins. Spend them in the Locker.", Format.Number(Tutorial.RewardCoins)), "success")
	end
end

function TutorialService.Start()
	Remotes.Dash.OnServerEvent:Connect(function(player)
		TutorialService.Event(player, "Dash")
	end)
end

return TutorialService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">WorldService</string><ProtectedString name="Source"><![CDATA[-- The lobby: practice dummies, the global leaderboards, and catching players
-- who fall off the lobby island.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Quests = require(Shared.Quests)
local Format = require(Shared.Format)

local CombatService = require(script.Parent.CombatService)
local CosmeticService = require(script.Parent.CosmeticService)
local TutorialService = require(script.Parent.TutorialService)
local MatchService = require(script.Parent.MatchService)

local WorldService = {}

local LEADERBOARD_REFRESH = 120
local DUMMY_RESET = 6 -- seconds without a hit before a dummy's damage goes back to 0
local dummyCount = 0

------------------------------------------------------------------ Practice dummies
local function makeDummy(spot)
	local description = Instance.new("HumanoidDescription")
	local wood = Color3.fromRGB(205, 170, 120)
	description.HeadColor = wood
	description.LeftArmColor = wood
	description.RightArmColor = wood
	description.TorsoColor = Color3.fromRGB(180, 60, 60)
	description.LeftLegColor = wood
	description.RightLegColor = wood
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil
	end
	dummyCount += 1
	model.Name = "PracticeDummy"
	local home = CFrame.lookAt(spot.Position, Vector3.new(spot.Position.X - 10, spot.Position.Y, spot.Position.Z))
	model:PivotTo(home)
	model.Parent = Workspace
	pcall(function()
		model.HumanoidRootPart:SetNetworkOwner(nil)
	end)
	local entity = CombatService.Register(model, { kind = "dummy", name = "Practice Dummy", key = "d" .. dummyCount, walkSpeed = 8 })
	entity.home = home
	model:SetAttribute("ShowDamage", true)
	CosmeticService.Tag(model, { name = "Practice Dummy", nameColor = Color3.fromRGB(255, 220, 160), subtitle = "Bonk me!" })
	return entity
end

local function runDummy(spot)
	while true do
		local entity = makeDummy(spot)
		if not entity then
			return
		end
		while entity.model.Parent and entity.humanoid.Health > 0 do
			task.wait(0.5)
			local root = entity.root
			if root.Position.Y < entity.home.Position.Y - 20 then
				break
			end
			local idle = not entity.lastHit or os.clock() - entity.lastHit.time > DUMMY_RESET
			if idle and entity.damage > 0 then
				CombatService.SetDamage(entity, 0)
			end
			if os.clock() > entity.stunUntil and (root.Position - entity.home.Position).Magnitude > 3 then
				entity.humanoid:MoveTo(entity.home.Position)
			end
		end
		entity.model:Destroy()
		task.wait(1)
	end
end

------------------------------------------------------------------ Leaderboards
local function makeBoardFace(boardPart, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = gui
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, 0, 0.16, 0)
	title.BackgroundTransparency = 1
	title.TextScaled = true
	title.Font = Enum.Font.FredokaOne
	title.TextColor3 = Color3.fromRGB(255, 220, 120)
	title.Parent = gui
	local body = Instance.new("TextLabel")
	body.Name = "Body"
	body.Position = UDim2.new(0, 0, 0.18, 0)
	body.Size = UDim2.new(1, 0, 0.8, 0)
	body.BackgroundTransparency = 1
	body.Text = "Loading..."
	body.TextScaled = true
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.Font = Enum.Font.GothamMedium
	body.TextColor3 = Color3.new(1, 1, 1)
	body.Parent = gui
	gui.Parent = boardPart
	return title, body
end

-- Boards show the same text on both sides. Returns a function(title, text).
local function makeBoardGui(boardPart)
	local frontTitle, frontBody = makeBoardFace(boardPart, Enum.NormalId.Front)
	local backTitle, backBody = makeBoardFace(boardPart, Enum.NormalId.Back)
	return function(title, text)
		frontTitle.Text = title
		backTitle.Text = title
		frontBody.Text = text
		backBody.Text = text
	end
end

local function findStation(name)
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Station") == name then
			return item
		end
	end
	return nil
end

local nameCache = {}
local function nameFor(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("Player " .. userId)
	return nameCache[userId]
end

local function topTen(storeName, emptyText)
	local ok, pages = pcall(function()
		return DataStoreService:GetOrderedDataStore(storeName):GetSortedAsync(false, 10)
	end)
	if not ok then
		return "Leaderboard unavailable right now."
	end
	local lines = {}
	for rank, entry in ipairs(pages:GetCurrentPage()) do
		table.insert(lines, string.format("%d. %s  -  %s", rank, nameFor(tonumber(entry.key)), Format.Number(entry.value)))
	end
	return #lines > 0 and table.concat(lines, "\n") or emptyText
end

-- The wins board takes turns showing all-time wins and this week's wins
local function runWinsBoard(boardPart)
	local setText = makeBoardGui(boardPart)
	local allTime, weekly, weekLeft = "Loading...", "Loading...", 0
	task.spawn(function()
		while true do
			local week, left = Quests.Week(os.time())
			allTime = topTen(Config.WinsStoreName, "No wins yet. Be the first!")
			weekly = topTen(Config.WeeklyWinsStorePrefix .. week, "No wins this week yet!")
			weekLeft = os.time() + left
			task.wait(LEADERBOARD_REFRESH)
		end
	end)
	while true do
		setText("Most Wins", allTime)
		task.wait(12)
		setText("This Week's Wins", weekly .. "\n\nNew week in " .. Format.Duration(weekLeft - os.time()))
		task.wait(12)
	end
end

local function runKosBoard(boardPart)
	local setText = makeBoardGui(boardPart)
	while true do
		setText("Most Knockouts", topTen(Config.KosStoreName, "No knockouts yet. Go bonk someone!"))
		task.wait(LEADERBOARD_REFRESH)
	end
end

function WorldService.Start()
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("Dummy") then
			task.spawn(runDummy, item)
		end
	end

	CombatService.OnHit(function(attacker, target)
		if target.kind == "dummy" and attacker.player then
			TutorialService.Event(attacker.player, "BonkDummy")
		end
	end)

	local winsBoard = findStation("WinsBoard")
	if winsBoard then
		task.spawn(runWinsBoard, winsBoard)
	end
	local kosBoard = findStation("KosBoard")
	if kosBoard then
		task.spawn(runKosBoard, kosBoard)
	end

	-- Anyone who falls off the lobby comes back to the spawn
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and root.Position.Y < -40 and not MatchService.ParticipantOfPlayer(player) then
					character:PivotTo(MatchService.LobbySpawn())
					root.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end
	end)
end

return WorldService
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000026"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000025"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000024"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[-- Bonk Arena player script. Builds the screen and starts the controls.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local UI = require(script.UI)
local Notifications = require(script.Notifications)
local Controls = require(script.Controls)
local Effects = require(script.Effects)
local Panels = require(script.Panels)
local MatchHud = require(script.MatchHud)
local Hud = require(script.Hud)
local Guide = require(script.Guide)

local player = Players.LocalPlayer

local screenGui = UI.new("ScreenGui", {
	Name = "BonkArenaUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Shrink the whole UI on small screens (phones)
local scale = UI.new("UIScale", { Parent = screenGui })
local function rescale()
	local camera = Workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		scale.Scale = math.clamp(math.min(size.X / 1100, size.Y / 700), 0.55, 1.2)
	end
end
while not Workspace.CurrentCamera do
	task.wait()
end
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

Notifications.Init(screenGui)
Controls.Init()
Effects.Init()
Panels.Init(screenGui)
MatchHud.Init(screenGui)
Hud.Init(screenGui)
Guide.Init(screenGui)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[-- Bonk and dash controls, and flying when you get bonked.
--   Bonk: click, F, R2 on a controller, or the BONK button on phones
--   Dash: Q, X on a controller, or the DASH button on phones
-- The server decides who gets hit; this script only asks to swing.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Controls = {}

local player = Players.LocalPlayer
local lastBonk = 0
local lastDash = 0
local stunToken = 0
local stunnedUntil = 0
local dashing = nil

local function parts()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and humanoid and humanoid.Health > 0 then
		return root, humanoid
	end
	return nil
end

local function flat(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

local function stopDash()
	if dashing then
		dashing.mover:Destroy()
		dashing.attachment:Destroy()
		dashing = nil
	end
end

function Controls.Bonk()
	local now = os.clock()
	if now - lastBonk < Config.BonkCooldown or now < stunnedUntil or not parts() then
		return
	end
	lastBonk = now
	Remotes.Bonk:FireServer()
end

function Controls.Dash()
	local now = os.clock()
	local root, humanoid = parts()
	if not root or now - lastDash < Config.DashCooldown or now < stunnedUntil or humanoid.WalkSpeed <= 0 then
		return
	end
	local direction = flat(humanoid.MoveDirection)
	if direction.Magnitude < 0.1 then
		direction = flat(root.CFrame.LookVector)
	end
	if direction.Magnitude < 0.1 then
		return
	end
	lastDash = now
	stopDash()
	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = root
	local mover = Instance.new("LinearVelocity")
	mover.Name = "Dash"
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	mover.MaxAxesForce = Vector3.new(1e6, 0, 1e6)
	mover.VectorVelocity = direction.Unit * Config.DashSpeed
	mover.Parent = root
	local this = { mover = mover, attachment = attachment }
	dashing = this
	task.delay(Config.DashSeconds, function()
		if dashing == this then
			stopDash()
		end
	end)
	Remotes.Dash:FireServer()
end

-- 0 to 1: how ready each move is (for the phone buttons)
function Controls.Cooldowns()
	local now = os.clock()
	return math.clamp((now - lastBonk) / Config.BonkCooldown, 0, 1), math.clamp((now - lastDash) / Config.DashCooldown, 0, 1)
end

local function onLaunch(velocity, stun, spin)
	local root, humanoid = parts()
	if not root then
		return
	end
	stopDash()
	stunToken += 1
	local token = stunToken
	stunnedUntil = os.clock() + stun
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = spin or Vector3.zero
	task.delay(stun, function()
		if stunToken ~= token or not humanoid.Parent then
			return
		end
		humanoid.PlatformStand = false
		root.AssemblyAngularVelocity = Vector3.zero
		-- Stand back up straight, facing the same way
		local look = flat(root.CFrame.LookVector)
		if look.Magnitude < 0.1 then
			look = Vector3.new(0, 0, -1)
		end
		root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
	end)
end

function Controls.Init()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
	end)

	ContextActionService:BindAction("BonkArenaBonk", function(_, state)
		if state == Enum.UserInputState.Begin then
			Controls.Bonk()
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.F, Enum.KeyCode.ButtonR2)
	ContextActionService:SetTitle("BonkArenaBonk", "BONK")
	ContextActionService:SetPosition("BonkArenaBonk", UDim2.new(1, -150, 1, -150))

	ContextActionService:BindAction("BonkArenaDash", function(_, state)
		if state == Enum.UserInputState.Begin then
			Controls.Dash()
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("BonkArenaDash", "DASH")
	ContextActionService:SetPosition("BonkArenaDash", UDim2.new(1, -230, 1, -100))

	Remotes.Launch.OnClientEvent:Connect(onLaunch)
	player.CharacterAdded:Connect(function()
		stunToken += 1
		stunnedUntil = 0
		dashing = nil
	end)
end

return Controls
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[-- Hit sparks, damage numbers, knockout effects and sounds. The server says what
-- happened and where (the Effect remote); every player draws it on their own screen.

local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)
local PowerUps = require(Shared.PowerUps)
local Remotes = require(Shared.Remotes)

local Effects = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SOUNDS = {
	bonk = { "rbxasset://sounds/collide.wav", 0.8 },
	swing = { "rbxasset://sounds/swordslash.wav", 0.25 },
	dash = { "rbxasset://sounds/swordlunge.wav", 0.3 },
	ko = { "rbxasset://sounds/uuhhh.mp3", 0.6 },
	block = { "rbxasset://sounds/electronicpingshort.wav", 0.5 },
	crack = { "rbxasset://sounds/glassbreak.wav", 0.35 },
	powerup = { "rbxasset://sounds/electronicpingshort.wav", 0.6 },
}

local folder

local function anchor(position)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = position
	p.Parent = folder
	return p
end

function Effects.Sound(name, position)
	local info = SOUNDS[name]
	if not info then
		return
	end
	local holder = anchor(position)
	local sound = Instance.new("Sound")
	sound.SoundId = info[1]
	sound.Volume = info[2]
	sound.RollOffMaxDistance = 200
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(holder, 3)
end

-- A burst of particles in the given colors
function Effects.Burst(position, colors, count, speed, texture, size)
	local holder = anchor(position)
	local keypoints = {}
	for index, color in ipairs(colors) do
		table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(1, #colors - 1), color))
	end
	if #keypoints == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture or SPARKLE
	emitter.Color = ColorSequence.new(keypoints)
	emitter.Size = NumberSequence.new(size or 1, 0)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Drag = 3
	emitter.LightEmission = 0.5
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, 2)
	return holder
end

-- Text that floats up and fades, like "+10%" or "KO!"
function Effects.Popup(position, text, color, size, seconds)
	local holder = anchor(position)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size * 4, size)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextStrokeTransparency = 0
	label.Parent = gui
	seconds = seconds or 0.9
	TweenService:Create(holder, TweenInfo.new(seconds), { Position = position + Vector3.new(0, 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(holder, seconds + 0.1)
end

local function ring(position, color, radius)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.3
	p.Size = Vector3.new(0.4, 2, 2)
	p.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	p.Parent = folder
	TweenService:Create(p, TweenInfo.new(0.35), { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(p, 0.4)
end

local function lightning(position, colors)
	local top = position + Vector3.new(0, 40, 0)
	local previous = top
	for step = 1, 6 do
		local nextPoint = top:Lerp(position, step / 6) + (step < 6 and Vector3.new(math.random(-3, 3), 0, math.random(-3, 3)) or Vector3.zero)
		local length = (nextPoint - previous).Magnitude
		local bolt = Instance.new("Part")
		bolt.Anchored = true
		bolt.CanCollide = false
		bolt.CanQuery = false
		bolt.CanTouch = false
		bolt.Material = Enum.Material.Neon
		bolt.Color = colors[1]
		bolt.Size = Vector3.new(0.6, 0.6, length)
		bolt.CFrame = CFrame.lookAt((previous + nextPoint) / 2, nextPoint)
		bolt.Parent = folder
		TweenService:Create(bolt, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		Debris:AddItem(bolt, 0.6)
		previous = nextPoint
	end
	Effects.Burst(position, colors, 40, 30)
end

-- The knockout effect the knocker has equipped
function Effects.Knockout(position, effectId)
	local item = Cosmetics.ById[effectId or ""] or Cosmetics.ById["ko_poof"]
	local colors = item.colors
	if item.id == "ko_poof" then
		Effects.Burst(position, colors, 30, 15, SMOKE, 4)
	elseif item.id == "ko_bubbles" then
		Effects.Burst(position, colors, 40, 12, SPARKLE, 3)
	elseif item.id == "ko_hearts" then
		Effects.Burst(position, colors, 50, 25, SPARKLE, 2.5)
		Effects.Popup(position + Vector3.new(0, 2, 0), "<3", colors[1], 60, 1.2)
	elseif item.id == "ko_confetti" then
		Effects.Burst(position, colors, 120, 45, SPARKLE, 1.5)
	elseif item.id == "ko_star" then
		Effects.Burst(position, colors, 60, 35, SPARKLE, 3)
		Effects.Popup(position + Vector3.new(0, 3, 0), "*", colors[1], 120, 1.2)
	elseif item.id == "ko_fireworks" then
		for index = 1, 4 do
			task.delay(index * 0.18, function()
				local at = position + Vector3.new(math.random(-8, 8), math.random(6, 14), math.random(-8, 8))
				Effects.Burst(at, { colors[(index % #colors) + 1], colors[1] }, 50, 40, SPARKLE, 2)
			end)
		end
	elseif item.id == "ko_lightning" then
		lightning(position, colors)
	else
		Effects.Burst(position, colors, 60, 30)
	end
	Effects.Popup(position + Vector3.new(0, 5, 0), "KO!", Color3.fromRGB(255, 90, 60), 70, 1.4)
	Effects.Sound("ko", position)
end

local handlers = {
	hit = function(position, extra)
		Effects.Burst(position, { Color3.fromRGB(255, 240, 150), Color3.fromRGB(255, 150, 60) }, extra and extra.big and 40 or 20, 30)
		Effects.Popup(position + Vector3.new(0, 3, 0), "+" .. (extra and extra.damage or 0) .. "%", Color3.fromRGB(255, 220, 80), 34)
		Effects.Sound("bonk", position)
	end,
	block = function(position)
		Effects.Burst(position, { Color3.fromRGB(90, 200, 255), Color3.new(1, 1, 1) }, 30, 25)
		Effects.Popup(position + Vector3.new(0, 3, 0), "BLOCKED", Color3.fromRGB(120, 210, 255), 30)
		Effects.Sound("block", position)
	end,
	swing = function(position)
		Effects.Sound("swing", position)
	end,
	dash = function(position)
		Effects.Burst(position - Vector3.new(0, 2, 0), { Color3.new(1, 1, 1) }, 12, 8, SMOKE, 2)
		Effects.Sound("dash", position)
	end,
	ko = function(position, extra)
		Effects.Knockout(position, extra and extra.effect)
	end,
	powerup = function(position, extra)
		local powerUp = PowerUps.ById[extra and extra.id or ""]
		if powerUp then
			Effects.Burst(position, { powerUp.color, Color3.new(1, 1, 1) }, 40, 25)
			Effects.Popup(position + Vector3.new(0, 4, 0), powerUp.name .. "!", powerUp.color, 36, 1.3)
		end
		Effects.Sound("powerup", position)
	end,
	shockwave = function(position, extra)
		ring(position - Vector3.new(0, 2.5, 0), Color3.fromRGB(200, 90, 255), extra and extra.range or 10)
	end,
	slip = function(position)
		Effects.Popup(position + Vector3.new(0, 3, 0), "SLIP!", Color3.fromRGB(255, 240, 90), 36)
	end,
	bounce = function(position)
		Effects.Burst(position, { Color3.fromRGB(255, 110, 200) }, 15, 15)
		Effects.Popup(position + Vector3.new(0, 3, 0), "BOING", Color3.fromRGB(255, 140, 220), 28)
	end,
	crack = function(position)
		Effects.Sound("crack", position)
	end,
}

function Effects.Init()
	folder = Instance.new("Folder")
	folder.Name = "BonkEffects"
	folder.Parent = Workspace
	Remotes.Effect.OnClientEvent:Connect(function(kind, position, extra)
		local handler = handlers[kind]
		if handler and typeof(position) == "Vector3" then
			handler(position, extra)
		end
	end)
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[-- The first-time guide on screen: the current goal at the top, and a golden
-- line from you to where you need to go.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Tutorial = require(Shared.Tutorial)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local T = UI.Theme

local Guide = {}

local player = Players.LocalPlayer
local card, cardText
local beam, beamFrom, beamTo, marker, follower

local function findTarget(name)
	if not name then
		return nil
	end
	for _, item in ipairs(Workspace:GetDescendants()) do
		if item:IsA("BasePart") and item:GetAttribute("GuideTarget") == name then
			return item
		end
	end
	return nil
end

local function currentStep()
	local data = State.data
	if not data or not data.tutorial or data.tutorial >= Tutorial.Done then
		return nil, nil
	end
	return Tutorial.Steps[data.tutorial], data.tutorial
end

local function update()
	local step, index = currentStep()
	if player:GetAttribute("InMatch") then
		step = nil
	end
	card.Visible = step ~= nil
	if not step then
		beam.Enabled = false
		marker.Enabled = false
		return
	end
	cardText.Text = string.format("(%d/%d) %s", index, #Tutorial.Steps, step.text)

	local target = findTarget(step.target)
	if target then
		beamTo.Parent = target
		beam.Enabled = true
		marker.Adornee = target
		marker.Enabled = true
	else
		beam.Enabled = false
		marker.Enabled = false
	end
end

function Guide.Init(screenGui)
	card = UI.new("Frame", {
		Name = "GuideCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(560, 56),
		BackgroundColor3 = Color3.fromRGB(255, 244, 214),
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(12), UI.stroke(T.Gold, 3), UI.padding(8) })
	cardText = UI.label("", { Size = UDim2.fromScale(1, 1), TextColor3 = Color3.fromRGB(60, 40, 20), Font = T.BodyFont, TextWrapped = true, Parent = card })

	-- An invisible part that follows the player carries the start of the line
	follower = Instance.new("Part")
	follower.Name = "GuideFollower"
	follower.Anchored = true
	follower.CanCollide = false
	follower.CanQuery = false
	follower.CanTouch = false
	follower.Transparency = 1
	follower.Size = Vector3.one * 0.2
	follower.Parent = Workspace
	beamFrom = Instance.new("Attachment")
	beamFrom.Name = "GuideFrom"
	beamFrom.Parent = follower
	beamTo = Instance.new("Attachment")
	beamTo.Name = "GuideTo"
	beamTo.Position = Vector3.new(0, 3, 0)
	beam = Instance.new("Beam")
	beam.Attachment0 = beamFrom
	beam.Attachment1 = beamTo
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(T.Gold)
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.1) })
	beam.LightEmission = 1
	beam.Enabled = false
	beam.Parent = beamFrom

	marker = UI.new("BillboardGui", {
		Name = "GuideMarker",
		Size = UDim2.fromOffset(80, 80),
		StudsOffset = Vector3.new(0, 6, 0),
		AlwaysOnTop = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local arrow = UI.label("V", { Size = UDim2.fromScale(1, 1), TextColor3 = T.Gold, TextStrokeTransparency = 0, Parent = marker })

	RunService.RenderStepped:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			follower.Position = root.Position - Vector3.new(0, 1.5, 0)
		end
		if marker.Enabled then
			marker.StudsOffset = Vector3.new(0, 6 + math.sin(os.clock() * 4) * 0.6, 0)
			arrow.TextTransparency = 0
		end
	end)

	State.Changed:Connect(update)
	player:GetAttributeChangedSignal("InMatch"):Connect(update)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		update()
	end)
	update()
end

return Guide
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Always-on screen info: level, coins, wins, the queue banner and the menu buttons.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)
local MatchHud = require(script.Parent.MatchHud)
local T = UI.Theme

local Hud = {}

local player = Players.LocalPlayer

function Hud.Init(screenGui)
	-- Stats, top left
	local stats = UI.new("Frame", {
		Name = "Stats",
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.fromOffset(230, 96),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Parent = screenGui,
	}, { UI.corner(12), UI.padding(10), UI.list(4) })
	local levelLine = UI.label("Lv 1 Brawler", { Size = UDim2.new(1, 0, 0, 22), TextColor3 = Color3.fromRGB(150, 220, 255), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = stats })
	local xpBack = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.Card, LayoutOrder = 2, Parent = stats }, { UI.corner(3) })
	local xpFill = UI.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(150, 220, 255), Parent = xpBack }, { UI.corner(3) })
	local coins = UI.label("0 coins", { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.Gold, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 3, Parent = stats })
	local record = UI.label("", { Size = UDim2.new(1, 0, 0, 16), Font = T.BodyFont, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 4, Parent = stats })

	local function update(data)
		local progress, level = Level.Progress(data.xp or 0)
		levelLine.Text = string.format("Lv %d Brawler", level)
		xpFill.Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1)
		coins.Text = Format.Number(data.coins) .. " coins"
		record.Text = string.format("%s wins  -  %s knockouts", Format.Number(data.stats.wins), Format.Number(data.stats.kos))
	end
	State.Changed:Connect(update)
	if State.data then
		update(State.data)
	end

	-- Queue banner, top center, while you stand on a pad
	local queueBanner = UI.new("Frame", {
		Name = "QueueBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(520, 56),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(12), UI.stroke(T.Gold, 2), UI.padding(6), UI.list(2) })
	local queueLine = UI.label("", { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.Gold, Parent = queueBanner })
	UI.label("Step off the pad to leave the queue", { Size = UDim2.new(1, 0, 0, 16), Font = T.BodyFont, TextColor3 = T.Muted, Parent = queueBanner })
	task.spawn(function()
		while true do
			local pad = player:GetAttribute("QueuePad")
			queueBanner.Visible = pad ~= nil and not player:GetAttribute("InMatch")
			if pad then
				queueLine.Text = ReplicatedStorage:GetAttribute("PadStatus" .. pad) or "Waiting..."
			end
			task.wait(0.2)
		end
	end)

	-- Menu buttons, left side under the stats, with keyboard shortcuts
	local menu = UI.new("Frame", {
		Name = "Menu",
		Position = UDim2.fromOffset(16, 166),
		Size = UDim2.fromOffset(130, 5 * 48),
		BackgroundTransparency = 1,
		Parent = screenGui,
	}, { UI.list(6) })
	local buttons = {
		{ "Shop", "Shop", Color3.fromRGB(70, 200, 110), Enum.KeyCode.P },
		{ "Locker", "Locker", Color3.fromRGB(90, 140, 220), Enum.KeyCode.L },
		{ "Quests", "Quests", Color3.fromRGB(200, 150, 70), Enum.KeyCode.N },
	}
	local shortcuts = {}
	for index, info in ipairs(buttons) do
		local keyName = UserInputService.KeyboardEnabled and (" (" .. info[4].Name .. ")") or ""
		UI.button(info[1] .. keyName, info[3], function()
			Panels[info[2]].toggle()
		end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = index, Parent = menu })
		shortcuts[info[4]] = info[2]
	end

	-- Watch a match that's on (only in the lobby)
	local watchButton = UI.button("Watch", Color3.fromRGB(170, 100, 255), function()
		MatchHud.ToggleWatch()
	end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = 10, Visible = false, Parent = menu })

	-- The private server owner picks the arena
	-- Only the server can see who owns a private server; it shares that as an attribute
	local isOwner = ReplicatedStorage:GetAttribute("PrivateServerOwnerId") == player.UserId or RunService:IsStudio()
	if isOwner then
		UI.button("Arena", Color3.fromRGB(255, 120, 60), function()
			Panels.Arena.toggle()
		end, { Size = UDim2.fromOffset(130, 42), LayoutOrder = 11, Parent = menu })
	end

	task.spawn(function()
		while true do
			local inMatch = player:GetAttribute("InMatch") ~= nil
			watchButton.Visible = (MatchHud.AnyMatchOn() and not inMatch) or MatchHud.IsWatching()
			watchButton.Text = MatchHud.IsWatching() and "Stop watching" or "Watch a match"
			task.wait(0.3)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local panel = shortcuts[input.KeyCode]
		if panel then
			Panels[panel].toggle()
		end
	end)
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">MatchHud</string><ProtectedString name="Source"><![CDATA[-- The match screen: round and timer at the top, a card for each player at the
-- bottom (name, damage %, rounds won), big announcements in the middle, and a
-- feed of knockouts. Also lets lobby players watch a match that's on.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Arenas = require(Shared.Arenas)
local Format = require(Shared.Format)
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local T = UI.Theme

local MatchHud = {}

local player = Players.LocalPlayer
local matches = {}
local watching = nil -- { slot = n, key = participant key }
local topBar, roundLine, timerLine, watchLine
local cardsRow
local bigLabel, countdownLabel
local feed
local bigToken = 0

local KINDS = {
	big = { color = Color3.fromRGB(255, 230, 90), size = 70 },
	round = { color = Color3.new(1, 1, 1), size = 56 },
	victory = { color = Color3.fromRGB(255, 200, 40), size = 76 },
}
local FEED_COLORS = {
	ko = Color3.fromRGB(255, 120, 90),
	info = Color3.fromRGB(180, 220, 255),
	power = Color3.fromRGB(200, 160, 255),
	small = Color3.new(1, 1, 1),
}

local function serverTime()
	return Workspace:GetServerTimeNow()
end

local function myMatch()
	for _, match in ipairs(matches) do
		for _, entry in ipairs(match.players) do
			if entry.userId == player.UserId and not entry.bot then
				return match
			end
		end
	end
	return nil
end

local function watchedMatch()
	if not watching then
		return nil
	end
	for _, match in ipairs(matches) do
		if match.slot == watching.slot then
			return match
		end
	end
	return nil
end

function MatchHud.AnyMatchOn()
	return #matches > 0
end

function MatchHud.IsWatching()
	return watching ~= nil
end

local function ownHumanoid()
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function stopWatching()
	watching = nil
	local humanoid = ownHumanoid()
	if humanoid then
		Workspace.CurrentCamera.CameraSubject = humanoid
	end
end

-- Points the camera at someone still fighting in the watched match
local function followSomeone(match, skipKey)
	for _, entry in ipairs(match.players) do
		if entry.alive and entry.model and entry.model.Parent and entry.key ~= skipKey then
			local humanoid = entry.model:FindFirstChildOfClass("Humanoid")
			if humanoid then
				watching.key = entry.key
				Workspace.CurrentCamera.CameraSubject = humanoid
				return true
			end
		end
	end
	return false
end

function MatchHud.ToggleWatch()
	if watching then
		stopWatching()
		return
	end
	for _, match in ipairs(matches) do
		if match.state == "fight" or match.state == "countdown" then
			watching = { slot = match.slot }
			if followSomeone(match) then
				return
			end
		end
	end
	watching = nil
end

local function dots(parent, wins, needed)
	local row = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, LayoutOrder = 3, Parent = parent }, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }),
	})
	for index = 1, needed do
		UI.new("Frame", { Size = UDim2.fromOffset(12, 12), BackgroundColor3 = index <= wins and T.Gold or T.Card, Parent = row }, { UI.corner(6) })
	end
end

local function renderCards(match)
	UI.clear(cardsRow)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), Parent = cardsRow })
	for _, entry in ipairs(match.players) do
		local isMe = entry.userId == player.UserId and not entry.bot
		local card = UI.new("Frame", {
			Size = UDim2.fromOffset(140, 84),
			BackgroundColor3 = isMe and Color3.fromRGB(40, 70, 110) or T.Background,
			BackgroundTransparency = entry.alive and 0.1 or 0.5,
			Parent = cardsRow,
		}, { UI.corner(10), UI.padding(6), UI.list(2), isMe and UI.stroke(T.Gold, 2) or nil })
		UI.label(entry.name, { Size = UDim2.new(1, 0, 0, 18), TextColor3 = entry.bot and T.Muted or T.Text, LayoutOrder = 1, Parent = card })
		local damage = entry.alive and (entry.damage .. "%") or "OUT"
		UI.label(damage, { Size = UDim2.new(1, 0, 0, 34), TextColor3 = entry.alive and Format.DamageColor(entry.damage) or T.Bad, TextStrokeTransparency = 0.4, LayoutOrder = 2, Parent = card })
		dots(card, entry.wins, match.roundsToWin)
	end
end

local function render()
	local match = myMatch() or watchedMatch()
	if watching and not watchedMatch() then
		stopWatching()
	end
	topBar.Visible = match ~= nil
	cardsRow.Visible = match ~= nil and match.state ~= "victory"
	if not match then
		countdownLabel.Visible = false
		return
	end
	local arena = Arenas.ById[match.arena or ""]
	roundLine.Text = string.format("%s  -  Round %d%s", match.pad, match.round, arena and ("  -  " .. arena.name) or "")
	roundLine.TextColor3 = arena and arena.color or T.Text
	renderCards(match)
	if watching then
		local subject = Workspace.CurrentCamera.CameraSubject
		local alive = false
		for _, entry in ipairs(match.players) do
			if entry.key == watching.key and entry.alive then
				alive = true
			end
		end
		if not alive or not subject or not subject.Parent then
			followSomeone(match, watching.key)
		end
		watchLine.Visible = true
		for _, entry in ipairs(match.players) do
			if entry.key == watching.key then
				watchLine.Text = "Watching " .. entry.name
			end
		end
	else
		watchLine.Visible = false
	end
end

-- The timer and the 3-2-1 countdown, every frame-ish
local function tick()
	local match = myMatch() or watchedMatch()
	if not match then
		countdownLabel.Visible = false
		return
	end
	local left = match.endsAt - serverTime()
	if match.state == "countdown" then
		countdownLabel.Visible = left > 0
		countdownLabel.Text = tostring(math.max(1, math.ceil(left)))
		timerLine.Text = "Get ready!"
		timerLine.TextColor3 = T.Text
	elseif match.state == "fight" then
		countdownLabel.Visible = false
		if match.suddenDeath then
			timerLine.Text = "SUDDEN DEATH  " .. Format.Clock(left)
			timerLine.TextColor3 = T.Bad
		else
			timerLine.Text = Format.Clock(left)
			timerLine.TextColor3 = left < 10 and T.Gold or T.Text
		end
	elseif match.state == "roundEnd" then
		countdownLabel.Visible = false
		timerLine.Text = "Next round coming up"
		timerLine.TextColor3 = T.Muted
	elseif match.state == "victory" then
		countdownLabel.Visible = false
		timerLine.Text = (match.winner or "Nobody") .. " wins!"
		timerLine.TextColor3 = T.Gold
	end
end

function MatchHud.ShowBig(text, kind, seconds)
	local style = KINDS[kind] or KINDS.big
	bigToken += 1
	local token = bigToken
	bigLabel.Text = text
	bigLabel.TextColor3 = style.color
	bigLabel.Size = UDim2.new(0.9, 0, 0, style.size)
	bigLabel.Visible = true
	task.delay(seconds or 1.6, function()
		if bigToken == token then
			bigLabel.Visible = false
		end
	end)
end

function MatchHud.AddFeed(text, kind)
	local line = UI.label(text, {
		Size = UDim2.new(1, 0, 0, 24),
		TextColor3 = FEED_COLORS[kind] or T.Text,
		TextStrokeTransparency = 0.3,
		Parent = feed,
	})
	task.delay(3.5, function()
		line:Destroy()
	end)
	local lines = {}
	for _, child in ipairs(feed:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(lines, child)
		end
	end
	if #lines > 4 then
		lines[1]:Destroy()
	end
end

function MatchHud.Init(screenGui)
	topBar = UI.new("Frame", {
		Name = "MatchBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(480, 64),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = screenGui,
	}, { UI.corner(12), UI.padding(6), UI.list(2) })
	roundLine = UI.label("", { Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Parent = topBar })
	timerLine = UI.label("", { Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 2, Parent = topBar })
	watchLine = UI.label("", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 6),
		Size = UDim2.new(1, 0, 0, 20),
		Font = T.BodyFont,
		TextColor3 = Color3.fromRGB(200, 160, 255),
		TextStrokeTransparency = 0.4,
		Visible = false,
		Parent = topBar,
	})

	feed = UI.new("Frame", {
		Name = "Feed",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 104),
		Size = UDim2.fromOffset(520, 130),
		BackgroundTransparency = 1,
		Parent = screenGui,
	}, { UI.list(2) })

	cardsRow = UI.new("Frame", {
		Name = "Cards",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(600, 84),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = screenGui,
	})

	bigLabel = UI.label("", {
		Name = "Big",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.new(0.9, 0, 0, 70),
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 5,
		Parent = screenGui,
	})
	countdownLabel = UI.label("", {
		Name = "Countdown",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(200, 110),
		TextColor3 = T.Gold,
		TextStrokeTransparency = 0,
		Visible = false,
		ZIndex = 5,
		Parent = screenGui,
	})

	Remotes.Matches.OnClientEvent:Connect(function(list)
		matches = list or {}
		render()
	end)
	Remotes.Announce.OnClientEvent:Connect(function(text, kind, seconds)
		if KINDS[kind] then
			MatchHud.ShowBig(text, kind, seconds)
		else
			MatchHud.AddFeed(text, kind)
		end
	end)
	player.CharacterAdded:Connect(function()
		if watching then
			stopWatching()
		end
	end)
	task.spawn(function()
		while true do
			tick()
			task.wait(0.1)
		end
	end)
end

return MatchHud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Notifications</string><ProtectedString name="Source"><![CDATA[-- Small messages that pop up on the right side of the screen.

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local UI = require(script.Parent.UI)
local T = UI.Theme

local Notifications = {}

local COLORS = {
	success = T.Good,
	warning = T.Bad,
	coins = T.Gold,
	rare = Color3.fromRGB(255, 120, 200),
	info = T.Accent,
}

local container

function Notifications.Init(screenGui)
	container = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 70),
		Size = UDim2.fromOffset(320, 400),
		BackgroundTransparency = 1,
		ZIndex = 20, -- above open windows
		Parent = screenGui,
	}, { UI.list(6) })

	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		Notifications.Show(text, kind)
	end)
end

function Notifications.Show(text, kind)
	if not container then
		return
	end
	local toast = UI.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.1,
		Text = text,
		TextColor3 = COLORS[kind or "info"] or T.Text,
		Font = T.Font,
		TextScaled = true,
		TextWrapped = true,
		Parent = container,
	}, { UI.corner(10), UI.padding(6) })

	task.delay(4, function()
		local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		toast:Destroy()
	end)

	-- Keep at most 6 on screen
	local toasts = {}
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("TextLabel") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 6 then
		toasts[1]:Destroy()
	end
end

return Notifications
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Panels</string><ProtectedString name="Source"><![CDATA[-- The menus: Shop (Robux), Locker (your cosmetics and the coin shop), Quests,
-- and Arena (private server owners pick the arena).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared.Cosmetics)
local Shop = require(Shared.Shop)
local Arenas = require(Shared.Arenas)
local Quests = require(Shared.Quests)
local Level = require(Shared.Level)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local State = require(script.Parent.State)
local Notifications = require(script.Parent.Notifications)
local T = UI.Theme

local player = Players.LocalPlayer
local Panels = {}

local function act(actionName, argument)
	local ok, message = State.Action(actionName, argument)
	if not ok and message then
		Notifications.Show(message, "warning")
	end
	return ok
end

-- Robux prices come from Roblox, so they always match the Creator Dashboard
local priceCache = {}
local function robuxPrice(id, infoType, onReady)
	local key = tostring(infoType) .. id
	if priceCache[key] then
		onReady(priceCache[key])
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfoAsync(id, infoType)
		end)
		if not ok then
			ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(id, infoType)
			end)
		end
		if ok and info and info.PriceInRobux then
			priceCache[key] = info.PriceInRobux
			onReady(info.PriceInRobux)
		end
	end)
end

local function row(parent, height, order)
	return UI.new("Frame", {
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = T.Card,
		LayoutOrder = order or 0,
		Parent = parent,
	}, { UI.corner(10) })
end

local function heading(parent, text, order)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold, LayoutOrder = order, Parent = parent })
end

local function note(parent, text, order)
	UI.label(text, { Size = UDim2.new(1, -8, 0, 20), Font = T.BodyFont, TextColor3 = T.Muted, TextWrapped = true, LayoutOrder = order, Parent = parent })
end

-- A small colour swatch so you can tell items apart at a glance
-- An item's name on its card, all at the same size whether it's short or long
local function itemName(card, text, width)
	local label = UI.label(text, { Position = UDim2.fromOffset(48, 0), Size = UDim2.new(width, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
	UI.new("UITextSizeConstraint", { MaxTextSize = 20, Parent = label })
	return label
end

local function swatch(card, item)
	local color = item.head or item.color or (item.colors and item.colors[1]) or T.Muted
	UI.new("Frame", { Position = UDim2.fromOffset(10, 12), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = color, Parent = card }, { UI.corner(14), UI.stroke(T.Background, 2) })
end

local function cardButton(card, text, color, onClick)
	return UI.button(text, color, onClick, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(150, 36), Parent = card })
end

------------------------------------------------------------------ Shop (Robux)
local function renderShop(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end
	note(body, "Everything here is looks only. Nothing you buy helps you win.", nextOrder())

	heading(body, "Game pass (yours forever)", nextOrder())
	for _, pass in ipairs(Shop.Passes) do
		local card = row(body, 64, nextOrder())
		UI.label(pass.name, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
		UI.label(pass.description, { Position = UDim2.fromOffset(12, 34), Size = UDim2.new(0.68, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = card })
		local button = cardButton(card, "...", T.Good)
		if State.HasPass(pass.id) then
			button.Text = "Owned"
			button.BackgroundColor3 = T.Card
		elseif pass.gamePassId == 0 then
			button.Text = "Coming soon"
			button.BackgroundColor3 = T.Card
		else
			robuxPrice(pass.gamePassId, Enum.InfoType.GamePass, function(price)
				button.Text = "R$ " .. price
			end)
			button.Activated:Connect(function()
				MarketplaceService:PromptGamePassPurchase(player, pass.gamePassId)
			end)
		end
	end

	for _, kind in ipairs(Cosmetics.Kinds) do
		local items = {}
		for _, item in ipairs(Cosmetics.List) do
			if item.kind == kind.id and item.source == "robux" then
				table.insert(items, item)
			end
		end
		if #items > 0 then
			heading(body, kind.name, nextOrder())
			for _, item in ipairs(items) do
				local card = row(body, 52, nextOrder())
				swatch(card, item)
				itemName(card, item.name, 0.6)
				local owned = data.cosmetics.owned[item.id]
				local equipped = data.cosmetics.equipped[item.kind] == item.id
				local button = cardButton(card, "...", T.Good)
				if owned then
					button.Text = equipped and "Equipped" or "Equip"
					button.BackgroundColor3 = equipped and T.Card or T.Accent
					button.Activated:Connect(function()
						act("EquipCosmetic", item.id)
					end)
				elseif item.productId == 0 then
					button.Text = "Coming soon"
					button.BackgroundColor3 = T.Card
				else
					robuxPrice(item.productId, Enum.InfoType.Product, function(price)
						button.Text = "R$ " .. price
					end)
					button.Activated:Connect(function()
						MarketplaceService:PromptProductPurchase(player, item.productId)
					end)
				end
			end
		end
	end
end

------------------------------------------------------------------ Locker
local lockerTab = "hammer"

local function howToGet(item, data)
	if item.source == "level" then
		return string.format("Reach level %d", item.level)
	elseif item.source == "earned" then
		local have = data.stats[item.rule] or 0
		local what = item.rule == "wins" and "wins" or "knockouts"
		return string.format("%d/%d %s", math.min(have, item.amount), item.amount, what)
	elseif item.source == "vip" then
		return "VIP pass"
	elseif item.source == "robux" then
		return "In the Shop"
	end
	return ""
end

local function renderLocker(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local vip = State.HasPass("VIP")

	-- Tabs, one per kind of cosmetic
	local tabs = UI.new("Frame", { Size = UDim2.new(1, -8, 0, 36), BackgroundTransparency = 1, LayoutOrder = 0, Parent = body }, { UI.list(6, Enum.FillDirection.Horizontal) })
	for _, kind in ipairs(Cosmetics.Kinds) do
		UI.button(kind.short, kind.id == lockerTab and T.Accent or T.Card, function()
			lockerTab = kind.id
			Panels.Locker.refresh()
		end, { Size = UDim2.fromOffset(104, 34), Parent = tabs })
	end
	note(body, string.format("You have %s coins. Win matches, knock rivals out and finish quests to earn more.", Format.Number(data.coins)), 1)

	local order = 1
	for _, item in ipairs(Cosmetics.List) do
		if item.kind == lockerTab then
			order += 1
			local owns = Cosmetics.Owns(data, item, vip)
			local equipped = Cosmetics.Equipped(data, item.kind, vip)
			local isEquipped = equipped and equipped.id == item.id
			local card = row(body, 52, order)
			swatch(card, item)
			itemName(card, item.name, 0.55)
			if owns then
				local canTakeOff = isEquipped and not Cosmetics.Defaults[item.kind]
				cardButton(card, isEquipped and (canTakeOff and "Take off" or "Equipped") or "Equip", isEquipped and T.Card or T.Accent, function()
					if not isEquipped or canTakeOff then
						act("EquipCosmetic", item.id)
					end
				end)
			elseif item.source == "coins" then
				cardButton(card, Format.Number(item.price) .. " coins", data.coins >= item.price and T.Good or T.Card, function()
					act("BuyCosmetic", item.id)
				end)
			else
				cardButton(card, howToGet(item, data), T.Card, function()
					if item.source == "robux" or item.source == "vip" then
						Panels.Shop.open()
					end
				end)
			end
		end
	end
end

------------------------------------------------------------------ Quests
local function renderQuests(body)
	local data = State.data
	if not data then
		return
	end
	UI.list(8).Parent = body
	local resetIn = 86400 - (os.time() % 86400)
	note(body, string.format("Three new quests every day. New quests in %s.", Format.Duration(resetIn)), 0)
	for index, entry in ipairs(data.quests.list) do
		local quest = Quests.ById[entry.id]
		if quest then
			local card = row(body, 64, index)
			UI.label(Quests.Text(entry), { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.62, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = entry.done and T.Good or T.Text, Parent = card })
			local back = UI.new("Frame", { Position = UDim2.fromOffset(12, 40), Size = UDim2.new(0.62, 0, 0, 12), BackgroundColor3 = T.Background, Parent = card }, { UI.corner(6) })
			UI.new("Frame", { Size = UDim2.fromScale(math.clamp(entry.progress / entry.goal, 0, 1), 1), BackgroundColor3 = entry.done and T.Good or T.Accent, Parent = back }, { UI.corner(6) })
			UI.label(entry.done and "Done!" or string.format("%d/%d  -  %d coins", entry.progress, entry.goal, quest.coins), {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(170, 26),
				TextColor3 = entry.done and T.Good or T.Gold,
				Parent = card,
			})
		end
	end
	heading(body, "Your record", 10)
	local stats = data.stats
	local _, level = Level.Progress(data.xp)
	note(body, string.format("Level %d  -  %d matches  -  %d wins  -  %d rounds won  -  %d knockouts  -  %d bonks landed", level, stats.matches, stats.wins, stats.rounds, stats.kos, stats.bonks), 11)
	note(body, string.format("Daily login streak: %d day%s", data.dailyStreak, data.dailyStreak == 1 and "" or "s"), 12)
end

------------------------------------------------------------------ Arena (private servers)
local function renderArena(body)
	UI.list(8).Parent = body
	note(body, "Your private server, your rules: pick the arena every round uses.", 0)
	local pick = ReplicatedStorage:GetAttribute("ArenaPick")
	local card = row(body, 52, 1)
	UI.label("Random (a different arena each round)", { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.6, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = card })
	cardButton(card, pick == nil and "Picked" or "Pick", pick == nil and T.Card or T.Accent, function()
		act("PickArena", "random")
		task.wait(0.2)
		Panels.Arena.refresh()
	end)
	for index, arena in ipairs(Arenas.List) do
		local arenaCard = row(body, 64, index + 1)
		UI.label(arena.name, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(0.6, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = arena.color, Parent = arenaCard })
		UI.label(arena.description, { Position = UDim2.fromOffset(12, 34), Size = UDim2.new(0.66, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Font = T.BodyFont, TextColor3 = T.Muted, Parent = arenaCard })
		cardButton(arenaCard, pick == arena.id and "Picked" or "Pick", pick == arena.id and T.Card or T.Accent, function()
			act("PickArena", arena.id)
			task.wait(0.2)
			Panels.Arena.refresh()
		end)
	end
end

function Panels.Init(screenGui)
	Panels.Shop = UI.window(screenGui, "Shop", renderShop)
	Panels.Locker = UI.window(screenGui, "Locker", renderLocker)
	Panels.Quests = UI.window(screenGui, "Daily Quests", renderQuests)
	Panels.Arena = UI.window(screenGui, "Pick the Arena", renderArena)

	State.Changed:Connect(function()
		for _, name in ipairs({ "Shop", "Locker", "Quests" }) do
			Panels[name].refresh()
		end
	end)
end

return Panels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[-- The player's latest save data, as sent by the server.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local State = {
	data = nil,
	runtime = { passes = {} },
}

local changed = Instance.new("BindableEvent")
State.Changed = changed.Event

Remotes.DataUpdate.OnClientEvent:Connect(function(data, runtime)
	State.data = data
	State.runtime = runtime or State.runtime
	changed:Fire(data, State.runtime)
end)

function State.HasPass(passId)
	return State.runtime.passes ~= nil and State.runtime.passes[passId] == true
end

-- Calls a server action and shows its error message if it fails
function State.Action(actionName, argument)
	local ok, success, message = pcall(function()
		return Remotes.Action:InvokeServer(actionName, argument)
	end)
	if not ok then
		return false, "Connection problem, try again"
	end
	return success, message
end

return State
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Helpers for building the on-screen menus in code, so nothing has to be
-- drawn by hand in Studio. Colors and fonts live in UI.Theme.

local UI = {}

UI.Theme = {
	Background = Color3.fromRGB(20, 32, 52),
	Panel = Color3.fromRGB(30, 46, 74),
	Card = Color3.fromRGB(42, 62, 96),
	Accent = Color3.fromRGB(60, 170, 255),
	Gold = Color3.fromRGB(255, 200, 40),
	Good = Color3.fromRGB(70, 200, 110),
	Bad = Color3.fromRGB(230, 80, 80),
	Muted = Color3.fromRGB(150, 170, 200),
	Text = Color3.fromRGB(255, 255, 255),
	Font = Enum.Font.FredokaOne,
	BodyFont = Enum.Font.GothamMedium,
}

local T = UI.Theme

-- UI.new("Frame", { Size = ..., Parent = ... }, { child1, child2 })
function UI.new(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in pairs(props or {}) do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(color, thickness)
	return UI.new("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.padding(pixels)
	local p = UDim.new(0, pixels)
	return UI.new("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function UI.list(spacing, direction)
	return UI.new("UIListLayout", {
		Padding = UDim.new(0, spacing or 8),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function UI.label(text, props)
	local label = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.Text,
		Font = T.Font,
		TextScaled = true,
		Size = UDim2.new(1, 0, 0, 24),
	})
	for key, value in pairs(props or {}) do
		label[key] = value
	end
	return label
end

function UI.button(text, color, onClick, props)
	local button = UI.new("TextButton", {
		Text = text,
		BackgroundColor3 = color or T.Accent,
		TextColor3 = T.Text,
		Font = T.Font,
		TextScaled = true,
		AutoButtonColor = true,
		Size = UDim2.fromOffset(120, 40),
	}, { UI.corner(8), UI.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })
	for key, value in pairs(props or {}) do
		button[key] = value
	end
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function UI.clear(container)
	for _, child in ipairs(container:GetChildren()) do
		child:Destroy()
	end
end

-- A centered window with a title, a close button and a scrolling body.
-- Only one window is open at a time.
local openWindow = nil
local windowChanged = Instance.new("BindableEvent")
UI.WindowChanged = windowChanged.Event -- fires with true/false when a window opens/closes

function UI.IsWindowOpen()
	return openWindow ~= nil
end

function UI.window(screenGui, title, render)
	local frame = UI.new("Frame", {
		Name = title .. "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 440),
		BackgroundColor3 = T.Panel,
		Visible = false,
		Active = true, -- clicks on the window don't reach the game (no bonking through it)
		ZIndex = 10, -- above the HUD and the guide card, so the close button is never covered
		Parent = screenGui,
	}, { UI.corner(16), UI.stroke(T.Background, 4) })

	UI.label(title, { Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -90, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, Parent = frame })

	local body = UI.new("ScrollingFrame", {
		Name = "Body",
		Position = UDim2.fromOffset(16, 60),
		Size = UDim2.new(1, -32, 1, -76),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = frame,
	})

	local window = { frame = frame, body = body }

	function window.refresh()
		if frame.Visible then
			UI.clear(body)
			render(body)
		end
	end

	function window.open()
		if openWindow and openWindow ~= window then
			openWindow.close()
		end
		openWindow = window
		frame.Visible = true
		window.refresh()
		windowChanged:Fire(true)
	end

	function window.close()
		frame.Visible = false
		if openWindow == window then
			openWindow = nil
			windowChanged:Fire(false)
		end
	end

	function window.toggle()
		if frame.Visible then
			window.close()
		else
			window.open()
		end
	end

	UI.button("X", T.Bad, window.close, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(40, 40),
		Parent = frame,
	})

	return window
end

return UI
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
